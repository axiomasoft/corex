{
    "name": "corex/monorepo",
    "description": "Development monorepo for CoreX — a modular Laravel kernel and packages on which Flex products are built.",
    "license": "MIT",
    "type": "project",
    "private": true,
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "flex/crm": "@dev",
        "corex/tasks": "@dev",
        "corex/modules": "@dev",
        "corex/panels": "@dev",
        "corex/media": "@dev",
        "corex/notifications": "@dev",
        "corex/wakeup": "@dev",
        "corex/tenancy": "@dev",
        "corex/api": "@dev",
        "corex/tasks-workflow": "@dev",
        "corex/intl": "@dev",
        "corex/search-intl": "@dev",
        "corex/attributes": "@dev",
        "corex/transfer": "@dev",
        "corex/search-meilisearch": "@dev"
    },
    "require-dev": {
        "corex/workflow": "@dev",
        "laravel/pint": "^1.13",
        "rector/rector": "^2.0",
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pao": "^1.1",
        "opis/json-schema": "^2.4.1"
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Tests\\": "tests/",
            "CoreX\\Api\\Tests\\": "packages/api/tests/",
            "CoreX\\Modules\\Tests\\": "packages/modules/tests/",
            "CoreX\\Attributes\\Tests\\": "packages/attributes/tests/",
            "CoreX\\Transfer\\Tests\\": "packages/transfer/tests/",
            "CoreX\\Notifications\\Tests\\": "packages/notifications/tests/",
            "CoreX\\Search\\Tests\\": "packages/search/tests/",
            "CoreX\\Search\\Meilisearch\\Tests\\": "packages/search-meilisearch/tests/",
            "CoreX\\Wakeup\\Tests\\": "packages/wakeup/tests/",
            "CoreX\\Workflow\\Tests\\": "packages/workflow/tests/",
            "CoreX\\Recurrence\\Tests\\": "packages/recurrence/tests/",
            "CoreX\\TasksWorkflow\\Tests\\": "packages/tasks-workflow/tests/",
            "CoreX\\Intl\\Tests\\": "packages/intl/tests/",
            "CoreX\\SearchIntl\\Tests\\": "packages/search-intl/tests/"
        },
        "files": [
            "packages/attributes/tests/helpers.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --exclude-group=pg,meilisearch",
        "test:pg": "vendor/bin/pest --group=pg",
        "test:packages": "for p in api attributes auth core crm transfer intl search-intl media modules notifications panels recurrence search search-meilisearch tasks tasks-workflow tenancy wakeup workflow; do echo \"==> packages/$p\" && composer --working-dir=packages/$p test || exit 1; done",
        "test:arch": "vendor/bin/pest --testsuite=Arch",
        "package-graph-gate": "php scripts/package-graph-gate.php",
        "contract-guard": "bash scripts/contract-guard.sh",
        "test:coverage": "vendor/bin/pest --coverage --min=80",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "analyse:tests-lint": "vendor/bin/phpstan analyse -c phpstan-tests-lint.neon --memory-limit=1G",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run"
    }
}
