{
    "name": "corex/monorepo",
    "description": "Development monorepo for CoreX — a modular Laravel kernel and packages on which Flex products are built.",
    "license": "MIT",
    "type": "project",
    "private": true,
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "flex/crm": "@dev",
        "corex/tasks": "@dev",
        "corex/modules": "@dev",
        "corex/tenancy": "@dev",
        "stancl/tenancy": "dev-master#76e5f9655924271c6c9da54e2d4ccb82c6f71ea0 as 4.0.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "rector/rector": "^2.0",
        "pestphp/pest": "^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/pao": "^1.1"
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --exclude-group=pg",
        "test:pg": "vendor/bin/pest --group=pg",
        "test:packages": "for p in auth crm tasks tenancy; do composer --working-dir=packages/$p test || exit 1; done",
        "test:coverage": "vendor/bin/pest --coverage --min=55 --exclude-group=pg",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run"
    }
}
