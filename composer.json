{
    "name": "corex/monorepo",
    "description": "Development monorepo for CoreX — a modular Laravel kernel and packages on which Flex products are built.",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "flex/crm": "^1.0@dev",
        "axiomasoft/corex-tasks": "^1.0@dev",
        "axiomasoft/corex-panels": "^1.0@dev",
        "axiomasoft/corex-media": "^1.0@dev",
        "axiomasoft/corex-notifications": "^1.0@dev",
        "axiomasoft/corex-wakeup": "^1.0@dev",
        "axiomasoft/corex-tenancy": "^1.0@dev",
        "axiomasoft/corex-operations": "^1.0@dev",
        "axiomasoft/corex-tasks-workflow": "^1.0@dev",
        "axiomasoft/corex-intl": "^1.0@dev",
        "axiomasoft/corex-search-intl": "^1.0@dev",
        "axiomasoft/corex-custom-fields": "^1.0@dev",
        "axiomasoft/corex-transfer": "^1.0@dev",
        "axiomasoft/corex-search-meilisearch": "^1.0@dev",
        "axiomasoft/corex-recurrence": "^1.0@dev",
        "axiomasoft/corex-search": "^1.0@dev"
    },
    "require-dev": {
        "axiomasoft/corex-workflow": "^1.0@dev",
        "laravel/pint": "^1.32",
        "rector/rector": "^2.6",
        "pestphp/pest": "^5.2",
        "orchestra/testbench": "^10.12|^11.3",
        "phpstan/phpstan": "^2.2.16",
        "larastan/larastan": "^3.12",
        "laravel/pao": "^1.1",
        "opis/json-schema": "^2.4.1",
        "roave/backward-compatibility-check": "^8.22",
        "open-telemetry/api": "^1.4",
        "open-telemetry/sdk": "^1.4",
        "axiomasoft/corex-access": "^1.0@dev",
        "axioma-studio/azguard-core": "^0.3",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "axiomasoft/corex-tools": "^1.0@dev",
        "axiomasoft/corex-webhooks": "^1.0@dev"
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Access\\Database\\Seeders\\": "packages/access/database/seeders/",
            "CoreX\\Access\\Tests\\": "packages/access/tests/",
            "CoreX\\CustomFields\\Tests\\": "packages/custom-fields/tests/",
            "CoreX\\Intl\\Tests\\": "packages/intl/tests/",
            "CoreX\\Media\\Tests\\": "packages/media/tests/",
            "CoreX\\Notifications\\Tests\\": "packages/notifications/tests/",
            "CoreX\\Operations\\Tests\\": "packages/operations/tests/",
            "CoreX\\Panels\\Tests\\": "packages/panels/tests/",
            "CoreX\\Recurrence\\Tests\\": "packages/recurrence/tests/",
            "CoreX\\SearchIntl\\Tests\\": "packages/search-intl/tests/",
            "CoreX\\SearchMeilisearch\\Tests\\": "packages/search-meilisearch/tests/",
            "CoreX\\Search\\Tests\\": "packages/search/tests/",
            "CoreX\\TasksWorkflow\\Tests\\": "packages/tasks-workflow/tests/",
            "CoreX\\Tasks\\Tests\\": "packages/tasks/tests/",
            "CoreX\\Tenancy\\Tests\\": "packages/tenancy/tests/",
            "CoreX\\Testing\\": "packages/core/tests/Support/",
            "CoreX\\Tests\\Golden\\": "tests/Golden/",
            "CoreX\\Tools\\Tests\\": "packages/tools/tests/",
            "CoreX\\Transfer\\Tests\\": "packages/transfer/tests/",
            "CoreX\\Wakeup\\Tests\\": "packages/wakeup/tests/",
            "CoreX\\Webhooks\\Tests\\": "packages/webhooks/tests/",
            "CoreX\\Workflow\\Tests\\": "packages/workflow/tests/",
            "Flex\\Crm\\Tests\\": "products/flex-crm/tests/"
        },
        "classmap": [
            "tests/TestCase.php",
            "tests/Stubs",
            "tests/Support",
            "tests/Feature",
            "tests/Arch",
            "tests/Unit",
            "tests/Distribution",
            "tests/PHPStan",
            "packages/core/tests/Fixtures",
            "packages/core/tests/Modules",
            "packages/notifications/tests",
            "packages/search/tests",
            "packages/search-meilisearch/tests",
            "packages/wakeup/tests",
            "packages/tasks-workflow/tests"
        ],
        "files": [
            "packages/custom-fields/tests/helpers.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        },
        {
            "type": "path",
            "url": "products/*"
        },
        {
            "name": "azguard",
            "type": "package",
            "package": {
                "name": "axioma-studio/azguard-core",
                "version": "0.3.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/axiomasoft/azguard-private.git",
                    "reference": "253cbf4cce0226545cd96ca8c6bcbefe329b1403"
                },
                "require": {
                    "php": "^8.3",
                    "illuminate/console": "^11.0|^12.0|^13.0",
                    "illuminate/contracts": "^11.0|^12.0|^13.0",
                    "illuminate/database": "^11.0|^12.0|^13.0",
                    "illuminate/filesystem": "^11.0|^12.0|^13.0",
                    "illuminate/http": "^11.0|^12.0|^13.0",
                    "illuminate/queue": "^11.0|^12.0|^13.0",
                    "illuminate/routing": "^11.0|^12.0|^13.0",
                    "illuminate/support": "^11.0|^12.0|^13.0"
                },
                "autoload": {
                    "psr-4": {
                        "AzGuard\\": "packages/core/src/"
                    }
                },
                "extra": {
                    "laravel": {
                        "providers": [
                            "AzGuard\\AzGuardServiceProvider"
                        ]
                    }
                }
            }
        }
    ],
    "extra": {
        "laravel": {},
        "phpstan/extension-installer": {
            "ignore": [
                "axiomasoft/corex",
                "axiomasoft/corex-tenancy",
                "composer/composer",
                "composer/pcre",
                "larastan/larastan",
                "nesbot/carbon",
                "pestphp/pest",
                "phpstan/phpstan-strict-rules"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "process-timeout": 1200,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "bash scripts/run-root-tests.sh @additional_args",
        "test:hermetic": "PGSQL_HOST=127.0.0.1 PGSQL_PORT=1 PGSQL_DATABASE=corex_test bash scripts/run-root-tests.sh @additional_args",
        "ci:local": "bash scripts/ci-local.sh",
        "test:pg": "vendor/bin/pest --group=pg",
        "test:packages": "for p in packages/access packages/core packages/custom-fields packages/intl packages/media packages/notifications packages/operations packages/panels packages/recurrence packages/search packages/search-intl packages/search-meilisearch packages/tasks packages/tasks-workflow packages/tenancy packages/tools packages/transfer packages/wakeup packages/webhooks packages/workflow products/flex-crm; do echo \"==> $p\" && composer --working-dir=\"$p\" test -- --exclude-group=pg || exit 1; done",
        "test:arch": "bash scripts/ci-deferred-guard.sh vendor/bin/pest --testsuite=Arch",
        "package-graph-gate": "bash scripts/ci-deferred-guard.sh php scripts/package-graph-gate.php",
        "package-docs-gate": "php scripts/package-docs-gate.php",
        "dod-check": "python3 scripts/dod-1.0.py check --profile ci --candidate plans/2026.09.19-№1-COREX-PLATFORM-HARDENING/artifacts/P17/release-cohort.json",
        "module-layout-gate": "python3 scripts/module-layout-gate.py",
        "php-api:report": "php scripts/php-api.php --report --format=json",
        "error-registry": "php scripts/error-registry.php --check",
        "table-write-ownership-gate": "php scripts/table-write-ownership-gate.php",
        "naming-gate": "bash scripts/ci-deferred-guard.sh php scripts/naming-gate.php",
        "rename-completeness": "php scripts/rename-completeness-gate.php",
        "config-composition-gate": "bash scripts/ci-deferred-guard.sh php scripts/config-composition-gate.php",
        "runtime-globals-gate": "php scripts/runtime-globals-gate.php",
        "config-cache-check": "vendor/bin/pest tests/Feature/ConfigCacheTest.php",
        "configuration-reference": "php scripts/configuration-reference.php --check",
        "table-ownership-gate": "bash scripts/ci-deferred-guard.sh php scripts/table-ownership-gate.php",
        "contract-guard": "bash scripts/contract-guard.sh",
        "api-contract": "php scripts/check-api-contract.php",
        "bc-check": "bash scripts/bc-check.sh",
        "test:coverage": "bash scripts/run-root-coverage.sh --min=80",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "bash scripts/phpstan-packages.sh",
        "analyse:tests-lint": "vendor/bin/phpstan analyse -c phpstan-tests-lint.neon --memory-limit=1G",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "manifests:check": "python3 scripts/manifest-check.py",
        "golden": "vendor/bin/pest --testsuite=Golden",
        "ownership-gate": "php scripts/ownership-gate.php --strict",
        "quality:ceilings": "php scripts/quality-ceiling-guard.php",
        "deps:analyse": "bash scripts/dependency-analyser.sh --all",
        "php-api": "php scripts/php-api.php --strict --check"
    }
}
