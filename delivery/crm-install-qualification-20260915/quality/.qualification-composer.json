    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^2.0",
    "rector/rector": "^2.0"
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
    "analyse:tests-lint": "vendor/bin/phpstan analyse -c phpstan-tests-lint.neon --memory-limit=1G",
    "contract-guard": "bash scripts/contract-guard.sh",
    "lint": "vendor/bin/pint",
    "lint:check": "vendor/bin/pint --test",
    "refactor": "vendor/bin/rector process",
    "refactor:check": "vendor/bin/rector process --dry-run",
    "test": "vendor/bin/pest --exclude-group=pg",
    "test:arch": "vendor/bin/pest --testsuite=Arch",
    "test:coverage": "vendor/bin/pest --coverage --min=80",
    "test:packages": "for p in api auth crm tasks tenancy; do composer --working-dir=packages/$p test || exit 1; done",
    "test:pg": "vendor/bin/pest --group=pg"
  },
  "type": "project"
}
