{
    "name": "equipment/registry",
    "description": "Independent equipment registry on the public CoreX contracts.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "corex/attributes": "^1.0",
        "corex/core": "^1.0",
        "corex/modules": "^1.0",
        "corex/search": "^1.0",
        "corex/transfer": "^1.0",
        "corex/workflow": "^1.0",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Equipment\\Registry\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": true,
        "sort-packages": true
    }
}
