{
    "name": "equipment/registry",
    "description": "Independent equipment registry on the public CoreX contracts.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex-custom-fields": "^1.0",
        "axiomasoft/corex": "^1.0",
        "axiomasoft/corex-search": "^1.0",
        "axiomasoft/corex-import-export": "^1.0",
        "axiomasoft/corex-workflow": "^1.0",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Equipment\\Registry\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": true,
        "sort-packages": true
    }
}
