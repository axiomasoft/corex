{
    "name": "thirdparty/custom-attribute-source",
    "description": "Standalone equipment field declarations and versioned inspection-code codec.",
    "type": "packman-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex-custom-fields": "^2.0",
        "axiomasoft/corex": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ThirdParty\\Attributes\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "ThirdParty\\Attributes\\FixtureServiceProvider"
            ]
        },
        "packman": {
            "module": "ThirdParty\\Attributes\\RegisteredModule"
        }
    }
}
