{
    "name": "corex/api",
    "description": "Opt-in module operation dispatch, trusted context contracts and OpenAPI projection for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "corex/modules": "@dev",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "suggest": {
        "opis/json-schema": "2.4.1 — bounded offline tool-schema/1 validation adapter"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.13",
        "larastan/larastan": "^3.0",
        "opis/json-schema": "^2.4.1"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Api\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint:check": "pint --test"
    }
}
