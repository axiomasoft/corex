{
    "name": "corex/attributes",
    "description": "Typed attribute ports and safe schema-operation bridge for CoreX.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "suggest": {
        "corex/modules": "Provides EntityRegistry and ModuleRegistry for dynamic field definitions; without it SchemaOperations stays unavailable and the static catalogue remains usable."
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Attributes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Attributes\\Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "experimental",
            "public-api": [
                "CoreX\\Attributes\\Contracts",
                "CoreX\\Attributes\\Data",
                "CoreX\\Attributes\\Exceptions"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Attributes\\AttributesServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c phpstan.neon packages/attributes/src --memory-limit=1G",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
