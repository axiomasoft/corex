{
    "name": "axiomasoft/corex",
    "description": "CoreX application foundation — tenant context, settings, audit and messaging on Packman modules and schema.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "kernel",
        "multi-tenancy",
        "ulid",
        "entity-registry",
        "audit",
        "settings"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "ext-ctype": "*",
        "ext-filter": "*",
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/framework": "^13.0",
        "psr/clock": "^1.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1"
    },
    "provide": {
        "psr/clock-implementation": "1.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "ext-posix": "*",
        "phpstan/phpstan": "^2.2.16",
        "larastan/larastan": "^3.12",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.4",
        "phpstan/phpdoc-parser": "^2.3",
        "open-telemetry/api": "^1.4",
        "open-telemetry/sdk": "^1.4",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "psr/log": "^3.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0",
        "symfony/filesystem": "^7.2|^8.0",
        "phpunit/phpunit": "^12.0",
        "laravel/octane": "2.21.0",
        "monolog/monolog": "^3.10"
    },
    "suggest": {
        "open-telemetry/api": "Optional operation and messaging traces. CoreX boots without it.",
        "psr/log": "Optional PSR-3 projection of operation lifecycle events.",
        "nikic/php-parser": "Development tooling for source API and error registry scans.",
        "phpstan/phpdoc-parser": "Development tooling for source API PHPDoc parsing.",
        "phpstan/phpstan": "Development tooling for shipped static analysis rules."
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Testing\\": "tests/Support/"
        },
        "classmap": [
            "tests/Fixtures",
            "tests/Release/octane-consumer/LifecycleServiceProvider.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "CoreX\\": "src/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "foundation",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\CoreServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "kernel",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "core",
            "owns": [
                "Audit",
                "Config",
                "Context",
                "Data",
                "Database",
                "Departments",
                "Errors",
                "Features",
                "Foundation",
                "Invocation",
                "Messaging",
                "Observability",
                "Scheduling",
                "Settings",
                "Storage",
                "Time"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage,ModulesPackage --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage,ModulesPackage --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage,ModulesPackage --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/core/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "repositories": []
}
