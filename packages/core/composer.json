{
    "name": "corex/core",
    "description": "CoreX kernel — base model (ULID), optional multi-tenancy, entity registry, settings, audit log, and money for any Laravel application.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "kernel",
        "multi-tenancy",
        "ulid",
        "entity-registry",
        "audit",
        "settings"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "brick/money": "^0.9 || ^0.10",
        "ext-ctype": "*",
        "php": "^8.4",
        "psr/clock": "^1.0",
        "laravel/framework": "^12.0|^13.0",
        "ext-mbstring": "*"
    },
    "provide": {
        "psr/clock-implementation": "1.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "nikic/php-parser": "^5.4",
        "open-telemetry/api": "^1.4",
        "open-telemetry/sdk": "^1.4",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "phpstan/phpstan": "^2.2.16",
        "psr/log": "^3.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0"
    },
    "suggest": {
        "open-telemetry/api": "Optional operation and messaging traces. CoreX boots without it.",
        "psr/log": "Optional PSR-3 projection of operation lifecycle events."
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Testing\\": "tests/Support/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "autoload": {
        "psr-4": {
            "CoreX\\": "src/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "foundation",
            "stability": "stable",
            "public-api": [
                "CoreX\\Contracts",
                "CoreX\\Data",
                "CoreX\\Enums",
                "CoreX\\Events",
                "CoreX\\Exceptions",
                "CoreX\\Models",
                "CoreX\\Concerns",
                "CoreX\\Audit\\Contracts",
                "CoreX\\Observability",
                "CoreX\\Messaging\\Contracts",
                "CoreX\\Messaging\\Data",
                "CoreX\\Support\\ViolationList",
                "CoreX\\Support\\InvalidConfiguration",
                "CoreX\\Support\\SecretRef",
                "CoreX\\Support\\Data\\DataScope",
                "CoreX\\Support\\Data\\DataScopeAccessDecision",
                "CoreX\\Support\\PackageRegistrar",
                "CoreX\\Support\\RegistersNothingOnBoot",
                "CoreX\\Tenancy\\Contracts\\TenantContextResolver",
                "CoreX\\Tenancy\\Contracts\\TenantContextRestorer",
                "CoreX\\Tenancy\\Contracts\\TenancyManager",
                "CoreX\\Tenancy\\Contracts\\TenantDatabaseLifecycle",
                "CoreX\\Tenancy\\Contracts\\ImpersonationService",
                "CoreX\\Tenancy\\ImpersonationGuard",
                "CoreX\\Tenancy\\AccountRef",
                "CoreX\\Tenancy\\TenantContext",
                "CoreX\\Tenancy\\WorkspaceRef"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\CoreServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/core/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "repositories": []
}
