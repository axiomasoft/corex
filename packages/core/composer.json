{
    "name": "axiomasoft/corex",
    "description": "CoreX kernel \u2014 base model (ULID), optional multi-tenancy, entity registry, settings, audit log, and money for any Laravel application.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "kernel",
        "multi-tenancy",
        "ulid",
        "entity-registry",
        "audit",
        "settings"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "php": "^8.4",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/framework": "^12.0|^13.0",
        "psr/clock": "^1.0"
    },
    "provide": {
        "psr/clock-implementation": "1.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "phpstan/phpstan": "^2.2.16",
        "larastan/larastan": "^3.12",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.4",
        "phpstan/phpdoc-parser": "^2.3",
        "open-telemetry/api": "^1.4",
        "open-telemetry/sdk": "^1.4",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "psr/log": "^3.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0"
    },
    "suggest": {
        "open-telemetry/api": "Optional operation and messaging traces. CoreX boots without it.",
        "psr/log": "Optional PSR-3 projection of operation lifecycle events."
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Testing\\": "tests/Support/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "autoload": {
        "psr-4": {
            "CoreX\\": "src/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "foundation",
            "stability": "stable",
            "public-api": [
                "CoreX\\Attributes\\Api",
                "CoreX\\Attributes\\Spi",
                "CoreX\\Attributes\\SpiKind",
                "CoreX\\Audit",
                "CoreX\\Config\\Config",
                "CoreX\\Config\\Contracts",
                "CoreX\\Config\\CoreOptions",
                "CoreX\\Config\\Exceptions\\InvalidConfiguration",
                "CoreX\\Config\\SecretRef",
                "CoreX\\Config\\ViolationList",
                "CoreX\\Context\\Contracts",
                "CoreX\\Context\\Data\\AccountRef",
                "CoreX\\Context\\Data\\TenantContext",
                "CoreX\\Context\\Data\\WorkspaceRef",
                "CoreX\\Context\\Enums",
                "CoreX\\Context\\Exceptions",
                "CoreX\\Context\\ImpersonationGuard",
                "CoreX\\Data\\Contracts",
                "CoreX\\Data\\DataScope",
                "CoreX\\Data\\Data\\DataScopeAccessDecision",
                "CoreX\\Data\\Exceptions",
                "CoreX\\Database",
                "CoreX\\Departments\\Contracts",
                "CoreX\\Departments\\Events",
                "CoreX\\Departments\\Exceptions",
                "CoreX\\Departments\\Models",
                "CoreX\\Errors\\Contracts",
                "CoreX\\Errors\\Data",
                "CoreX\\Errors\\Enums",
                "CoreX\\Features\\Contracts",
                "CoreX\\Features\\Events",
                "CoreX\\Features\\Internal\\Models",
                "CoreX\\Messaging\\Contracts",
                "CoreX\\Messaging\\Data",
                "CoreX\\Messaging\\Enums",
                "CoreX\\Messaging\\Events",
                "CoreX\\Messaging\\Exceptions",
                "CoreX\\Messaging\\Testing",
                "CoreX\\Modules\\Compiler\\CompiledRegistry",
                "CoreX\\Modules\\Contracts",
                "CoreX\\Modules\\Data",
                "CoreX\\Modules\\Enums",
                "CoreX\\Modules\\Events",
                "CoreX\\Modules\\Exceptions",
                "CoreX\\Modules\\Extend",
                "CoreX\\Modules\\RegistersNothingOnBoot",
                "CoreX\\Modules\\Registry\\CompiledModule",
                "CoreX\\Modules\\Testing",
                "CoreX\\Observability",
                "CoreX\\Panels\\SavedViews\\Contracts",
                "CoreX\\Settings\\Contracts",
                "CoreX\\Settings\\Enums",
                "CoreX\\Settings\\Events",
                "CoreX\\Settings\\Exceptions",
                "CoreX\\Settings\\Internal\\Models",
                "CoreX\\Storage\\Contracts"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\CoreServiceProvider",
                "CoreX\\Modules\\ModulesServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage,ModulesPackage --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage,ModulesPackage --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=CorePackage,ModulesPackage --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/core/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "repositories": []
}
