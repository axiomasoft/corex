{
    "name": "corex-tests/octane-consumer",
    "description": "Source-only Octane lifecycle harness",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "13.3.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    }
}
