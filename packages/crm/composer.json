{
    "name": "flex/crm",
    "description": "CoreX CRM module — pipelines, stages and deals on corex/core (ULID, tenancy, money).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "crm", "pipeline", "deals", "multi-tenancy"],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "corex/modules": "@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Flex\\Crm\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Flex\\Crm\\CrmServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
