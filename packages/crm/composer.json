{
    "name": "flex/crm",
    "description": "CoreX CRM module — pipelines, stages and deals on corex/core (ULID, tenancy, money).",
    "type": "corex-module",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crm",
        "pipeline",
        "deals",
        "multi-tenancy"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "corex/operations": "@dev",
        "corex/core": "@dev",
        "corex/modules": "@dev",
        "giggsey/libphonenumber-for-php-lite": "^9.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Flex\\Crm\\": "src/",
            "Flex\\Crm\\Actions\\": [
                "src/Company/Actions/",
                "src/Contact/Actions/",
                "src/Lead/Actions/",
                "src/Deal/Actions/",
                "src/Activity/Actions/"
            ],
            "Flex\\Crm\\Api\\": [
                "src/ApiShared/",
                "src/Company/Api/",
                "src/Contact/Api/"
            ],
            "Flex\\Crm\\Models\\": [
                "src/Company/Models/",
                "src/Contact/Models/",
                "src/Lead/Models/",
                "src/Deal/Models/",
                "src/Activity/Models/",
                "src/Context/Models/"
            ],
            "Flex\\Crm\\Models\\Concerns\\": "src/Context/Models/Concerns/",
            "Flex\\Crm\\Data\\": [
                "src/Company/Data/",
                "src/Contact/Data/",
                "src/Context/Data/"
            ],
            "Flex\\Crm\\Events\\": [
                "src/Company/Events/",
                "src/Contact/Events/",
                "src/Lead/Events/",
                "src/Deal/Events/",
                "src/Activity/Events/"
            ],
            "Flex\\Crm\\Enums\\": [
                "src/Lead/Enums/",
                "src/Deal/Enums/",
                "src/Activity/Enums/"
            ],
            "Flex\\Crm\\Casts\\": "src/Deal/Casts/",
            "Flex\\Crm\\Contracts\\": "src/Context/Contracts/",
            "Flex\\Crm\\Support\\": [
                "src/Support/",
                "src/Context/",
                "src/Context/Internal/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flex\\Crm\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "Flex\\Crm\\CrmModule",
            "package-type": "product",
            "stability": "experimental",
            "public-api": [
                "Flex\\Crm\\Contracts",
                "Flex\\Crm\\Data",
                "Flex\\Crm\\Enums",
                "Flex\\Crm\\Events",
                "Flex\\Crm\\Models"
            ]
        },
        "laravel": {
            "providers": [
                "Flex\\Crm\\CrmServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        },
        {
            "type": "path",
            "url": "../operations"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --exclude-group=pg",
        "test:pg": "pest --group=pg",
        "test:coverage": "pest --coverage --min=95",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "lint:check": "pint --test"
    }
}
