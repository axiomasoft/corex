{
    "name": "axiomasoft/corex-custom-fields",
    "description": "Typed attribute ports and safe schema-operation bridge for CoreX.",
    "type": "library",
    "license": "MIT",
    "require": {
        "ext-filter": "*",
        "ext-mbstring": "*",
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "psr/clock": "^1.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1",
        "axiomasoft/packman-schema": "^0.1"
    },
    "suggest": {
        "axiomasoft/corex": "Provides EntityRegistry and ModuleRegistry for dynamic field definitions; without it SchemaOperations stays unavailable and the static catalogue remains usable."
    },
    "autoload": {
        "psr-4": {
            "CoreX\\CustomFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\CustomFields\\Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\CustomFields\\CustomFieldsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "packman": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "custom-fields",
            "owns": [
                "Contracts",
                "Data",
                "Errors",
                "Exceptions",
                "Internal"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "architecture:check": "php ../../scripts/attributes-architecture-gate.php",
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/custom-fields/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "symfony/process": "^7.2|^8.0"
    }
}
