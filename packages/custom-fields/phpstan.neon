includes:
    - ../../phpstan-extensions.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:
    level: max
    tmpDir: ../../build/phpstan/attributes
    paths:
        - src
        - database/migrations
    checkModelProperties: true
    checkPhpDocMissingReturn: true
    ignoreErrors:
        # CIC spans transactions on the attested direct writer. Keep the pooling rule everywhere else.
        -
            identifier: modules.sessionAdvisoryLock
            path: src/Schemas/Internal/PostgresDdlExecutor.php
            count: 2
