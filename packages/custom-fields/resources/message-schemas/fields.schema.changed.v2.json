{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:corex:schema:fields.schema.changed.v2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "base",
        "target",
        "mapping_digest"
    ],
    "properties": {
        "base": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "target": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "mapping_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}
