{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:corex:schema:fields.schema.requested.v2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "plan_ref",
        "plan_digest"
    ],
    "properties": {
        "plan_ref": {
            "type": "string",
            "format": "uuid"
        },
        "plan_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}
