{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "axiomasoft/corex-import-export configuration",
    "type": "object",
    "properties": {
        "corex-import-export": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "batch_rows": {
                            "type": "integer",
                            "default": 500
                        },
                        "max_fields": {
                            "type": "integer",
                            "default": 256
                        },
                        "max_memory_mib": {
                            "type": "integer",
                            "default": 128
                        },
                        "max_record_bytes": {
                            "type": "integer",
                            "default": 1048576
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
