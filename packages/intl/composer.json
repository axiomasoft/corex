{
    "name": "corex/intl",
    "description": "Typed locale, money/rate snapshots, and offline geography reference utilities for CoreX.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "brick/money": "^0.9 || ^0.10",
        "corex/core": "^1.0@dev",
        "corex/modules": "^1.0@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Intl\\": "src/",
            "CoreX\\Intl\\Contracts\\": [
                "src/Locale/Contracts/",
                "src/Translation/Contracts/",
                "src/Currency/Contracts/",
                "src/Formatting/Contracts/",
                "src/Territory/Contracts/"
            ],
            "CoreX\\Intl\\Data\\": [
                "src/Locale/Data/",
                "src/Translation/Data/",
                "src/Currency/Data/",
                "src/Formatting/Data/",
                "src/Territory/Data/"
            ],
            "CoreX\\Intl\\Exceptions\\": [
                "src/Locale/Exceptions/",
                "src/Currency/Exceptions/",
                "src/Formatting/Exceptions/",
                "src/Territory/Exceptions/"
            ],
            "CoreX\\Intl\\Internal\\Locale\\": [
                "src/Locale/Internal/",
                "src/Translation/Internal/"
            ],
            "CoreX\\Intl\\Internal\\Money\\": [
                "src/Currency/Internal/",
                "src/Formatting/Internal/"
            ],
            "CoreX\\Intl\\Internal\\Address\\": "src/Territory/Internal/Address/",
            "CoreX\\Intl\\Internal\\Reference\\": "src/Territory/Internal/Reference/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Intl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\Intl\\IntlModule",
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Intl\\Contracts",
                "CoreX\\Intl\\Data",
                "CoreX\\Intl\\Exceptions"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Intl\\IntlServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/intl/phpstan.neon --memory-limit=1G",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
