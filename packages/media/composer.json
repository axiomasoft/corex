{
    "name": "corex/media",
    "description": "Tenant-scoped private media lifecycle primitives for CoreX.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "corex/core": "^1.0@dev",
        "corex/modules": "^1.0@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "suggest": {
        "ext-gd": "Enables the optional bounded PNG/JPEG thumbnail driver."
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\Media\\MediaModule",
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Media\\Contracts",
                "CoreX\\Media\\Data"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Media\\MediaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --exclude-group=pg",
        "test:pg": "pest --group=pg",
        "test:coverage": "pest --exclude-group=pg --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint:check": "pint --test"
    }
}
