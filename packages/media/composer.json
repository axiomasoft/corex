{
    "name": "axiomasoft/corex-media",
    "description": "Tenant-scoped private media lifecycle primitives for CoreX.",
    "type": "packman-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "laravel/framework": "^13.0",
        "psr/clock": "^1.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1",
        "axiomasoft/vaulter-core": "^1.0@dev",
        "axiomasoft/vaulter-media": "^1.0@dev"
    },
    "require-dev": {
        "ext-pdo": "*",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2"
    },
    "suggest": {
        "ext-gd": "Enables the optional bounded PNG/JPEG thumbnail driver."
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\Media\\MediaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "packman": {
            "module": "CoreX\\Media\\MediaModule",
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "modular-platform",
            "error-prefix": "media",
            "owns": [
                "Contracts",
                "Data",
                "Exceptions",
                "Internal",
                "Laravel"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --exclude-group=pg",
        "test:pg": "pest --group=pg",
        "test:coverage": "pest --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/media/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "pint --test"
    }
}
