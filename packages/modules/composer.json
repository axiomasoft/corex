{
    "name": "corex/modules",
    "description": "CoreX module system \u2014 EntityRegistry, module manifests, discovery and the compiled registry hot-path.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "modules",
        "entity-registry"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "corex/core": "^1.0@dev",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "php": "^8.4"
    },
    "require-dev": {
        "corex/operations": "^1.0@dev",
        "larastan/larastan": "^3.12",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.4",
        "orchestra/testbench": "^10.12|^11.3",
        "phpstan/phpstan": "^2.2.16",
        "orchestra/testbench-core": "^10.12|^11.3"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Modules\\": [
                "src/",
                "src/Definition/",
                "src/Gate/",
                "src/Settings/"
            ]
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "foundation",
            "stability": "stable",
            "public-api": [
                "CoreX\\Modules\\Contracts",
                "CoreX\\Modules\\Data",
                "CoreX\\Modules\\Enums",
                "CoreX\\Modules\\Events",
                "CoreX\\Modules\\Exceptions",
                "CoreX\\Modules\\Extend",
                "CoreX\\Modules\\Testing"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Modules\\ModulesServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=ModulesPackage",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=ModulesPackage --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/modules/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../operations"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Modules\\Tests\\": "tests/"
        }
    }
}
