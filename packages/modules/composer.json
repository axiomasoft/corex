{
    "name": "corex/modules",
    "description": "Flex module system — EntityRegistry, module manifests, discovery and the compiled registry hot-path.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "modules", "entity-registry"],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Modules\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CoreX\\Modules\\ModulesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
