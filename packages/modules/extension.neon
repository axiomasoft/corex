parameters:
    corexModules:
        # PSR-4-неймспейс модуля => его tablePrefix из манифеста (владение таблицами).
        modulePrefixes: []
        # Неймспейсы модулей — скоуп fs-правила.
        moduleNamespaces: []
        # Владельцы контрактов sys_*/mod_* — им запись в эти таблицы легальна.
        systemTableNamespaces:
            - CoreX\
            - CoreX\Modules\

parametersSchema:
    corexModules: structure([
        modulePrefixes: arrayOf(string(), string())
        moduleNamespaces: listOf(string())
        systemTableNamespaces: listOf(string())
    ])

services:
    -
        class: CoreX\Modules\PHPStan\Rules\NoSetWithoutLocalRule
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoSessionAdvisoryLockRule
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoListenNotifyRule
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoTempTableRule
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoSqlPrepareRule
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoEvalRule
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoForeignPrefixSqlRule
        arguments:
            modulePrefixes: %corexModules.modulePrefixes%
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoFsOutsideModuleRule
        arguments:
            moduleNamespaces: %corexModules.moduleNamespaces%
        tags:
            - phpstan.rules.rule
    -
        class: CoreX\Modules\PHPStan\Rules\NoDirectSystemTableWriteRule
        arguments:
            systemTableNamespaces: %corexModules.systemTableNamespaces%
        tags:
            - phpstan.rules.rule
