{
    "name": "axiomasoft/corex-notifications",
    "description": "Durable tenant-scoped notification primitives for CoreX.",
    "type": "packman-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "laravel/framework": "^13.0",
        "psr/clock": "^1.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1"
    },
    "require-dev": {
        "axiomasoft/corex-scheduler": "^2.0@dev",
        "ext-pdo": "*",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\Notifications\\NotificationsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "packman": {
            "module": "CoreX\\Notifications\\NotificationsModule",
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "modular-platform",
            "error-prefix": "notifications",
            "owns": [
                "Delivery",
                "Digest",
                "Errors",
                "Inbox",
                "Internal",
                "Laravel",
                "Preferences",
                "Runtime"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../scheduler",
            "options": {
                "versions": {
                    "axiomasoft/corex-scheduler": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/notifications/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --config=pint.json --test"
    }
}
