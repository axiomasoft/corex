{
    "name": "corex/notifications",
    "description": "Durable tenant-scoped notification primitives for CoreX.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "corex/core": "^1.0@dev",
        "corex/modules": "^1.0@dev",
        "corex/wakeup": "^1.0@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Notifications\\": "src/",
            "CoreX\\Notifications\\Contracts\\": [
                "src/Inbox/Contracts/",
                "src/Delivery/Contracts/",
                "src/Digest/Contracts/",
                "src/Preferences/Contracts/"
            ],
            "CoreX\\Notifications\\Data\\": [
                "src/Inbox/Data/",
                "src/Delivery/Data/",
                "src/Digest/Data/",
                "src/Preferences/Data/"
            ],
            "CoreX\\Notifications\\Internal\\": [
                "src/Inbox/Internal/",
                "src/Delivery/Internal/",
                "src/Digest/Internal/",
                "src/Preferences/Internal/"
            ],
            "CoreX\\Notifications\\Internal\\Digest\\": "src/Digest/Internal/",
            "CoreX\\Notifications\\Jobs\\": [
                "src/Delivery/Jobs/",
                "src/Digest/Jobs/"
            ],
            "CoreX\\Notifications\\Commands\\": "src/Delivery/Commands/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\Notifications\\NotificationsModule",
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Notifications\\Contracts",
                "CoreX\\Notifications\\Data"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Notifications\\NotificationsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        },
        {
            "type": "path",
            "url": "../wakeup"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c phpstan.neon packages/notifications/src --memory-limit=1G",
        "lint:check": "../../vendor/bin/pint --config=pint.json --test"
    }
}
