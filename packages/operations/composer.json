{
    "name": "axiomasoft/corex-operations",
    "description": "Opt-in module operation dispatch, trusted context contracts and OpenAPI projection for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "ext-filter": "*",
        "ext-mbstring": "*",
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "psr/clock": "^1.0",
        "symfony/http-kernel": "^7.2|^8.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1"
    },
    "suggest": {
        "opis/json-schema": "2.4.1 — bounded offline tool-schema/1 validation adapter",
        "ext-curl": "Optional webhook transport; missing curl returns capability_unavailable."
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "phpunit/phpunit": "^12.0|^13.0",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "opis/json-schema": "^2.4.1",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2",
        "axiomasoft/corex-webhooks": "^2.0@dev"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Operations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Operations\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../webhooks",
            "options": {
                "versions": {
                    "axiomasoft/corex-webhooks": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --exclude-group=pg",
        "test:pg": "pest --group=pg",
        "test:coverage": "pest --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/operations/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "pint --test"
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laravel": {
            "providers": []
        },
        "packman": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "operations",
            "owns": [
                "Authorization",
                "Bulk",
                "Cost",
                "Definition",
                "Errors",
                "Idempotency",
                "Internal",
                "Invocation",
                "Laravel",
                "Metadata",
                "OpenApi",
                "Pagination",
                "Testing",
                "Validation",
                "Versioning"
            ]
        }
    }
}
