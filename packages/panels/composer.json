{
    "name": "axiomasoft/corex-panels",
    "description": "Trusted CoreX context integration for Packman panels and saved views.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-panels": "^0.1",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2",
        "axiomasoft/packman-schema": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Panels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Panels\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\Panels\\PanelsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "packman": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "panels",
            "owns": [
                "Laravel"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/panels/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "pint --test"
    }
}
