{
    "name": "axiomasoft/corex-panels",
    "description": "Headless panel descriptors and current-context access catalogue for CoreX modules.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Panels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Panels\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\Panels\\PanelsModule",
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Panels\\Contracts",
                "CoreX\\Panels\\Data",
                "CoreX\\Panels\\SavedViews\\Contracts\\SavedViewRepository",
                "CoreX\\Panels\\SavedViews\\Contracts\\ViewAccessPolicy",
                "CoreX\\Panels\\SavedViews\\Contracts\\ViewSchemaProvider"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Panels\\PanelsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/panels/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "pint --test"
    }
}
