{
    "name": "corex/recurrence",
    "description": "Bounded RFC 5545 recurrence expansion for CoreX consumers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "rlanvin/php-rrule": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Recurrence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Recurrence\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=vendor/autoload.php",
        "analyse": "../../vendor/bin/phpstan analyse -c phpstan.neon src --memory-limit=1G",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
