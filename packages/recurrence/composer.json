{
    "name": "axiomasoft/corex-recurrence",
    "description": "Bounded RFC 5545 recurrence expansion for CoreX consumers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "rlanvin/php-rrule": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Recurrence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Recurrence\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=vendor/autoload.php",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/recurrence/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Recurrence\\Contracts",
                "CoreX\\Recurrence\\Data",
                "CoreX\\Recurrence\\Exceptions",
                "CoreX\\Recurrence\\RRuleRecurrenceExpander"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": []
}
