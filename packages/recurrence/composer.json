{
    "name": "axiomasoft/corex-recurrence",
    "description": "Bounded RFC 5545 recurrence expansion for CoreX consumers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^0.1",
        "laravel/framework": "^13.0",
        "rlanvin/php-rrule": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Recurrence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Recurrence\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=vendor/autoload.php",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/recurrence/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laravel": {
            "providers": [
                "CoreX\\Recurrence\\RecurrenceServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "recurrence",
            "owns": [
                "Contracts",
                "Data",
                "Errors",
                "Exceptions",
                "Internal",
                "Laravel"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ]
}
