{
    "name": "axiomasoft/corex-recurring-tasks",
    "description": "Recurring task materialization with durable scheduling and optional workflow completion capture.",
    "type": "packman-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/corex-recurrence": "^2.0@dev",
        "axiomasoft/corex-tasks": "^2.0@dev",
        "axiomasoft/corex-workflow": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1",
        "ext-bcmath": "*",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "axiomasoft/corex-scheduler": "^2.0@dev",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\RecurringTasks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\RecurringTasks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\RecurringTasks\\RecurringTasksServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "packman": {
            "module": "CoreX\\RecurringTasks\\Internal\\TaskWorkflowIntegration",
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "profile": "modular-platform",
            "error-prefix": "recurring-tasks",
            "owns": [
                "Contracts",
                "Data",
                "Errors",
                "Exceptions",
                "Internal",
                "Laravel"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../recurrence",
            "options": {
                "versions": {
                    "axiomasoft/corex-recurrence": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../tasks",
            "options": {
                "versions": {
                    "axiomasoft/corex-tasks": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../scheduler",
            "options": {
                "versions": {
                    "axiomasoft/corex-scheduler": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../workflow",
            "options": {
                "versions": {
                    "axiomasoft/corex-workflow": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/recurring-tasks/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
