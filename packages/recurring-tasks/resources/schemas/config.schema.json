{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "axiomasoft/corex-recurring-tasks configuration",
    "type": "object",
    "properties": {
        "corex-recurring-tasks": {
            "type": "object",
            "properties": {
                "wakeup": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false
                        },
                        "handler": {
                            "type": "string",
                            "default": "CoreX\\RecurringTasks\\Internal\\MaterializationWakeupHandler"
                        },
                        "handler_kind": {
                            "type": "string",
                            "default": "task-recurrence.materialize"
                        },
                        "handler_version": {
                            "type": "string",
                            "default": "task-materialization/1"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
