{
    "name": "axiomasoft/corex-scheduler",
    "description": "Durable tenant-local scheduling of one-shot work for CoreX.",
    "type": "packman-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "psr/clock": "^1.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Scheduler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Scheduler\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\Scheduler\\SchedulerServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "packman": {
            "module": "CoreX\\Scheduler\\SchedulerModule",
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "modular-platform",
            "error-prefix": "scheduler",
            "owns": [
                "Internal",
                "Laravel",
                "Testing"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/scheduler/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "require-dev": {
        "ext-pdo": "*",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5"
    }
}
