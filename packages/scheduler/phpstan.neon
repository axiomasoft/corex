includes:
    - ../../phpstan-extensions.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:
    level: max
    tmpDir: ../../build/phpstan/scheduler
    paths:
        - src
        - database/migrations
    checkModelProperties: true
    checkPhpDocMissingReturn: true
