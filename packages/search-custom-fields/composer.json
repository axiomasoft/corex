{
    "name": "axiomasoft/corex-search-custom-fields",
    "description": "Optional Custom Fields projection and committed fact subscriber for CoreX Search.",
    "type": "library",
    "license": "MIT",
    "require": {
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/corex-custom-fields": "^2.0@dev",
        "axiomasoft/corex-search": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\SearchCustomFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\SearchCustomFields\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\SearchCustomFields\\SearchCustomFieldsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "packman": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "search-custom-fields",
            "owns": [
                "Invalidation",
                "Laravel",
                "Projection"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../custom-fields",
            "options": {
                "versions": {
                    "axiomasoft/corex-custom-fields": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../search",
            "options": {
                "versions": {
                    "axiomasoft/corex-search": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/search-custom-fields/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5"
    }
}
