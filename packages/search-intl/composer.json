{
    "name": "axiomasoft/corex-search-intl",
    "description": "Optional localized projection glue between axiomasoft/corex-intl and axiomasoft/corex-search.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "axiomasoft/corex-intl": "^1.0@dev",
        "axiomasoft/corex-search": "^1.0@dev",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\SearchIntl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\SearchIntl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "public-api": [
                "CoreX\\SearchIntl\\Contracts",
                "CoreX\\SearchIntl\\Data",
                "CoreX\\SearchIntl\\SearchIntlServiceProvider"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\SearchIntl\\SearchIntlServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../intl"
        },
        {
            "type": "path",
            "url": "../search"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/search-intl/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
