{
    "name": "axiomasoft/corex-search-intl",
    "description": "Optional localized projection glue between axiomasoft/corex-intl and axiomasoft/corex-search.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/corex-intl": "^2.0@dev",
        "axiomasoft/corex-search": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2",
        "axiomasoft/packman-schema": "^0.1",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\SearchIntl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\SearchIntl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\SearchIntl\\SearchIntlServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "packman": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "search-intl",
            "owns": [
                "Contracts",
                "Internal",
                "Projection"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../intl",
            "options": {
                "versions": {
                    "axiomasoft/corex-intl": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../search",
            "options": {
                "versions": {
                    "axiomasoft/corex-search": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/search-intl/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
