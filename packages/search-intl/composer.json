{
    "name": "corex/search-intl",
    "description": "Optional localized projection glue between corex/intl and corex/search.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "corex/intl": "@dev",
        "corex/search": "@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\SearchIntl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\SearchIntl\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "public-api": [
                "CoreX\\SearchIntl\\Contracts",
                "CoreX\\SearchIntl\\Data"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\SearchIntl\\SearchIntlServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../intl"
        },
        {
            "type": "path",
            "url": "../search"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/search-intl/phpstan.neon --memory-limit=1G",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
