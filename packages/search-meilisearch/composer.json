{
    "name": "corex/search-meilisearch",
    "description": "Optional Meilisearch candidate adapter for corex/search.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "corex/core": "^1.0@dev",
        "corex/search": "^1.0@dev",
        "ext-filter": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "meilisearch/meilisearch-php": ">=1.16.1-stable <=1.16.1-stable",
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Search\\Meilisearch\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests"
        ]
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "public-api": [
                "CoreX\\Search\\Meilisearch\\Exceptions"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Search\\Meilisearch\\MeilisearchServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../search"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=meilisearch",
        "test:meilisearch": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=meilisearch",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/search-meilisearch/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "require-dev": {
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3"
    }
}
