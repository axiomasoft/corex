{
    "name": "axiomasoft/corex-search-meilisearch",
    "description": "Optional Meilisearch candidate adapter for axiomasoft/corex-search.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "ext-filter": "*",
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "axiomasoft/corex-search": "^1.0@dev",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "meilisearch/meilisearch-php": ">=1.16.1-stable <=1.16.1-stable"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\SearchMeilisearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\SearchMeilisearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\SearchMeilisearch\\MeilisearchServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../search"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=meilisearch",
        "test:meilisearch": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=meilisearch",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/search-meilisearch/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "phpunit/phpunit": "^13.3"
    }
}
