{
    "name": "axiomasoft/corex-search",
    "description": "Authorized search queries, owner projections and durable index generations for CoreX.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "ext-openssl": "*",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "psr/clock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Search\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\Search\\SearchServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "packman": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "search",
            "owns": [
                "Errors",
                "Exceptions",
                "Index",
                "Internal",
                "Lane",
                "Laravel",
                "Postgres",
                "Projection",
                "Query",
                "Rebuild",
                "Testing"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
        "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/search/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5"
    }
}
