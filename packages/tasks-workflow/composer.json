{
    "name": "corex/tasks-workflow",
    "description": "Recurrence-to-task materialization for CoreX with durable wakeup and optional workflow capture.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "corex/core": "^1.0@dev",
        "corex/modules": "^1.0@dev",
        "corex/tasks": "^1.0@dev",
        "corex/recurrence": "^1.0@dev",
        "corex/workflow": "^1.0@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "suggest": {
        "corex/wakeup": "Durable local wakeup bridge for scheduled materialization (MAT-06)."
    },
    "require-dev": {
        "corex/wakeup": "^1.0@dev",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\TasksWorkflow\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests"
        ]
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\TasksWorkflow\\TaskWorkflowIntegration",
            "package-type": "integration",
            "stability": "stable",
            "public-api": [
                "CoreX\\TasksWorkflow\\Contracts",
                "CoreX\\TasksWorkflow\\Data",
                "CoreX\\TasksWorkflow\\Exceptions"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\TasksWorkflow\\TasksWorkflowServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        },
        {
            "type": "path",
            "url": "../tasks"
        },
        {
            "type": "path",
            "url": "../recurrence"
        },
        {
            "type": "path",
            "url": "../wakeup"
        },
        {
            "type": "path",
            "url": "../workflow"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tasks-workflow/phpstan.neon --memory-limit=1G",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
