{
    "name": "axiomasoft/corex-tasks-workflow",
    "description": "Recurrence-to-task materialization for CoreX with durable wakeup and optional workflow capture.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "ext-bcmath": "*",
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "axiomasoft/corex-recurrence": "^1.0@dev",
        "axiomasoft/corex-tasks": "^1.0@dev",
        "axiomasoft/corex-workflow": "^1.0@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "axiomasoft/corex-wakeup": "^1.0@dev",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\TasksWorkflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\TasksWorkflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\TasksWorkflow\\Internal\\TaskWorkflowIntegration",
            "package-type": "integration",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\TasksWorkflow\\TasksWorkflowServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../recurrence"
        },
        {
            "type": "path",
            "url": "../tasks"
        },
        {
            "type": "path",
            "url": "../wakeup"
        },
        {
            "type": "path",
            "url": "../workflow"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tasks-workflow/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
