{
    "name": "corex/tasks-workflow",
    "description": "Recurrence-to-task materialization for CoreX with durable wakeup and optional workflow capture.",
    "type": "corex-module",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "corex/modules": "@dev",
        "corex/tasks": "@dev",
        "corex/recurrence": "@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "suggest": {
        "corex/wakeup": "Durable local wakeup bridge for scheduled materialization (MAT-06).",
        "corex/workflow": "Optional completion capture through qualified workflow binding (MAT-07)."
    },
    "require-dev": {
        "corex/wakeup": "@dev",
        "corex/workflow": "@dev",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\TasksWorkflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\TasksWorkflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "module": "CoreX\\TasksWorkflow\\TasksWorkflowModule"
        },
        "laravel": {
            "providers": [
                "CoreX\\TasksWorkflow\\TasksWorkflowServiceProvider"
            ]
        }
    },
    "repositories": [
        {"type": "path", "url": "../core"},
        {"type": "path", "url": "../modules"},
        {"type": "path", "url": "../tasks"},
        {"type": "path", "url": "../recurrence"},
        {"type": "path", "url": "../wakeup"},
        {"type": "path", "url": "../workflow"}
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tasks-workflow/phpstan.neon --memory-limit=1G",
        "lint:check": "../../vendor/bin/pint --test"
    }
}
