{
    "name": "corex/tasks",
    "description": "CoreX Tasks module — workspace projects, stages and tasks for DB-per-account applications.",
    "type": "corex-module",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tasks",
        "kanban",
        "projects",
        "multi-tenancy"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "corex/core": "^1.0@dev",
        "corex/modules": "^1.0@dev",
        "ext-mbstring": "*",
        "php": "^8.4",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Tasks\\": "src/",
            "CoreX\\Tasks\\Contracts\\": [
                "src/Task/Contracts/",
                "src/Access/Contracts/",
                "src/Planning/Contracts/"
            ],
            "CoreX\\Tasks\\Data\\": [
                "src/Task/Data/",
                "src/Planning/Data/",
                "src/Project/Data/",
                "src/Sprint/Data/",
                "src/Time/Data/"
            ],
            "CoreX\\Tasks\\Actions\\": "src/Task/Actions/",
            "CoreX\\Tasks\\Events\\": "src/Task/Events/",
            "CoreX\\Tasks\\Enums\\": [
                "src/Task/Enums/",
                "src/Project/Enums/",
                "src/Sprint/Enums/",
                "src/Time/Enums/"
            ],
            "CoreX\\Tasks\\Models\\": [
                "src/Task/Models/",
                "src/Project/Models/",
                "src/Sprint/Models/",
                "src/Time/Models/"
            ],
            "CoreX\\Tasks\\Internal\\Planning\\": "src/Planning/Internal/",
            "CoreX\\Tasks\\Exceptions\\": [
                "src/Planning/Exceptions/",
                "src/Access/Exceptions/"
            ],
            "CoreX\\Tasks\\Support\\": "src/Access/Internal/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Tasks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\Tasks\\TasksModule",
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Tasks\\Contracts",
                "CoreX\\Tasks\\Data",
                "CoreX\\Tasks\\Enums",
                "CoreX\\Tasks\\Events",
                "CoreX\\Tasks\\Exceptions",
                "CoreX\\Tasks\\Models"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Tasks\\TasksServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../modules"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --exclude-group=pg",
        "test:pg": "pest --group=pg",
        "test:coverage": "pest --exclude-group=pg --coverage --min=92",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tasks/phpstan.neon --memory-limit=2G --no-progress",
        "lint": "pint",
        "lint:check": "pint --test"
    }
}
