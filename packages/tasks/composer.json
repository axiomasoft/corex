{
    "name": "axiomasoft/corex-tasks",
    "description": "CoreX Tasks module — workspace projects, stages and tasks for DB-per-account applications.",
    "type": "corex-module",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tasks",
        "kanban",
        "projects",
        "multi-tenancy"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "ext-mbstring": "*",
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "pestphp/pest": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Tasks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Tasks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "module": "CoreX\\Tasks\\TasksModule",
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Tasks\\Access\\Contracts",
                "CoreX\\Tasks\\Access\\Exceptions",
                "CoreX\\Tasks\\Planning\\Contracts",
                "CoreX\\Tasks\\Planning\\Data",
                "CoreX\\Tasks\\Planning\\Exceptions",
                "CoreX\\Tasks\\Project\\Data",
                "CoreX\\Tasks\\Project\\Enums",
                "CoreX\\Tasks\\Project\\Models",
                "CoreX\\Tasks\\Sprint\\Data",
                "CoreX\\Tasks\\Sprint\\Enums",
                "CoreX\\Tasks\\Sprint\\Models",
                "CoreX\\Tasks\\Task\\Contracts",
                "CoreX\\Tasks\\Task\\Data",
                "CoreX\\Tasks\\Task\\Enums",
                "CoreX\\Tasks\\Task\\Events",
                "CoreX\\Tasks\\Task\\Models",
                "CoreX\\Tasks\\Time\\Data",
                "CoreX\\Tasks\\Time\\Enums",
                "CoreX\\Tasks\\Time\\Models"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Tasks\\TasksServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --exclude-group=pg",
        "test:pg": "pest --group=pg",
        "test:coverage": "pest --exclude-group=pg --coverage --min=92",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tasks/phpstan.neon --memory-limit=2G --no-progress",
        "lint": "pint",
        "lint:check": "pint --test"
    }
}
