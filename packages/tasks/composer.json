{
    "name": "corex/tasks",
    "description": "CoreX Tasks module — processes, stages, tasks and projects on corex/core (ULID, tenancy).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "tasks", "kanban", "projects", "multi-tenancy"],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "corex/core": "@dev",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Tasks\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CoreX\\Tasks\\TasksServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
