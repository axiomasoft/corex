{
    "name": "corex/tenancy",
    "description": "CoreX physical DB-per-account tenancy — root-schema control plane on stancl/tenancy v4 (B-11, D13).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "multi-tenancy",
        "stancl",
        "saas"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "corex/core": "^1.0@dev",
        "firebase/php-jwt": "^7.1",
        "axiomasoft/stancl-tenancy": ">=4.0.0-alpha1 <=4.0.0-alpha1",
        "axiomasoft/stancl-jobpipeline": ">=2.0.0-alpha1 <=2.0.0-alpha1",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "corex/modules": "^1.0@dev"
    },
    "require-dev": {
        "league/flysystem-aws-s3-v3": "3.35.3",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.12|^11.3",
        "pestphp/pest": "^5.2",
        "corex/wakeup": "^1.0@dev"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Tenancy\\Events\\Identity\\": "src/Membership/Events/",
            "CoreX\\Tenancy\\Events\\": [
                "src/Account/Events/",
                "src/Identity/Events/",
                "src/DomainTrust/Events/",
                "src/Impersonation/Events/"
            ],
            "CoreX\\Tenancy\\Jobs\\": [
                "src/Membership/Jobs/",
                "src/Provisioning/Jobs/",
                "src/Identity/Jobs/"
            ],
            "CoreX\\Tenancy\\Models\\": [
                "src/Account/Models/",
                "src/Provisioning/Models/",
                "src/Identity/Models/",
                "src/DomainTrust/Models/",
                "src/Impersonation/Models/",
                "src/Workspace/Models/"
            ],
            "CoreX\\Tenancy\\Bootstrappers\\": "src/Laravel/Bootstrappers/",
            "CoreX\\Tenancy\\Commands\\": "src/Laravel/Commands/",
            "CoreX\\Tenancy\\Exceptions\\": [
                "src/Runtime/Exceptions/",
                "src/Authentication/Exceptions/"
            ],
            "CoreX\\Tenancy\\Http\\Controllers\\": "src/Authentication/Http/Controllers/",
            "CoreX\\Tenancy\\Http\\Middleware\\": "src/Laravel/Http/Middleware/",
            "CoreX\\Tenancy\\Listeners\\": "src/Laravel/Listeners/",
            "CoreX\\Tenancy\\Resolvers\\": "src/Laravel/Resolvers/",
            "CoreX\\Tenancy\\Scopes\\": "src/Laravel/Scopes/",
            "CoreX\\Tenancy\\Support\\": "src/Laravel/Support/",
            "CoreX\\Tenancy\\": [
                "src/",
                "src/Runtime/"
            ]
        },
        "classmap": [
            "src/Provisioning/Database/TemplateClonePostgreSQLManager.php"
        ]
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Install the qualified native S3 adapter to explicitly construct optional ObjectTenantStorage.",
        "corex/wakeup": "Install to opt into root_registry wakeup hints; boxed and local_sweep profiles do not require it."
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Tenancy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Tenancy\\Contracts",
                "CoreX\\Tenancy\\Events",
                "CoreX\\Tenancy\\Exceptions",
                "CoreX\\Tenancy\\Models"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Tenancy\\TenancyServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../wakeup"
        },
        {
            "type": "path",
            "url": "../modules"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "process-timeout": 900,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "lint:check": "pint --test"
    }
}
