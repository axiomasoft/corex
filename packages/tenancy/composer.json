{
    "name": "axiomasoft/corex-tenancy",
    "description": "CoreX physical DB-per-account tenancy — root-schema control plane on stancl/tenancy v4 (B-11, D13).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "multi-tenancy",
        "stancl",
        "saas"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "ext-filter": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "php": "^8.4",
        "axiomasoft/corex": "^1.0@dev",
        "axiomasoft/stancl-jobpipeline": ">=2.0.0-alpha1 <=2.0.0-alpha1",
        "axiomasoft/stancl-tenancy": ">=4.0.0-alpha1 <=4.0.0-alpha1",
        "firebase/php-jwt": "^7.1",
        "laravel/framework": "^12.0|^13.0",
        "nesbot/carbon": "^3.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "ext-tokenizer": "*",
        "phpstan/phpstan": "^2.2.16",
        "axiomasoft/corex-wakeup": "^1.0@dev",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "league/flysystem-aws-s3-v3": "3.35.3",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.4",
        "orchestra/testbench": "^10.12|^11.3",
        "orchestra/testbench-core": "^10.12|^11.3",
        "pestphp/pest": "^5.2",
        "symfony/console": "^7.2|^8.0",
        "symfony/http-kernel": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Tenancy\\": "src/"
        }
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Install the qualified native S3 adapter to explicitly construct optional ObjectTenantStorage.",
        "axiomasoft/corex-wakeup": "Install to opt into root_registry wakeup hints; boxed and local_sweep profiles do not require it."
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Tenancy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "public-api": [
                "CoreX\\Tenancy\\Account\\Events",
                "CoreX\\Tenancy\\Authentication\\Exceptions",
                "CoreX\\Tenancy\\Contracts",
                "CoreX\\Tenancy\\DomainTrust\\Events",
                "CoreX\\Tenancy\\Identity\\Events",
                "CoreX\\Tenancy\\Impersonation\\Events",
                "CoreX\\Tenancy\\Membership\\Events",
                "CoreX\\Tenancy\\Runtime\\Exceptions",
                "CoreX\\Tenancy\\Account\\Contracts\\AccountRead",
                "CoreX\\Tenancy\\Account\\Laravel\\AccountRelations",
                "CoreX\\Tenancy\\Account\\Laravel\\AccountTemplateSnapshot",
                "CoreX\\Tenancy\\Account\\Laravel\\MigrationWaveOrchestrator",
                "CoreX\\Tenancy\\DomainTrust\\Data\\ChallengeConsumption",
                "CoreX\\Tenancy\\DomainTrust\\Data\\DomainChallenge",
                "CoreX\\Tenancy\\DomainTrust\\Data\\DomainChallengeBinding",
                "CoreX\\Tenancy\\DomainTrust\\Data\\DomainChallengeDraft",
                "CoreX\\Tenancy\\DomainTrust\\Data\\DomainTrustActor",
                "CoreX\\Tenancy\\DomainTrust\\Data\\DomainTrustTransition",
                "CoreX\\Tenancy\\DomainTrust\\Data\\IssuedDomainChallenge",
                "CoreX\\Tenancy\\DomainTrust\\Data\\NormalizedHost",
                "CoreX\\Tenancy\\DomainTrust\\Data\\ObservedDomainProof",
                "CoreX\\Tenancy\\DomainTrust\\Enums\\DomainTrustChangeReason",
                "CoreX\\Tenancy\\DomainTrust\\Enums\\DomainTrustOperation",
                "CoreX\\Tenancy\\DomainTrust\\Exceptions\\DomainTrustDenied",
                "CoreX\\Tenancy\\DomainTrust\\Exceptions\\DomainTrustDisabled",
                "CoreX\\Tenancy\\DomainTrust\\Laravel\\DomainRelations",
                "CoreX\\Tenancy\\Identity\\Contracts\\IdentitySyncer",
                "CoreX\\Tenancy\\Identity\\Contracts\\MembershipProjection",
                "CoreX\\Tenancy\\Identity\\Laravel\\UserRelations",
                "CoreX\\Tenancy\\Laravel\\AuthenticationRegistrar",
                "CoreX\\Tenancy\\Laravel\\Bootstrappers\\WorkspaceContextBootstrapper",
                "CoreX\\Tenancy\\Laravel\\Commands\\IdentitiesReconcileCommand",
                "CoreX\\Tenancy\\Laravel\\Commands\\PendingClearCommand",
                "CoreX\\Tenancy\\Laravel\\Commands\\PendingCreateCommand",
                "CoreX\\Tenancy\\Laravel\\Commands\\TenantsMigrateCommand",
                "CoreX\\Tenancy\\Laravel\\ConsoleRegistrar",
                "CoreX\\Tenancy\\Laravel\\DatabaseRegistrar",
                "CoreX\\Tenancy\\Laravel\\DomainTrustRegistrar",
                "CoreX\\Tenancy\\Laravel\\EventsRegistrar",
                "CoreX\\Tenancy\\Laravel\\HttpRegistrar",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\AccountStatusGate",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\AllowImpersonatedWrites",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\DenyImpersonatedWrites",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\EnforceSessionLifetime",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\ImpersonationSessionGuard",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\RequireActiveMembership",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\ResolveTenantFromHost",
                "CoreX\\Tenancy\\Laravel\\Http\\Middleware\\ResolveWorkspace",
                "CoreX\\Tenancy\\Laravel\\IdentityRegistrar",
                "CoreX\\Tenancy\\Laravel\\Listeners\\RevertTenancyOnJobException",
                "CoreX\\Tenancy\\Laravel\\ProvisioningRegistrar",
                "CoreX\\Tenancy\\Laravel\\Resolvers\\HostTenantResolver",
                "CoreX\\Tenancy\\Laravel\\RuntimeRegistrar",
                "CoreX\\Tenancy\\Laravel\\Scopes\\WorkspaceScope",
                "CoreX\\Tenancy\\Laravel\\Support\\AccountLifecyclePolicy",
                "CoreX\\Tenancy\\Laravel\\Support\\ImpersonationPolicy",
                "CoreX\\Tenancy\\Laravel\\Support\\StatusGatePolicy",
                "CoreX\\Tenancy\\Laravel\\Support\\TenancyConfigSection",
                "CoreX\\Tenancy\\Laravel\\Support\\TenancyOptions",
                "CoreX\\Tenancy\\Laravel\\WakeupRegistrar",
                "CoreX\\Tenancy\\Laravel\\WorkspaceRegistrar",
                "CoreX\\Tenancy\\Membership\\Contracts\\AccountClickAuthorizer",
                "CoreX\\Tenancy\\Membership\\Contracts\\AccountMenuCache",
                "CoreX\\Tenancy\\Membership\\Contracts\\AccountsReadTransport",
                "CoreX\\Tenancy\\Membership\\Data\\AccountListEntry",
                "CoreX\\Tenancy\\Membership\\Data\\AccountsQuery",
                "CoreX\\Tenancy\\Membership\\Data\\ActorRef",
                "CoreX\\Tenancy\\Membership\\Data\\AvailableAccounts",
                "CoreX\\Tenancy\\Membership\\Data\\ClockReading",
                "CoreX\\Tenancy\\Membership\\Data\\MembershipQuery",
                "CoreX\\Tenancy\\Membership\\Data\\MembershipSnapshot",
                "CoreX\\Tenancy\\Membership\\Data\\PairKey",
                "CoreX\\Tenancy\\Membership\\Data\\PairState",
                "CoreX\\Tenancy\\Membership\\Data\\PairWitness",
                "CoreX\\Tenancy\\Membership\\Data\\RevokeMembershipReceipt",
                "CoreX\\Tenancy\\Membership\\Data\\RevokeMembershipRequest",
                "CoreX\\Tenancy\\Membership\\Enums\\ActorType",
                "CoreX\\Tenancy\\Membership\\Enums\\MembershipEventKind",
                "CoreX\\Tenancy\\Membership\\Enums\\MembershipReason",
                "CoreX\\Tenancy\\Membership\\Enums\\MembershipState",
                "CoreX\\Tenancy\\Membership\\Exceptions\\CentralProtocolViolation",
                "CoreX\\Tenancy\\Membership\\Exceptions\\CentralUnauthorized",
                "CoreX\\Tenancy\\Membership\\Exceptions\\CentralUnavailable",
                "CoreX\\Tenancy\\Membership\\Exceptions\\CredentialIssuanceDenied",
                "CoreX\\Tenancy\\Membership\\Exceptions\\InboxConflict",
                "CoreX\\Tenancy\\Membership\\Exceptions\\PairStoreViolation",
                "CoreX\\Tenancy\\Membership\\Exceptions\\ProjectionDenied",
                "CoreX\\Tenancy\\Membership\\Exceptions\\RevokeUncertain",
                "CoreX\\Tenancy\\Membership\\Laravel\\MembershipSnapshotFactory",
                "CoreX\\Tenancy\\Membership\\Laravel\\RevokeMembershipReceiptFactory",
                "CoreX\\Tenancy\\PHPStan\\Rules\\StanclImportBoundaryRule",
                "CoreX\\Tenancy\\Provisioning\\Contracts\\TemplateIntegrityChecks",
                "CoreX\\Tenancy\\Provisioning\\Data\\ClaimRequest",
                "CoreX\\Tenancy\\Provisioning\\Data\\ClaimResult",
                "CoreX\\Tenancy\\Provisioning\\Data\\QualifiedTemplate",
                "CoreX\\Tenancy\\Provisioning\\Data\\TemplateAccountView",
                "CoreX\\Tenancy\\Provisioning\\Exceptions\\ClaimConflict",
                "CoreX\\Tenancy\\Provisioning\\Exceptions\\ClaimUnavailable",
                "CoreX\\Tenancy\\Provisioning\\Exceptions\\TemplateIntegrityException",
                "CoreX\\Tenancy\\Provisioning\\Laravel\\MigrationBatchRelations",
                "CoreX\\Tenancy\\TenancyServiceProvider",
                "CoreX\\Tenancy\\Workspace\\Contracts\\WorkspaceResolver",
                "CoreX\\Tenancy\\Workspace\\Exceptions\\InvitationNotAcceptableException",
                "CoreX\\Tenancy\\Workspace\\Exceptions\\NoDefaultWorkspaceException",
                "CoreX\\Tenancy\\Laravel\\TenancyPortBindings",
                "CoreX\\Tenancy\\Errors\\Enums\\TenancyErrorCode"
            ]
        },
        "laravel": {
            "providers": [
                "CoreX\\Tenancy\\TenancyServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../wakeup"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "process-timeout": 900,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tenancy/phpstan.neon --memory-limit=2G --no-progress",
        "lint": "pint",
        "lint:check": "pint --test"
    }
}
