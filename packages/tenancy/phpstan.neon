includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:
    level: max
    bootstrapFiles:
        - ../../scripts/phpstan-tenancy-commands.php
    tmpDir: ../../build/phpstan/tenancy
    paths:
        - src
        - database/migrations
    checkModelProperties: true
    checkPhpDocMissingReturn: true
