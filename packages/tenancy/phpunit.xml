<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Pg">
            <directory>tests/Pg</directory>
        </testsuite>

        <!-- P2.13 — статические гейты изоляции (stancl, cross-DB FK, партиция
             путей миграций): без БД и контейнера, поэтому вне pg-лейна. -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>

        <!-- P2.13 — RuleTestCase кастомного PHPStan-правила. data/* — фикстуры,
             они анализируются правилом, а не исполняются раннером. -->
        <testsuite name="PHPStan">
            <directory>tests/PHPStan</directory>
            <exclude>tests/PHPStan/data</exclude>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <!-- PHPStan RuleTestCase поднимает свой контейнер и парсер — 128M ему мало. -->
        <ini name="memory_limit" value="1G"/>

        <!-- root_* is PG-only DDL (D14/D16) — no sqlite lane for this package. -->
        <env name="PGSQL_HOST" value="127.0.0.1"/>
        <env name="PGSQL_PORT" value="5434"/>
        <env name="PGSQL_DATABASE" value="corex_test"/>
        <env name="PGSQL_USERNAME" value="corex"/>
        <env name="PGSQL_PASSWORD" value="corex"/>
        <!-- Generated tenant connections and native archive tools share the UTC test clock. -->
        <env name="PGOPTIONS" value="-c timezone=UTC" force="true"/>
    </php>
</phpunit>
