{
    "name": "axiomasoft/corex-tools",
    "description": "Guarded tool runtime for CoreX operations: schemas, contract hash and MCP projection.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/corex-operations": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1",
        "composer-runtime-api": "^2.1",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "symfony/http-kernel": "^7.2|^8.0"
    },
    "suggest": {
        "axiomasoft/corex-import-export": "Optional bounded import/export adapter for durable bulk operations",
        "opis/json-schema": "2.4.1 — bounded offline tool-schema/1 validation adapter",
        "ext-curl": "Optional webhook transport; missing curl returns capability_unavailable."
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "phpunit/phpunit": "^12.0|^13.0",
        "axiomasoft/corex-import-export": "^2.0@dev",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "opis/json-schema": "^2.4.1",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2",
        "psr/clock": "^1.0",
        "symfony/process": "^7.2|^8.0",
        "axiomasoft/packman-schema": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Tools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Tools\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../operations",
            "options": {
                "versions": {
                    "axiomasoft/corex-operations": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../import-export",
            "options": {
                "versions": {
                    "axiomasoft/corex-import-export": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tools/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "pint --test"
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laravel": {
            "providers": [
                "CoreX\\Tools\\ToolsServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "laravel-package",
            "error-prefix": "tools",
            "owns": [
                "Contracts",
                "Data",
                "Errors",
                "Internal",
                "Mcp"
            ]
        }
    }
}
