parameters:
	ignoreErrors:
		-
			rawMessage: 'Only booleans are allowed in a negated boolean, int|false given.'
			identifier: booleanNot.exprNotBoolean
			count: 1
			path: src/Internal/ApiToolValidator.php

		-
			rawMessage: Cannot cast mixed to string.
			identifier: cast.string
			count: 1
			path: src/Internal/GuardedToolInvoker.php

		-
			rawMessage: 'Argument of an invalid type mixed supplied for foreach, only iterables are supported.'
			identifier: foreach.nonIterable
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Cannot call method data() on mixed.'
			identifier: method.nonObject
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Cannot call method fullPath() on mixed.'
			identifier: method.nonObject
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Cannot call method keyword() on mixed.'
			identifier: method.nonObject
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Cannot call method subErrors() on mixed.'
			identifier: method.nonObject
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Method CoreX\Tools\Internal\OpisToolSchemaValidator::collectErrors() should return list<array{code: string, pointer: string}> but returns non-empty-list<array{code: mixed, pointer: string}>.'
			identifier: return.type
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Parameter #1 $schema of static method CoreX\Operations\Validation\Laravel\SchemaBudget::admit() expects array<string, mixed>, array<int|string, mixed> given.'
			identifier: argument.type
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Parameter #1 $segments of static method CoreX\Tools\Internal\OpisToolSchemaValidator::pointer() expects list<int|string>, mixed given.'
			identifier: argument.type
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: 'Parameter #2 $schema of method Opis\JsonSchema\Validator::validate() expects bool|object|string, mixed given.'
			identifier: argument.type
			count: 1
			path: src/Internal/OpisToolSchemaValidator.php

		-
			rawMessage: Cannot cast mixed to string.
			identifier: cast.string
			count: 3
			path: src/Internal/ToolSchemaWorker.php

		-
			rawMessage: Casting to string something that's already string.
			identifier: cast.useless
			count: 2
