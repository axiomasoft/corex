{
  "name": "corex/wakeup",
  "description": "Durable local wakeup requests for CoreX modules.",
  "type": "corex-module",
  "license": "MIT",
  "require": {"php": "^8.3", "corex/core": "@dev", "corex/modules": "@dev", "illuminate/contracts": "^12.0|^13.0", "illuminate/database": "^12.0|^13.0", "illuminate/support": "^12.0|^13.0", "psr/clock": "^1.0"},
  "autoload": {"psr-4": {"CoreX\\Wakeup\\": "src/"}},
  "autoload-dev": {"classmap": ["tests"]},
  "extra": {"corex": {"schema-version": 1, "module": "CoreX\\Wakeup\\WakeupModule", "package-type": "capability", "stability": "experimental", "public-api": ["CoreX\\Wakeup\\Contracts", "CoreX\\Wakeup\\Data"]}, "laravel": {"providers": ["CoreX\\Wakeup\\WakeupServiceProvider"]}},
  "repositories": [{"type": "path", "url": "../core"}, {"type": "path", "url": "../modules"}],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
    "test:pg": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg",
    "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg --coverage --min=80",
    "analyse": "cd ../.. && vendor/bin/phpstan analyse -c phpstan.neon packages/wakeup/src --memory-limit=1G",
    "lint:check": "../../vendor/bin/pint --test"
  }
}
