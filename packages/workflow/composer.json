{
  "name": "corex/workflow",
  "description": "Optional durable workflow engine binding for CoreX modules.",
  "type": "corex-module",
  "license": "MIT",
  "require": {"php": "^8.3", "corex/core": "@dev", "corex/modules": "@dev", "illuminate/contracts": "^12.0|^13.0", "illuminate/database": "^12.0|^13.0", "illuminate/support": "^12.0|^13.0"},
  "autoload": {"psr-4": {"CoreX\\Workflow\\": "src/"}},
  "autoload-dev": {"psr-4": {"CoreX\\Workflow\\Tests\\": "tests/"}},
  "extra": {"corex": {"module": "CoreX\\Workflow\\WorkflowModule"}, "laravel": {"providers": ["CoreX\\Workflow\\WorkflowServiceProvider"]}},
  "repositories": [{"type": "path", "url": "../core"}, {"type": "path", "url": "../modules"}],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php",
    "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
    "analyse": "cd ../.. && vendor/bin/phpstan analyse -c phpstan.neon packages/workflow/src --memory-limit=1G",
    "lint:check": "../../vendor/bin/pint --test"
  }
}
