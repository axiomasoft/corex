{
    "name": "axiomasoft/corex-workflow",
    "description": "Optional durable workflow engine binding for CoreX modules.",
    "type": "packman-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.1",
        "axiomasoft/packman-schema": "^0.1",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "psr/clock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "CoreX\\Workflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreX\\Workflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable"
        },
        "laravel": {
            "providers": [
                "CoreX\\Workflow\\WorkflowServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "packman": {
            "module": "CoreX\\Workflow\\WorkflowModule",
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "profile": "modular-platform",
            "error-prefix": "workflow",
            "owns": [
                "Contracts",
                "Data",
                "Enums",
                "Execution",
                "Internal",
                "Laravel"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php",
        "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --coverage --min=80",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/workflow/phpstan.neon --memory-limit=2G --no-progress",
        "lint:check": "../../vendor/bin/pint --test"
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5"
    }
}
