# Второй, САМОСТОЯТЕЛЬНЫЙ PHPStan-прогон: 9 правил Packman Modules
# (transaction-pooling дисциплина, P1.13) на каталоге `tests/` — item P1.28, D48.
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ КОНФИГ, а не `paths += tests` в корневом `phpstan.neon`:
# корневой прогон включает `larastan/extension.neon` на `level: 6`, а Pest-идиома
# (`$this`-биндинг в `it()`/`beforeEach()`) даёт под Larastan 60 несвязанных
# `property.notFound` — они сорвали P1.14 (D48). Здесь Larastan НЕ подключается:
# mixin-резолюция Pest не участвует, шум исчезает вместе с ней, а 9 правил
# работают ТЕМИ ЖЕ — они читают AST и строки-константы, а не типы.
# `includes:` умышленно НЕ ссылается на `phpstan.neon` — иначе Larastan вернулся бы
# транзитивно.
#
# ПОЧЕМУ `level: 0` (эмпирически, первый прогон 2026-07-28 — Implementation Rules P1.28).
# Замер без `excludePaths`/`ignoreErrors` (всего / из них находки правил / посторонние):
#   level 0 → 23 / 23 / 0
#   level 1 → 98 /  9 / 89   (`method.notFound`/`staticMethod.notFound`/`property.notFound` —
#   level 2 → 103 / 9 / 94    без Larastan фасады и Eloquent не резолвятся)
# С level ≥ 1 PHPStan обрывает анализ выражения на первой ошибке, и до правил доходит
# ВТРОЕ меньше вызовов: подъём уровня здесь ОСЛАБЛЯЕТ гейт, а не усиливает.

includes:
    - packages/core/extension.neon
    - vendor/axiomasoft/packman-modules/packages/modules/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    parallel:
        maximumNumberOfProcesses: 1
    tmpDir: build/phpstan-tests-lint

    scanFiles:
        - scripts/schema-gate.php
        - scripts/quality/rector/Import/SourceSnapshot.php

    paths:
        - tests
        - packages/operations/tests
        - packages/access/tests
        - products/flex-crm/tests
        - packages/tasks/tests
        - packages/tenancy/tests

    scanDirectories:
        - fixtures/consumers/equipment-registry/src
        - packages/access/src
        - packages/access/database/seeders
        - products/flex-crm/src
        - packages/tasks/src
        - packages/tenancy/src

    bootstrapFiles:
        - tests/phpstan-stubs/AwsS3Client.php

    level: 0

    excludePaths:
        analyse:
            # Негативные фикстуры самих правил: это ВХОДНЫЕ ДАННЫЕ `RuleTestCase`
            # (`tests/PHPStan/ModuleBoundaryRulesTest.php`, `TransactionPoolingRulesTest.php`),
            # а не код проекта. Каждый файл — нарушение ПО ЗАМЫСЛУ (иначе правило
            # не пинилось бы). Анализировать их этим же прогоном — категориальная
            # ошибка: 7 гарантированно-красных строк, ничего не измеряющих.
            - tests/PHPStan/data
            - tests/fixtures/package-graph/tenancy-wakeup-foreign-context.php
            - tests/fixtures/table-write-ownership/foreign-table-write.php

    ignoreErrors:
        # ────────────────────────────────────────────────────────────────────────
        # Первый прогон (2026-07-28) дал 16 находок в 5 файлах. Каждая прочитана
        # построчно: все — НАМЕРЕННЫЙ обход контракта, и обход и есть предмет теста.
        # Это НЕ baseline (скрытый долг, который «когда-нибудь починим») — это
        # доменная граница: правила писаны для РАНТАЙМ-КОДА МОДУЛЯ, а корневой
        # `tests/` — харнесс САМОГО ядра. Тот же структурный слепок, что P1.14 уже
        # признал для миграций (`NoDirectSystemTableWriteRule::isMigrationFile()`):
        # владелец таблицы без неймспейса правилу неотличим от чужого модуля.
        #
        # `count` точный + `reportUnmatchedIgnoredErrors` (дефолт `true`) ⇒ гейт
        # краснеет в ОБЕ стороны: новая находка в этих файлах не пролезет, исчезнувшая
        # заставит обновить конфиг. Правила остаются вооружёнными на всём остальном
        # `tests/` — новый файл с `SET`/`LISTEN`/temp-table/`PREPARE`/`eval`/записью
        # в `sys_*`/`mod_*` красит прогон.

        # --- modules.directSystemTableWrite -----------------------------------
        # Прямая запись в `sys_*`/`mod_*` в arrange/assert: через контракт владельца
        # эти тесты недостижимы по построению.
        -
            # Дубль `is_primary` — предмет теста partial-unique в БД (AC-24d);
            # плюс arrange для subtree()/primaryOf()/soft-delete (AC-24e/AC-24).
            identifier: modules.directSystemTableWrite
            path: tests/Feature/DepartmentTest.php
            count: 4
        -
            # Регрессия расширенного CHECK `actor_type` (D138): строка обязана
            # писаться СЫРЬЁМ, иначе контракт подставит своё значение и CHECK
            # не будет тем, что под тестом.
            identifier: modules.directSystemTableWrite
            path: tests/Feature/ImpersonatedActorTest.php
            count: 4
        -
            # Дубль account-строки СЫРЫМ insert'ом: репозиторий ходит через
            # `updateOrCreate()` и второй INSERT не эмитит никогда — через него
            # констрейнт `UNIQUE NULLS NOT DISTINCT` недостижим (A57/A63).
            identifier: modules.directSystemTableWrite
            path: tests/Feature/SettingsTest.php
            count: 2

        # --- package-suite fixtures (P1.1) ------------------------------------
        # ScopeResolver's raw rows establish the ltree department hierarchy
        # consumed by the resolver under test; the owning contract cannot
        # create this deliberately malformed/cross-branch fixture.
        -
            identifier: modules.directSystemTableWrite
            path: packages/access/tests/Pg/ScopeResolverTest.php
            count: 1
        # AccessChecker uses the same real core ltree department fixture to
        # prove its public record path, then removes its table for the
        # fail-closed path; sibling/NULL/non-user cases deny.
        -
            identifier: modules.directSystemTableWrite
            path: packages/access/tests/Pg/AccessCheckerTest.php
            count: 2
        # WorkspaceResolver verifies the tenancy/auth boundary with raw core
        # department membership rows. Keep the exception exact: any additional
        # write, or either removed fixture write, fails this standalone pass.
        -
            identifier: modules.directSystemTableWrite
            path: packages/tenancy/tests/Feature/WorkspaceResolverTest.php
            count: 2

        # These Operations fixtures place rows at exact retention times,
        # install malformed rows to exercise constraints, or remove the
        # idempotency table to prove the gate fails before execution.
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_(budget_buckets|budget_reservations|bulk_operations)"#'
            path: packages/operations/tests/Feature/ApiRetentionTest.php
            count: 6
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/ApiRoutesTest.php
            count: 1
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/AuthorizationLayersTest.php
            count: 1
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/CostInvocationTest.php
            count: 2
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/IdempotentInvocationTest.php
            count: 2
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_(budget_buckets|budget_reservations|bulk_operations|webhook_subscriptions|webhook_deliveries|webhook_attempts)"#'
            path: packages/operations/tests/Feature/LoadSchemaTest.php
            count: 9
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_(budget_buckets|budget_reservations)"#'
            path: packages/operations/tests/Feature/OperationBudgetTest.php
            count: 3
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: tests/Feature/OperationContractTest.php
            count: 1

        # --- modules.setWithoutLocal -----------------------------------------
        # Единственный санкционированный session-level `SET` в харнессе —
        # `set lock_timeout` на ОТДЕЛЬНОМ пробном коннекшене: он обязан пережить
        # оператор и подействовать на СЛЕДУЮЩИЙ вызов `move()`,
        # который открывает собственную транзакцию. `SET LOCAL` здесь не просто
        # эквивалент — он сделал бы доказательство взятия advisory-lock пустым.
        # Привязка — ТОЛЬКО по файлу и точному счёту: сообщение правила не несёт
        # самого SQL, отличить `SET lock_timeout` от `SET search_path` регексом
        # нечем. Второй session-level `SET` в этом файле красит прогон.
        -
            identifier: modules.setWithoutLocal
            path: tests/Feature/DepartmentTest.php
            count: 1
        # NativePermissionTest changes the session time zone to verify the
        # authorization clock against a differently configured PostgreSQL session.
        -
            identifier: modules.setWithoutLocal
            path: packages/access/tests/Pg/NativePermissionTest.php
            count: 1
