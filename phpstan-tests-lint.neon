# Run CoreX and Packman module rules over the test harness. Larastan is enabled
# separately for production code. The Pest mixin infers unrelated properties on
# test closures. Level 0 visits their complete expressions for the AST rules.
# In the original comparison, level 0 exposed 23 rule violations. At levels 1
# and 2, type resolution stopped earlier and only nine violations reached them.

includes:
    - packages/core/extension.neon
    - vendor/axiomasoft/packman-modules/packages/modules/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    parallel:
        maximumNumberOfProcesses: 1
    tmpDir: build/phpstan-tests-lint

    scanFiles:
        - scripts/schema-gate.php
        - scripts/quality/rector/Import/SourceSnapshot.php

    paths:
        - tests
        - packages/operations/tests
        - packages/access/tests
        - products/flex-crm/tests
        - packages/tasks/tests
        - packages/tenancy/tests

    scanDirectories:
        - fixtures/consumers/equipment-registry/src
        - packages/access/src
        - packages/access/database/seeders
        - products/flex-crm/src
        - packages/tasks/src
        - packages/tenancy/src

    bootstrapFiles:
        - tests/phpstan-stubs/AwsS3Client.php

    level: 0

    excludePaths:
        analyse:
            # RuleTestCase consumes these intentionally invalid inputs.
            - tests/PHPStan/data
            - tests/fixtures/package-graph/tenancy-wakeup-foreign-context.php
            - tests/fixtures/table-write-ownership/foreign-table-write.php

    ignoreErrors:
        # Tests exercise database constraints through the owning tables. Scope each
        # exception to its path and count so new and obsolete exceptions fail the gate.

        # --- modules.directSystemTableWrite -----------------------------------
        # These fixtures insert rows the tested contracts cannot produce.
        -
            # Duplicating is_primary exercises the partial unique constraint.
            # Other writes arrange subtree(), primaryOf() and soft deletion.
            identifier: modules.directSystemTableWrite
            path: tests/Feature/DepartmentTest.php
            count: 4
        -
            # Raw inserts exercise the actor_type CHECK with values the API would normalize.
            identifier: modules.directSystemTableWrite
            path: tests/Feature/ImpersonatedActorTest.php
            count: 4
        -
            # Insert a second account row directly to exercise UNIQUE NULLS NOT DISTINCT.
            # The repository would update the existing row.
            identifier: modules.directSystemTableWrite
            path: tests/Feature/SettingsTest.php
            count: 2

        # Package fixtures
        # ScopeResolver's raw rows establish the ltree department hierarchy
        # consumed by the resolver under test, and soft-delete departments to
        # prove removed ones drop out of scope; the owning contract cannot
        # create this deliberately malformed/cross-branch fixture.
        -
            identifier: modules.directSystemTableWrite
            path: packages/access/tests/Pg/ScopeResolverTest.php
            count: 2
        # AccessChecker uses the same real core ltree department fixture to
        # prove its public record path, then removes its table for the
        # fail-closed path; sibling/NULL/non-user cases deny.
        -
            identifier: modules.directSystemTableWrite
            path: packages/access/tests/Pg/AccessCheckerTest.php
            count: 2
        # WorkspaceResolver verifies the tenancy/auth boundary with raw core
        # department membership rows. Keep the exception exact: any additional
        # write, or either removed fixture write, fails this standalone pass.
        -
            identifier: modules.directSystemTableWrite
            path: packages/tenancy/tests/Feature/WorkspaceResolverTest.php
            count: 2

        # These Operations fixtures place rows at exact retention times,
        # install malformed rows to exercise constraints, or remove the
        # idempotency table to prove the gate fails before execution.
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_(budget_buckets|budget_reservations|bulk_operations)"#'
            path: packages/operations/tests/Feature/ApiRetentionTest.php
            count: 6
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/ApiRoutesTest.php
            count: 1
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/AuthorizationLayersTest.php
            count: 1
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/CostInvocationTest.php
            count: 2
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: packages/operations/tests/Feature/IdempotentInvocationTest.php
            count: 2
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_(budget_buckets|budget_reservations|bulk_operations|webhook_subscriptions|webhook_deliveries|webhook_attempts)"#'
            path: packages/operations/tests/Feature/LoadSchemaTest.php
            count: 9
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_(budget_buckets|budget_reservations)"#'
            path: packages/operations/tests/Feature/OperationBudgetTest.php
            count: 3
        -
            identifier: modules.directSystemTableWrite
            message: '#^Direct write to core table "sys_api_idempotency"#'
            path: tests/Feature/OperationContractTest.php
            count: 1

        # --- modules.setWithoutLocal -----------------------------------------
        # The advisory-lock test sets lock_timeout on its dedicated probe connection
        # before move() opens a transaction. SET LOCAL would expire too soon.
        # The diagnostic omits the SQL text, so constrain the exception by file and count.
        -
            identifier: modules.setWithoutLocal
            path: tests/Feature/DepartmentTest.php
            count: 1
        # NativePermissionTest changes the session time zone to verify the
        # authorization clock against a differently configured PostgreSQL session.
        -
            identifier: modules.setWithoutLocal
            path: packages/access/tests/Pg/NativePermissionTest.php
            count: 1
