# Второй, САМОСТОЯТЕЛЬНЫЙ PHPStan-прогон: 9 правил `corex/modules-lint`
# (transaction-pooling дисциплина, P1.13) на каталоге `tests/` — item P1.28, D48.
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ КОНФИГ, а не `paths += tests` в корневом `phpstan.neon`:
# корневой прогон включает `larastan/extension.neon` на `level: 6`, а Pest-идиома
# (`$this`-биндинг в `it()`/`beforeEach()`) даёт под Larastan 60 несвязанных
# `property.notFound` — они сорвали P1.14 (D48). Здесь Larastan НЕ подключается:
# mixin-резолюция Pest не участвует, шум исчезает вместе с ней, а 9 правил
# работают ТЕМИ ЖЕ — они читают AST и строки-константы, а не типы.
# `includes:` умышленно НЕ ссылается на `phpstan.neon` — иначе Larastan вернулся бы
# транзитивно.
#
# ПОЧЕМУ `level: 0` (эмпирически, первый прогон 2026-07-28 — Implementation Rules P1.28):
#   level 0 → 16 находок правил, 0 посторонних ошибок;
#   level 1 → 9 находок правил + 21 посторонняя (`method.notFound`/`staticMethod.notFound`/
#             `property.notFound` — без Larastan фасады и Eloquent не резолвятся);
#   level 2 → 9 находок правил + 21 посторонняя.
# С level ≥ 1 PHPStan обрывает анализ выражения на первой ошибке, и часть вызовов
# до правил уже не доходит: подъём уровня здесь ОСЛАБЛЯЕТ гейт, а не усиливает.

includes:
    - packages/modules/extension.neon

parameters:
    paths:
        - tests

    level: 0

    excludePaths:
        analyse:
            # Негативные фикстуры самих правил: это ВХОДНЫЕ ДАННЫЕ `RuleTestCase`
            # (`tests/PHPStan/ModuleBoundaryRulesTest.php`, `TransactionPoolingRulesTest.php`),
            # а не код проекта. Каждый файл — нарушение ПО ЗАМЫСЛУ (иначе правило
            # не пинилось бы). Анализировать их этим же прогоном — категориальная
            # ошибка: 7 гарантированно-красных строк, ничего не измеряющих.
            - tests/PHPStan/data

    ignoreErrors:
        # ────────────────────────────────────────────────────────────────────────
        # Первый прогон (2026-07-28) дал 16 находок в 5 файлах. Каждая прочитана
        # построчно: все — НАМЕРЕННЫЙ обход контракта, и обход и есть предмет теста.
        # Это НЕ baseline (скрытый долг, который «когда-нибудь починим») — это
        # доменная граница: правила писаны для РАНТАЙМ-КОДА МОДУЛЯ, а корневой
        # `tests/` — харнесс САМОГО ядра. Тот же структурный слепок, что P1.14 уже
        # признал для миграций (`NoDirectSystemTableWriteRule::isMigrationFile()`):
        # владелец таблицы без неймспейса правилу неотличим от чужого модуля.
        #
        # `count` точный + `reportUnmatchedIgnoredErrors` (дефолт `true`) ⇒ гейт
        # краснеет в ОБЕ стороны: новая находка в этих файлах не пролезет, исчезнувшая
        # заставит обновить конфиг. Правила остаются вооружёнными на всём остальном
        # `tests/` — новый файл с `SET`/`LISTEN`/temp-table/`PREPARE`/`eval`/записью
        # в `sys_*`/`mod_*` красит прогон.

        # --- corexModules.directSystemTableWrite (13) -------------------------
        # Прямая запись в `sys_*`/`mod_*` в arrange/assert: через контракт владельца
        # эти тесты недостижимы по построению.
        -
            # Дубль `is_primary` — предмет теста partial-unique в БД (AC-24d);
            # плюс arrange для subtree()/primaryOf()/soft-delete (AC-24e/AC-24).
            identifier: corexModules.directSystemTableWrite
            path: tests/Feature/DepartmentTest.php
            count: 4
        -
            # Регрессия расширенного CHECK `actor_type` (D138): строка обязана
            # писаться СЫРЬЁМ, иначе контракт подставит своё значение и CHECK
            # не будет тем, что под тестом.
            identifier: corexModules.directSystemTableWrite
            path: tests/Feature/ImpersonatedActorTest.php
            count: 4
        -
            # Две append-only строки в заданном порядке — предмет теста монотонность
            # курсора `seq` (D42), независимая от `id`/`occurred_at`.
            identifier: corexModules.directSystemTableWrite
            path: tests/Feature/MigrationPublishTest.php
            count: 1
        -
            # (1) детерминизация `created_at` для патча-саботажа purge-порядка
            # (без неё мутант выживает); (2) посев `mod_modules` для регрессии
            # container-биндинга `ModuleStateReader` (D63/D65) — контракт писал бы
            # в дефолтный коннекшен, т.е. мимо предмета теста.
            identifier: corexModules.directSystemTableWrite
            path: tests/Feature/ModuleLifecycleTest.php
            count: 2
        -
            # Дубль account-строки СЫРЫМ insert'ом: репозиторий ходит через
            # `updateOrCreate()` и второй INSERT не эмитит никогда — через него
            # констрейнт `UNIQUE NULLS NOT DISTINCT` недостижим (A57/A63).
            identifier: corexModules.directSystemTableWrite
            path: tests/Feature/SettingsTest.php
            count: 2

        # --- corexModules.setWithoutLocal (3) ---------------------------------
        # Единственный санкционированный session-level `SET` в харнессе —
        # `set lock_timeout` на ОТДЕЛЬНОМ пробном коннекшене: он обязан пережить
        # оператор и подействовать на СЛЕДУЮЩИЙ вызов (`move()`/`enable()`),
        # который открывает собственную транзакцию. `SET LOCAL` здесь не просто
        # эквивалент — он сделал бы доказательство взятия advisory-lock пустым.
        # Привязка — ТОЛЬКО по файлу и точному счёту: сообщение правила не несёт
        # самого SQL, отличить `SET lock_timeout` от `SET search_path` регексом
        # нечем. Поэтому граница держится счётом: ЧЕТВЁРТЫЙ session-level `SET`
        # в этих двух файлах (как и первый в любом другом) красит прогон.
        -
            identifier: corexModules.setWithoutLocal
            path: tests/Feature/DepartmentTest.php
            count: 1
        -
            identifier: corexModules.setWithoutLocal
            path: tests/Feature/ModuleLifecycleTest.php
            count: 2
