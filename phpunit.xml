<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         executionOrder="default"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="Golden">
            <directory>tests/Golden</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="ToolsPackage">
            <directory>packages/tools/tests</directory>
        </testsuite>
        <testsuite name="WebhooksPackage">
            <directory>packages/webhooks/tests</directory>
        </testsuite>
        <testsuite name="ApiPackage">
            <directory>packages/operations/tests/Feature</directory>
            <directory>packages/operations/tests/Unit</directory>
        </testsuite>
        <testsuite name="SavedViewsPackage">
            <directory>packages/panels/tests/SavedViews</directory>
        </testsuite>
        <testsuite name="CorePackage">
            <directory>packages/core/tests/Foundation/Tooling</directory>
            <directory>packages/core/tests/Unit</directory>
            <directory>packages/core/tests/Storage</directory>
            <directory>packages/core/tests/Feature</directory>
            <directory>packages/core/tests/Pg</directory>
            <directory>packages/core/tests/Support</directory>
        </testsuite>
        <testsuite name="ModulesPackage">
            <directory>packages/core/tests/Modules</directory>
        </testsuite>
        <testsuite name="WorkflowPackage">
            <directory>packages/workflow/tests</directory>
        </testsuite>
        <testsuite name="AttributesPackage">
            <directory>packages/custom-fields/tests</directory>
        </testsuite>
        <testsuite name="ImportExportPackage">
            <directory>packages/import-export/tests</directory>
        </testsuite>
        <testsuite name="SearchPackage">
            <directory>packages/search/tests</directory>
        </testsuite>
        <testsuite name="SearchCustomFieldsPackage">
            <directory>packages/search-custom-fields/tests</directory>
        </testsuite>
        <testsuite name="SearchMeilisearchPackage">
            <directory>packages/search-meilisearch/tests</directory>
        </testsuite>
        <testsuite name="RecurringTasksPackage">
            <directory>packages/recurring-tasks/tests</directory>
        </testsuite>
        <testsuite name="TasksWorkflowPackage">
            <directory>packages/tasks-workflow/tests</directory>
        </testsuite>
        <testsuite name="IntlPackage">
            <directory>packages/intl/tests</directory>
        </testsuite>

        <!-- Layer and isolation checks read source files without booting the application. -->
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>

        <!-- PHPStan analyzes the intentionally invalid fixtures in data/. -->
        <testsuite name="PHPStan">
            <directory>tests/PHPStan</directory>
            <exclude>tests/PHPStan/data</exclude>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>packages/operations/src</directory>
            <directory>packages/core/src</directory>
            <directory>packages/workflow/src</directory>
            <directory>packages/custom-fields/src</directory>
            <directory>packages/import-export/src</directory>
            <directory>packages/search/src</directory>
            <directory>packages/search-custom-fields/src</directory>
            <directory>packages/search-meilisearch/src</directory>
            <directory>packages/recurring-tasks/src</directory>
            <directory>packages/tasks-workflow/src</directory>
            <directory>packages/intl/src</directory>
        </include>
    </source>

    <php>
        <!-- PHPStan RuleTestCase loads its own container and parser. -->
        <ini name="memory_limit" value="1G"/>

        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>

        <!-- The pg group uses the PostgreSQL service from docker-compose.yml. -->
        <env name="PGSQL_HOST" value="127.0.0.1"/>
        <env name="PGSQL_PORT" value="5434"/>
        <env name="PGSQL_DATABASE" value="corex_test"/>
        <env name="PGSQL_USERNAME" value="corex"/>
        <env name="PGSQL_PASSWORD" value="corex"/>
    </php>
</phpunit>
