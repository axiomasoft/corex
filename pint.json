{
    "preset": "laravel",
    "rules": {
        "blank_line_before_statement": {
            "statements": [
                "break",
                "continue",
                "declare",
                "if",
                "return",
                "throw",
                "try"
            ]
        },
        "global_namespace_import": {
            "import_classes": true
        },
        "trailing_comma_in_multiline": {
            "elements": [
                "arguments",
                "arrays",
                "match",
                "parameters"
            ]
        }
    },
    "notPath": [
        "/^packages\\/[^\\/]+\\/database\\/migrations\\//",
        "/^products\\/[^\\/]+\\/database\\/migrations\\//",
        "/^plans\\/.*\\/preimage\\//",
        "/^plans\\/2026\\.09\\.27-№1-COREX-KERNEL\\/artifacts\\/P04-design\\/scripts\\/inventory\\.php$/"
    ]
}
