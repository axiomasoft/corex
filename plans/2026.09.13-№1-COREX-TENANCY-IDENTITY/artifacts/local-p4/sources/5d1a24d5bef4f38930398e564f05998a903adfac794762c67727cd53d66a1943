<?php

declare(strict_types=1);

namespace CoreX\Tenancy\Membership\Internal\Transport;

use CoreX\Tenancy\Central\CentralProtocolViolation;
use DateTimeImmutable;

/** @internal Snapshot only; never a lease or credential grant. */
final readonly class MembershipSnapshot
{
    public function __construct(public string $profileVersion, public string $requestId, public string $identityId, public string $accountId, public string $product, public ?string $membershipId, public MembershipState $state, public string $revision, public string $revokeGeneration, public DateTimeImmutable $readStartedAt, public DateTimeImmutable $observedAt)
    {
        Value::profile($profileVersion);
        Value::uuid($requestId);
        Value::uuid($identityId);
        Value::uuid($accountId);
        Value::product($product);
        Value::counter($revision);
        Value::counter($revokeGeneration);

        if ($membershipId !== null) {
            Value::uuid($membershipId);
        }

        if ($state === MembershipState::Active && $membershipId === null || $observedAt < $readStartedAt) {
            throw new CentralProtocolViolation('Invalid membership authority snapshot.');
        }
    }

    /** @param array<string, mixed> $p */
    public static function fromPayload(array $p): self
    {
        Value::fields($p, ['profile_version', 'request_id', 'identity_id', 'account_id', 'product', 'membership_id', 'state', 'revision', 'revoke_generation', 'read_started_at', 'observed_at']);

        if ($p['membership_id'] !== null && ! is_string($p['membership_id'])) {
            throw new CentralProtocolViolation('Invalid nullable membership UUID.');
        }
        $state = MembershipState::tryFrom(Value::string($p, 'state')) ?? throw new CentralProtocolViolation('Unknown membership state.');

        return new self(profileVersion: Value::string($p, 'profile_version'), requestId: Value::string($p, 'request_id'), identityId: Value::string($p, 'identity_id'), accountId: Value::string($p, 'account_id'), product: Value::string($p, 'product'), membershipId: $p['membership_id'], state: $state, revision: Value::string($p, 'revision'), revokeGeneration: Value::string($p, 'revoke_generation'), readStartedAt: Value::utc(Value::string($p, 'read_started_at')), observedAt: Value::utc(Value::string($p, 'observed_at')));
    }
}
