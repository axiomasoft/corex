<?php

declare(strict_types=1);

namespace CoreX\Tenancy\Central;

final class CentralValue
{
    public static function uuid(string $value, string $field): string
    {
        if (preg_match('/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i', $value) !== 1) {
            throw new CentralProtocolViolation("{$field} must be a UUID.");
        }

        return strtolower($value);
    }

    public static function nonEmpty(string $value, string $field): string
    {
        if (trim($value) === '') {
            throw new CentralProtocolViolation("{$field} must not be empty.");
        }

        return $value;
    }
}
