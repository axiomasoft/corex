new file mode 100644
index 0000000..cf3ef49
--- /dev/null
+++ b/packages/operations/src/Definition/OperationSectionCompiler.php
@@ -0,0 +1,68 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Api;
+
+use CoreX\Modules\Compiler\ApiOperationValidator;
+use CoreX\Modules\Compiler\NormalizedExtension;
+use CoreX\Modules\Contracts\ManifestSectionCompiler;
+use CoreX\Modules\Exceptions\CompilationException;
+use CoreX\Modules\Extend\Api;
+use CoreX\Modules\ModuleManifest;
+
+/** @internal Operation declaration compilation. */
+final class OperationSectionCompiler implements ManifestSectionCompiler
+{
+    public function mode(): string
+    {
+        return 'operation';
+    }
+
+    public function phase(): int
+    {
+        return 0;
+    }
+
+    public function compile(array $declarations, array $all): void
+    {
+        $ids = [];
+        $paths = [];
+        $operations = [];
+
+        foreach ($declarations as $api) {
+            ApiOperationValidator::validate($api);
+            $id = $api->version.':'.$api->operationId;
+            $path = $api->version.':'.$api->method.':'.preg_replace('/\{[a-zA-Z_][a-zA-Z0-9_]*\}/', '{}', $api->path);
+
+            if (isset($ids[$id]) || isset($paths[$path])) {
+                throw new CompilationException('Duplicate API operation identifier or route: '.$id);
+            }
+
+            foreach ($operations as $other) {
+                ApiOperationValidator::validateRoutePair($api, $other);
+            }
+
+            $ids[$id] = true;
+            $paths[$path] = true;
+            $operations[] = $api;
+
+        }
+    }
+
+    public function normalize(ModuleManifest $manifest, Api $api, string $ownerVersion): array
+    {
+        return [
+            new NormalizedExtension(
+                point: 'api.operation',
+                id: $api->version.':'.$api->operationId,
+                owner: $manifest->composerName,
+                ownerVersion: $ownerVersion,
+                payload: [
+                    'method' => $api->method,
+                    'path' => preg_replace('/\{[a-zA-Z_][a-zA-Z0-9_]*\}/', '{}', $api->path),
+                ],
+            ),
+        ];
+    }
+}
diff --git a/packages/operations/src/Tools/ToolSectionCompiler.php b/packages/operations/src/Tools/ToolSectionCompiler.php
new file mode 100644
index 0000000..5c0d32f
--- /dev/null
+++ b/packages/operations/src/Tools/ToolSectionCompiler.php
@@ -0,0 +1,94 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Api;
+
+use CoreX\Modules\Compiler\ApiToolValidator;
+use CoreX\Modules\Compiler\NormalizedExtension;
+use CoreX\Modules\Contracts\ManifestSectionCompiler;
+use CoreX\Modules\Exceptions\CompilationException;
+use CoreX\Modules\Extend\Api;
+use CoreX\Modules\ModuleManifest;
+
+/** @internal Tool declaration compilation. */
+final class ToolSectionCompiler implements ManifestSectionCompiler
+{
+    public function mode(): string
+    {
+        return 'tool';
+    }
+
+    public function phase(): int
+    {
+        return 10;
+    }
+
+    public function compile(array $declarations, array $all): void
+    {
+        $operationsByModule = [];
+        $toolTuples = [];
+        $wireNames = [];
+
+        foreach ($all as $api) {
+            $module = $api->declaringModule ?? '';
+
+            if ($api->mode === 'operation') {
+                $operationsByModule[$module][$api->version.':'.$api->operationId] = $api;
+            }
+        }
+
+        foreach ($declarations as $api) {
+            $module = $api->declaringModule ?? '';
+
+            ApiToolValidator::validate($api);
+
+            if ($api->toolKind === 'exposed') {
+                $operation = $api->operationRef === null ? null : ($operationsByModule[$module][$api->operationRef] ?? null);
+
+                if (! $operation instanceof Api) {
+                    throw new CompilationException('Unresolved operation reference for tool: '.$api->toolCode);
+                }
+
+                ApiToolValidator::validateExposedOperationReference($api, $operation, $module);
+            }
+
+            $tuple = $api->declaringModule.':'.$api->toolCode.':'.$api->toolVersion;
+
+            if (isset($toolTuples[$tuple])) {
+                throw new CompilationException('Duplicate tool tuple: '.$tuple);
+            }
+
+            $wire = ApiToolValidator::wireName($api);
+
+            if (isset($wireNames[$wire])) {
+                throw new CompilationException('Duplicate tool wire name: '.$wire);
+            }
+
+            $toolTuples[$tuple] = true;
+            $wireNames[$wire] = true;
+        }
+    }
+
+    public function normalize(ModuleManifest $manifest, Api $api, string $ownerVersion): array
+    {
+        $wire = ApiToolValidator::wireName($api);
+
+        return [
+            new NormalizedExtension(
+                point: 'api.tool',
+                id: $manifest->composerName.':'.$api->toolCode.':'.$api->toolVersion,
+                owner: $manifest->composerName,
+                ownerVersion: $ownerVersion,
+                payload: ['wire' => $wire],
+            ),
+            new NormalizedExtension(
+                point: 'api.tool',
+                id: 'wire:'.$wire,
+                owner: $manifest->composerName,
+                ownerVersion: $ownerVersion,
+                payload: ['tool' => $api->toolCode],
+            ),
+        ];
+    }
+}
