-def use_aliases(text: str) -> dict[str, str]:
-    aliases = {}
-    for item in re.findall(r"^use ([^;]+);", text, re.M):
-        item = item.strip()
-        if item.startswith(("function ", "const ")):
-            continue
-        if " as " in item:
-            fqcn, name = [part.strip() for part in item.rsplit(" as ", 1)]
-        else:
-            fqcn, name = item, item.split("\\")[-1]
-        aliases[name] = fqcn
-    return aliases
