 CoreX\\\\Config\\\\Data\\\\CoreOptions;\"},{\"line_number\":33,\"content\":\"        private readonly CoreOptions $options,\"},{\"line_number\":200,\"content\":\"    private function resolvedOptions(): CoreOptions\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/webhooks/tests/Feature/WebhookLoadContourIntegrationTest.php\",\"matches\":[{\"line_number\":99,\"content\":\"        $database = getenv('PGSQL_DATABASE') ?: '';\"},{\"line_number\":107,\"content\":\"            'host' => getenv('PGSQL_HOST') ?: '127.0.0.1',\"},{\"line_number\":108,\"content\":\"            'port' => getenv('PGSQL_PORT') ?: '5434',\"},{\"line_number\":110,\"content\":\"            'username' => getenv('PGSQL_USERNAME') ?: 'corex',\"},{\"line_number\":111,\"content\":\"            'password' => getenv('PGSQL_PASSWORD') ?: 'corex',\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/config/corex.php\",\"matches\":[{\"line_number\":172,\"content\":\"        'connection' => env('COREX_MODULES_CONNECTION'),\"},{\"line_number\":189,\"content\":\"            'store' => env('COREX_MODULES_CACHE_STORE'),\"},{\"line_number\":190,\"content\":\"            'ttl' => (int) env('COREX_MODULES_CACHE_TTL', 3600),\"},{\"line_number\":191,\"content\":\"            'prefix' => (string) env('COREX_MODULES_CACHE_PREFIX', 'corex.modules'),\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/webhooks/tests/Feature/WebhookFanoutTest.php\",\"matches\":[{\"line_number\":141,\"content\":\"        $database = getenv('PGSQL_DATABASE') ?: '';\"},{\"line_number\":149,\"content\":\"            'host' => getenv('PGSQL_HOST') ?: '127.0.0.1',\"},{\"line_number\":150,\"content\":\"            'port' => getenv('PGSQL_PORT') ?: '5434',\"},{\"line_number\":152,\"content\":\"            'username' => getenv('PGSQL_USERNAME') ?: 'corex',\"},{\"line_number\":153,\"content\":\"            'password' => getenv('PGSQL_PASSWORD') ?: 'corex',\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/CHANGELOG.md\",\"matches\":[{\"line_number\":5,\"content\":\"- Remove configurable identifier strategies and the twelve table-name options. Models generate UUIDv7 with Laravel HasUuids; migrations and queries use package-owned table literals. Remove IdStrategy, IdColumns, HasConfiguredId and the unused ResolvesCoreOptions schema bridge without aliases. Native Eloquent insert assigns IDs during quiet synchronous audit writes.\"},{\"line_number\":29,\"content\":\"- Runtime code outside the Laravel bridge takes `ConnectionResolverInterface`, `ClockInterface`, `Dispatcher` and the other `Illuminate\\\\Contracts` ports through constructors instead of facades, global helpers and static clocks; `Messaging\\\\Internal\\\\PubSubManager` is gone (the `PubSub` binding selects the driver from `CoreOptions::pubsubDriver`). Added the `CoreX\\\\Database\\\\Laravel\\\\ResolvesCoreOptions` SPI trait for migrations and models that read `CoreOptions` through the container bridge.\"},{\"line_number\":37,\"content\":\"- Removed the static `CoreX\\\\Config\\\\Internal\\\\Config` holder: `CoreOptions` is a lazy shared singleton read once at boot (`app(CoreOptions::class)` in migrations and tests; call `forgetInstance(CoreOptions::class)` after writing `corex` config in a booted test). Added `CoreOptions::$acknowledgedDangerousModes` (`corex.acknowledged_dangerous_modes`, exact config paths only), the `RuntimeConfigCheck` SPI and `RuntimeConfigGate`: checks run when the HTTP application finishes booting or a console command starts, except build commands. `corex:config:validate` runs them too, accepts `--production`, lists acknowledged dangerous modes as warnings and reports the `corex-operations.require_physical_tenancy=false` opt-out as a notice. `CoreOptionsParser::current()` is deprecated and returns the shared `CoreOptions`.\"},{\"line_number\":45,\"content\":\"- Breaking (PLAN3.P02–P04, pre-1.0): CoreX owns the kernel feature namespaces under one PSR-4 root; Api/Spi attributes, CoreOptions, ExtensionContribution and coded error descriptors declare the supported kernel and extension contracts. Runtime models and scanners no longer grant an implicit public contract.\"},{\"line_number\":61,\"content\":\"- Закрыта API/SPI-поверхность: скалярные контракты, JSON-документы и снимки CoreOptions; конкретные реализации принадлежат Internal.\"},{\"line_number\":178,\"content\":\"- `IdColumns` эмитят нативные PG-типы по сконфигурированной стратегии (P1.20).\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/tests/Feature/SynchronousAuditWriterTest.php\",\"matches\":[{\"line_number\":31,\"content\":\"    config(['corex.audit.enabled' => false, 'queue.default' => 'database']);\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/tests/Pg/InboxConcurrencyTest.php\",\"matches\":[{\"line_number\":8,\"content\":\"    config(['database.default' => 'pgsql']);\"},{\"line_number\":22,\"content\":\"    $connection = config('database.connections.pgsql');\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/tests/Pg/OutboxAppendPgTest.php\",\"matches\":[{\"line_number\":9,\"content\":\"    config(['database.default' => 'pgsql']);\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/tests/Pg/MessagingSchemaTest.php\",\"matches\":[{\"line_number\":10,\"content\":\"    config(['database.default' => 'pgsql']);\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/tests/Pg/DeliveryGuaranteesTest.php\",\"matches\":[{\"line_number\":96,\"content\":\"    config([\"},{\"line_number\":97,\"content\":\"        'database.connections.dg_relay_a' => array_merge(config('database.connections.pgsql'), ['name' => 'dg_relay_a']),\"},{\"line_number\":98,\"content\":\"        'database.connections.dg_relay_b' => array_merge(config('database.connections.pgsql'), ['name' => 'dg_relay_b']),\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/tests/Pg/OutboxRelayTest.php\",\"matches\":[{\"line_number\":21,\"content\":\"    config(['database.default' => 'pgsql']);\"},{\"line_number\":300,\"content\":\"    $connection = config('database.connections.pgsql');\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/src/Messaging/Internal/PrunePubSubMessages.php\",\"matches\":[{\"line_number\":7,\"content\":\"use CoreX\\\\Config\\\\Data\\\\CoreOptions;\"},{\"line_number\":37,\"content\":\"    public function handle(ClockInterface $clock, CoreOptions $options, ConnectionResolverInterface $connections): int\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/src/Config/Data/CoreOptions.php\",\"matches\":[{\"line_number\":21,\"content\":\"final readonly class CoreOptions\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/src/Config/Laravel/CoreOptionsParser.php\",\"matches\":[{\"line_number\":14,\"content\":\"use CoreX\\\\Config\\\\Data\\\\CoreOptions;\"},{\"line_number\":37,\"content\":\"final class CoreOptionsParser\"},{\"line_number\":39,\"content\":\"    /** @deprecated Resolve `CoreOptions` from the container; it is a shared lazy singleton. */\"},{\"line_number\":40,\"content\":\"    public static function current(): CoreOptions\"},{\"line_number\":42,\"content\":\"        return app(CoreOptions::class);\"},{\"line_number\":46,\"content\":\"    public static function fromArray(array $config): CoreOptions\"},{\"line_number\":98,\"content\":\"        return new CoreOptions(\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/src/Messaging/Internal/DatabasePollPubSub.php\",\"matches\":[{\"line_number\":8,\"content\":\"use CoreX\\\\Config\\\\Data\\\\CoreOptions;\"},{\"line_number\":47,\"content\":\"        private readonly CoreOptions $options,\"}]},{\"path\":\"/tmp/corex-p082-review-1/product/packages/core/src/Messaging/Internal/Commands/PruneOutboxMessages.php\",\"matches\":[{\"line_number\":7,\"content\":\"use CoreX\\\\Config\\\\Data\\\\CoreOptions;\"},{\"line_number\":34,\"content\":\"    public function handle(ClockInterface $clock, CoreOptions $opti