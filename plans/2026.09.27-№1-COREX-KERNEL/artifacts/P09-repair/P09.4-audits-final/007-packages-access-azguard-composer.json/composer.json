{
  "autoload": {
    "psr-4": {
      "CoreX\\AccessAzguard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoreX\\AccessAzguard\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "description": "Optional AzGuard integration for the CoreX Access permission matrix.",
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    },
    "corex": {
      "package-type": "integration",
      "schema-version": 1,
      "stability": "unreleased"
    },
    "laravel": {
      "providers": [
        "CoreX\\AccessAzguard\\AccessAzguardServiceProvider"
      ]
    }
  },
  "license": "MIT",
  "minimum-stability": "stable",
  "name": "axiomasoft/corex-access-azguard",
  "prefer-stable": true,
  "repositories": [
    {
      "package": {
        "autoload": {
          "psr-4": {
            "AzGuard\\": "packages/core/src/"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "AzGuard\\AzGuardServiceProvider"
            ]
          }
        },
        "name": "axioma-studio/azguard-core",
        "require": {
          "illuminate/console": "^11.0|^12.0|^13.0",
          "illuminate/contracts": "^11.0|^12.0|^13.0",
          "illuminate/database": "^11.0|^12.0|^13.0",
          "illuminate/filesystem": "^11.0|^12.0|^13.0",
          "illuminate/http": "^11.0|^12.0|^13.0",
          "illuminate/queue": "^11.0|^12.0|^13.0",
          "illuminate/routing": "^11.0|^12.0|^13.0",
          "illuminate/support": "^11.0|^12.0|^13.0",
          "php": "^8.3"
        },
        "source": {
          "reference": "253cbf4cce0226545cd96ca8c6bcbefe329b1403",
          "type": "git",
          "url": "https://github.com/axiomasoft/azguard-private.git"
        },
        "version": "0.3.0"
      },
      "type": "package"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/access-azguard/../core"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/access-azguard/../access"
    },
    {
      "options": {
        "symlink": false,
        "versions": {
          "axiomasoft/corex-infection-pest-adapter": "0.1.0"
        }
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/scripts/quality/infection-pest-adapter"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/*"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/products/*"
    },
    {
      "name": "azguard",
      "package": {
        "autoload": {
          "psr-4": {
            "AzGuard\\": "packages/core/src/"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "AzGuard\\AzGuardServiceProvider"
            ]
          }
        },
        "name": "axioma-studio/azguard-core",
        "require": {
          "illuminate/console": "^11.0|^12.0|^13.0",
          "illuminate/contracts": "^11.0|^12.0|^13.0",
          "illuminate/database": "^11.0|^12.0|^13.0",
          "illuminate/filesystem": "^11.0|^12.0|^13.0",
          "illuminate/http": "^11.0|^12.0|^13.0",
          "illuminate/queue": "^11.0|^12.0|^13.0",
          "illuminate/routing": "^11.0|^12.0|^13.0",
          "illuminate/support": "^11.0|^12.0|^13.0",
          "php": "^8.3"
        },
        "source": {
          "reference": "253cbf4cce0226545cd96ca8c6bcbefe329b1403",
          "type": "git",
          "url": "https://github.com/axiomasoft/azguard-private.git"
        },
        "version": "0.3.0"
      },
      "type": "package"
    }
  ],
  "require": {
    "axioma-studio/azguard-core": "^0.3",
    "axiomasoft/corex": "^1.0@dev",
    "axiomasoft/corex-access": "^1.0@dev",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "php": "^8.4",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.32",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^11.3",
    "orchestra/testbench-core": "^11.5",
    "pestphp/pest": "^5.2",
    "symfony/process": "^7.2|^8.0"
  },
  "scripts": {
    "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/access-azguard/phpstan.neon --memory-limit=2G --no-progress",
    "lint:check": "../../vendor/bin/pint --test",
    "test": "../../vendor/bin/pest --test-directory=packages/access-azguard/tests --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --exclude-group=pg",
    "test:pg": "../../vendor/bin/pest --test-directory=packages/access-azguard/tests --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php --group=pg"
  },
  "type": "library"
}
