{
  "autoload": {
    "psr-4": {
      "CoreX\\Tooling\\Infection\\": "src/"
    }
  },
  "bin": [
    "bin/corex-pest"
  ],
  "description": "Bounded Pest CLI adapter for the pinned Infection compatibility spike.",
  "extra": {
    "infection": {
      "class": "CoreX\\Tooling\\Infection\\PestAdapter"
    }
  },
  "license": "MIT",
  "name": "axiomasoft/corex-infection-pest-adapter",
  "repositories": [
    {
      "options": {
        "symlink": false,
        "versions": {
          "axiomasoft/corex-infection-pest-adapter": "0.1.0"
        }
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/scripts/quality/infection-pest-adapter"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/*"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/products/*"
    },
    {
      "name": "azguard",
      "package": {
        "autoload": {
          "psr-4": {
            "AzGuard\\": "packages/core/src/"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "AzGuard\\AzGuardServiceProvider"
            ]
          }
        },
        "name": "axioma-studio/azguard-core",
        "require": {
          "illuminate/console": "^11.0|^12.0|^13.0",
          "illuminate/contracts": "^11.0|^12.0|^13.0",
          "illuminate/database": "^11.0|^12.0|^13.0",
          "illuminate/filesystem": "^11.0|^12.0|^13.0",
          "illuminate/http": "^11.0|^12.0|^13.0",
          "illuminate/queue": "^11.0|^12.0|^13.0",
          "illuminate/routing": "^11.0|^12.0|^13.0",
          "illuminate/support": "^11.0|^12.0|^13.0",
          "php": "^8.3"
        },
        "source": {
          "reference": "253cbf4cce0226545cd96ca8c6bcbefe329b1403",
          "type": "git",
          "url": "https://github.com/axiomasoft/azguard-private.git"
        },
        "version": "0.3.0"
      },
      "type": "package"
    }
  ],
  "require": {
    "infection/abstract-testframework-adapter": "0.5.1",
    "infection/include-interceptor": "^1.0",
    "pestphp/pest": "^5.2.1",
    "php": "^8.4",
    "phpunit/phpunit": "^13.3.4"
  },
  "type": "infection-extension"
}
