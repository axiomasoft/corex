les to the latest Rector, PHPStan, and PHPParser versions\r\n- Simplifies composer scripts\r\n- Adds the `MigrateToSimplifiedAttributeRector` rule to the Laravel 9 set\r\n- Removes the `pint.json` configuration, to keep it in line with the default config from Pint\r\n- Adds a new `RectorLaravel\\AbstractRector` class that replaces the core `AbstractRector` and implements the `DocumentedRuleInterface`. We still need the [removed interface](https://github.com/rectorphp/rector-src/pull/6477) because we generate docs from it. ","labels":[],"milestone":null,"active_lock_reason":null,"created_at":"2024-12-11T19:17:38Z","updated_at":"2024-12-12T14:00:07Z","closed_at":"2024-12-12T14:00:04Z","merged_at":"2024-12-12T14:00:04Z","merge_commit_sha":"44674a8099664fa09e2b00afddb88b72a71fbd31","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"driftingly:2.x","ref":"2.x","repo":{"id":349255032,"node_id":"MDEwOlJlcG9zaXRvcnkzNDkyNTUwMzI=","name":"rector-laravel","full_name":"driftingly/rector-laravel","owner":{"login":"driftingly","id":194221,"node_id":"MDQ6VXNlcjE5NDIyMQ==","avatar_url":"https://avatars.githubusercontent.com/u/194221?v=4","gravatar_id":"","url":"https://api.github.com/users/driftingly","html_url":"https://github.com/driftingly","followers_url":"https://api.github.com/users/driftingly/followers","following_url":"https://api.github.com/users/driftingly/following{/other_user}","gists_url":"https://api.github.com/users/driftingly/gists{/gist_id}","starred_url":"https://api.github.com/users/driftingly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/driftingly/subscriptions","organizations_url":"https://api.github.com/users/driftingly/orgs","repos_url":"https://api.github.com/users/driftingly/repos","events_url":"https://api.github.com/users/driftingly/events{/privacy}","received_events_url":"https://api.github.com/users/driftingly/received_events","type":"User","user_view_type":"public","site_admin":fa