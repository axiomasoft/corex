<?php

declare(strict_types=1);

namespace CoreX\Tenancy\Membership\Internal\Transport;

use CoreX\Tenancy\Central\CentralProtocolViolation;
use DateTimeImmutable;

/** @internal Durable central result, not positive membership authority. */
final readonly class RevokeMembershipReceipt
{
    public function __construct(public string $profileVersion, public string $requestId, public string $identityId, public string $accountId, public string $product, public string $commitRef, public string $revision, public string $revokeGeneration, public DateTimeImmutable $committedAt)
    {
        Value::profile($profileVersion);
        Value::uuid($requestId);
        Value::uuid($identityId);
        Value::uuid($accountId);
        Value::product($product);
        Value::counter($revision);
        Value::counter($revokeGeneration);

        if (preg_match('/^[a-zA-Z0-9._:-]{1,128}$/D', $commitRef) !== 1) {
            throw new CentralProtocolViolation('Invalid opaque commit reference.');
        }
    }

    /** @param array<string, mixed> $p */
    public static function fromPayload(array $p): self
    {
        Value::fields($p, ['profile_version', 'request_id', 'identity_id', 'account_id', 'product', 'commit_ref', 'revision', 'revoke_generation', 'committed_at']);

        return new self(profileVersion: Value::string($p, 'profile_version'), requestId: Value::string($p, 'request_id'), identityId: Value::string($p, 'identity_id'), accountId: Value::string($p, 'account_id'), product: Value::string($p, 'product'), commitRef: Value::string($p, 'commit_ref'), revision: Value::string($p, 'revision'), revokeGeneration: Value::string($p, 'revoke_generation'), committedAt: Value::utc(Value::string($p, 'committed_at')));
    }
}
