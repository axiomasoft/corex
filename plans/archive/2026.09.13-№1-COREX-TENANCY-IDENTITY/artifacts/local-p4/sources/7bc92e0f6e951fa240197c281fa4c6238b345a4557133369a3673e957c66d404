it('sends UUID-only revoke data with configured audience and product bindings', function (): void {
    Http::fake(['https://central.example.test/api/memberships/revoke' => Http::response(status: 204)]);

    $request = new RevokeMembershipRequest(
        requestId: (string) Str::uuid(),
        identityId: (string) Str::uuid(),
        accountId: (string) Str::uuid(),
        reason: MembershipReason::Suspended,
        actingIdentityId: (string) Str::uuid(),
    );

    centralClientTest()->revokeMembership($request);

    Http::assertSent(function (Request $sent) use ($request): bool {
        $data = $sent->data();

        return $sent->hasHeader('Authorization', 'Bearer test-token')
            && $sent->hasHeader('X-CoreX-Audience', 'tenant-api')
            && $sent->hasHeader('X-CoreX-Product', 'corex-test')
            && $data['identity_id'] === $request->identityId
            && $data['account_id'] === $request->accountId
            && ! array_key_exists('email', $data)
            && ! array_key_exists('phone', $data);
    });
});

