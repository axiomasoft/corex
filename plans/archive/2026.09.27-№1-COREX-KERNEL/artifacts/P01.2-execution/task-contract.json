    "non_goals": [
      "изменение `api/v1` и `scripts/check-api-contract.php`",
      "`manual`-правила переименований (добавляет P02/P03)",
      "CI-job (P01.4)",
      "ownership/PHPStan-гейты (P01.3)."
    ]
  },
