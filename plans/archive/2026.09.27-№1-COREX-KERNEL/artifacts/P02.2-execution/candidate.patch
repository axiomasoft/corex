+        foreach ($declared as $provider) {
+            if (! is_string($provider) || ! is_subclass_of($provider, ServiceProvider::class)) {
+                throw new RuntimeException('Package provider must extend ServiceProvider.');
+            }
+
+            $providers[] = $provider;
