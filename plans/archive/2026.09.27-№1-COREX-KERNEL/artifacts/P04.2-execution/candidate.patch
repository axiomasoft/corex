+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Features\Data;
+
+use CoreX\Attributes\Api;
+use CoreX\Data\Data\JsonDocument;
+use CoreX\Data\Laravel\JsonDocuments;
+
+/**
+ * ModuleManifest-declared feature-flag default. `FeatureFlags::define()` is
+ * idempotent — registering the same key again never overwrites an
+ * admin-toggled `is_enabled` (mirrors `SettingDefaultsProvider`'s
+ * register-once semantics).
+ */
+#[Api(since: '1.0')]
+final readonly class FeatureFlagDefinition
+{
+    /** Immutable JSON value. */
+    public function __construct(public string $key, public bool $default = false, public ?string $module = null, public ?JsonDocument $payload = null) {}
+
+    public static function make(string $key, bool $default = false): self
+    {
+        return new self($key, $default);
+    }
+
+    public function module(string $module): self
+    {
+        return new self(
+            key: $this->key,
+            default: $this->default,
+            module: $module,
+            payload: JsonDocuments::nullable($this->payload),
+        );
+    }
+
+    /** Immutable JSON value. */
+    public function payload(JsonDocument $payload): self
+    {
+        return new self(
+            key: $this->key,
+            default: $this->default,
+            module: $this->module,
+            payload: JsonDocuments::nullable($payload),
+        );
+    }
+}
diff --git a/packages/core/src/Features/Internal/DatabaseFeatureFlags.php b/packages/core/src/Features/Internal/DatabaseFeatureFlags.php
new file mode 100644
index 00000000..8272cb7c
--- /dev/null
+++ b/packages/core/src/Features/Internal/DatabaseFeatureFlags.php
@@ -0,0 +1,123 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Features\Internal;
+
+use CoreX\Data\Data\JsonDocument;
+use CoreX\Data\Laravel\JsonDocuments;
+use CoreX\Features\Contracts\FeatureFlags;
+use CoreX\Features\Data\FeatureFlagDefinition;
+use CoreX\Features\Internal\Models\FeatureFlag;
+use CoreX\Features\Internal\Models\FeatureOverride;
+use CoreX\Settings\Data\SettingsScope;
+use CoreX\Settings\Enums\SettingScope;
+use Override;
+
+/**
+ * Persisted feature flags on `sys_feature_flags`/`sys_feature_overrides`.
+ * Replaces the interim config-driven `FeatureResolver`/
+ * `ConfigFeatureResolver` — a single source of truth, no config-fallback
+ * lane.
+ *
+ * Cascade order — DETERMINISTIC, declared here once:
+ * `SettingScope::User`/`Department` (whichever the caller passes) beats
+ * `Workspace` beats the flag's own account-level `is_enabled`/`payload`.
+ * A single call resolves exactly the ONE override row matching the passed
+ * `$scope` (exact `scope_type`+`scope_id`) — there is no auto-walk from a
+ * narrower id to a broader one the caller didn't name (e.g. from a user id
+ * to "that user's workspace"); a caller that needs several levels checked
+ * calls `active()`/`value()` once per level it can resolve, narrowest first.
+ *
+ * `$connection` mirrors `DatabaseSettingsRepository`'s seam (null = app
+ * default), used by the PG-only test lane.
+ *
+ * @internal spec: B-10 §3.1, AC-22, D27, D38, D12
+ */
+final class DatabaseFeatureFlags implements FeatureFlags
+{
+    public function __construct(
+        private readonly ?string $connection = null,
+    ) {}
+
+    #[Override]
+    public function active(string $key, ?SettingsScope $scope = null): bool
+    {
+        $flag = $this->find($key);
+
+        if (! $flag instanceof FeatureFlag) {
+            return false;
+        }
+
+        $override = $this->findOverride($flag->id, $scope);
+
+        return $override instanceof FeatureOverride ? $override->is_enabled : $flag->is_enabled;
+    }
+
+    #[Override]
+    public function value(string $key, ?SettingsScope $scope = null): JsonDocument
+    {
+        $flag = $this->find($key);
+
+        if (! $flag instanceof FeatureFlag) {
+            return JsonDocuments::capture(null);
+        }
+
+        $override = $this->findOverride($flag->id, $scope);
+
+        // A NULL override payload means "this override only toggles
+        // is_enabled" — it must fall back to the flag's own payload, not
+        // blank it out from under every other scope (A87).
+        if ($override instanceof FeatureOverride && $override->payload !== null) {
+            return JsonDocuments::capture($override->payload);
+        }
+
+        return JsonDocuments::capture($flag->payload);
+    }
+
+    #[Override]
+    public function define(FeatureFlagDefinition $def): void
+    {
+        // Atomic via the DB's UNIQUE(key) constraint (sys_feature_flags), not
+        // a read-then-create — createOrFirst() isolates a losing INSERT in a
+        // savepoint when called inside a surrounding transaction. Idempotent:
+        // never stomps an admin-toggled `is_enabled`.
+        FeatureFlag::on($this->connection)->createOrFirst(
+            attributes: ['key' => $def->key],
+            values: [
+                'key' => $def->key,
+                'module' => $def->module,
+                'is_enabled' => $def->default,
+                'payload' => JsonDocuments::optionalArray($def->payload),
+            ],
+        );
+    }
+
+    private function find(string $key): ?FeatureFlag
+    {
+        /** @var FeatureFlag|null */
+        return FeatureFlag::on($this->connection)->where('key', $key)->first();
+    }
+
+    /**
+     * `null`/account scope has no override row — the flag's own `is_enabled`
+     * IS the account-level value. Department scope is reachable here —
+     * `sys_feature_overrides.scope_type` CHECK allows it and `SettingsScope`
+     * now has a `department()` factory.
+     *
+     * @internal spec: D38
+     */
+    private function findOverride(string $flagId, ?SettingsScope $scope): ?FeatureOverride
+    {
+        if ($scope === null || $scope->type === SettingScope::Account) {
+            return null;
+        }
+
+        /** @var FeatureOverride|null */
+        return FeatureOverride::on($this->connection)
+            ->where('flag_id', $flagId)
+            ->where('scope_type', $scope->type->value)
+            ->where('scope_id', $scope->id)
+            ->first();
+    }
+}
diff --git a/packages/core/src/Messaging/Internal/DurablePayloadTypeChecker.php b/packages/core/src/Messaging/Internal/DurablePayloadTypeChecker.php
new file mode 100644
index 00000000..46c702d1
--- /dev/null
+++ b/packages/core/src/Messaging/Internal/DurablePayloadTypeChecker.php
@@ -0,0 +1,80 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Messaging\Internal;
+
+use CoreX\Messaging\Contracts\DurablePayload;
+use CoreX\Messaging\PHPStan\Rules\DurablePayloadRule;
+use PHPStan\Reflection\ClassReflection;
+use PHPStan\Rules\IdentifierRuleError;
+use PHPStan\Rules\RuleErrorBuilder;
+use PHPStan\Type\MixedType;
+use PHPStan\Type\ObjectType;
+use PHPStan\Type\Type;
+use PHPStan\Type\TypeTraverser;
+
+final class DurablePayloadTypeChecker
+{
+    /**
+     * @var list<class-string>
+     */
+    private const FORBIDDEN = ['Illuminate\Database\Eloquent\Model', 'Closure', 'Illuminate\Container\Container', 'Illuminate\Contracts\Container\Container', 'Psr\Container\ContainerInterface', 'Illuminate\Http\Request', 'Symfony\Component\HttpFoundation\Request', 'CoreX\Tenancy\Contracts\TenantContext'];
+
+    public static function implementsMarker(ClassReflection $classReflection): bool
+    {
+        return $classReflection->implementsInterface(DurablePayload::class);
+    }
+
+    public static function forbiddenInType(Type $type): ?string
+    {
+        $matched = null;
+        TypeTraverser::map($type, function (Type $inner, callable $traverse) use (&$matched) {
+            if ($matched !== null) {
+                return $inner;
+            }
+
+            if ($inner instanceof ObjectType) {
+                $matched = self::matchClassName($inner->getClassName());
+            }
+
+            return $traverse($inner);
+        });
+
+        return $matched;
+    }
+
+    /**
+     * @return list<IdentifierRuleError>
+     */
+    public static function untypedArrayErrors(Type $type, string $propertyName, int $line): array
+    {
+        $errors = [];
+        foreach ($type->getArrays() as $arrayType) {
+            $valueType = $arrayType->getIterableValueType();
+
+            if (! $valueType instanceof MixedType) {
+                continue;
+            }
+            $errors[] = RuleErrorBuilder::message(sprintf('Durable payload property $%s declares an array with %s; specify the element type.', $propertyName, $valueType->isExplicitMixed() ? 'an explicit mixed value type' : 'a missing value type'))->identifier(DurablePayloadRule::UNTYPED_ARRAY_IDENTIFIER)->line($line)->build();
+        }
+
+        return $errors;
+    }
+
+    public static function buildError(string $className, string $propertyName, string $forbidden, int $line): IdentifierRuleError
+    {
+        return RuleErrorBuilder::message(sprintf('Durable payload %s::$%s must not contain %s', $className, $propertyName, $forbidden))->identifier(DurablePayloadRule::IDENTIFIER)->line($line)->build();
+    }
+
+    private static function matchClassName(string $className): ?string
+    {
+        foreach (self::FORBIDDEN as $forbidden) {
+            if (is_a($className, $forbidden, true)) {
+                return $forbidden;
+            }
+        }
+
+        return null;
+    }
+}
