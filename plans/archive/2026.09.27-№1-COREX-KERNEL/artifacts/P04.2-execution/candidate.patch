diff --git a/packages/access/src/Access/Laravel/PrincipalIdentity.php b/packages/access/src/Access/Laravel/PrincipalIdentity.php
new file mode 100644
index 00000000..f0ae26a4
--- /dev/null
+++ b/packages/access/src/Access/Laravel/PrincipalIdentity.php
@@ -0,0 +1,108 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Access\Access\Laravel;
+
+use AzGuard\Concerns\HasPermissions as HasPermissionsConcern;
+use AzGuard\Contracts\HasPermissions as HasPermissionsContract;
+use CoreX\Access\Contracts\Principal;
+use CoreX\Access\Enums\PrincipalType;
+use CoreX\Attributes\Spi;
+use CoreX\Attributes\SpiKind;
+use Illuminate\Contracts\Auth\Authenticatable;
+use Override;
+
+/**
+ * Principal carrier for the AzGuard resolution chain (D101) — a user, agent
+ * (B-13) or api_key, none of which need a `users` row (AC-25): the morph
+ * class is the principal type itself, the auth identifier its uuid. Wires
+ * AzGuard's own HasPermissions concern so DefaultAccessChecker::allowed()
+ * asks the REAL public AzGuard path (premortem C1's round-trip), not a
+ * private lookup.
+ *
+ * @corex-model-extension AzGuard HasPermissions grant resolution exposes its Permission collection.
+ */
+#[Spi(kind: SpiKind::Call, since: '1.0')]
+final class PrincipalIdentity implements Authenticatable, HasPermissionsContract, Principal
+{
+    use HasPermissionsConcern;
+
+    public function __construct(
+        private readonly PrincipalType $type,
+        private readonly string $id,
+        private readonly ?string $passwordHash = null,
+    ) {}
+
+    public static function fromPrincipal(Principal $principal): self
+    {
+        return new self($principal->principalType(), $principal->principalId());
+    }
+
+    #[Override]
+    public function principalType(): PrincipalType
+    {
+        return $this->type;
+    }
+
+    #[Override]
+    public function principalId(): string
+    {
+        return $this->id;
+    }
+
+    /** AzGuard's grant sources (e.g. DatabaseRoleGrantSource) key on this — a plain string, not a class-string, for these non-Eloquent principals. */
+    public function getMorphClass(): string
+    {
+        return $this->type->value;
+    }
+
+    #[Override]
+    public function getAuthIdentifierName(): string
+    {
+        return 'id';
+    }
+
+    #[Override]
+    public function getAuthIdentifier(): string
+    {
+        return $this->id;
+    }
+
+    #[Override]
+    public function getAuthPasswordName(): string
+    {
+        return 'password';
+    }
+
+    /**
+     * `null` for the `agent`/`api_key` lanes (no password) and for the OIDC
+     * lane (never constructed with a hash — `Auth::loginUsingId()` skips
+     * credential validation entirely); the local login lane
+     * ({@see CoreX\Access\Identity\Laravel\PrincipalUserProvider}) is the only constructor of a
+     * `PrincipalIdentity` that passes one.
+     */
+    #[Override]
+    public function getAuthPassword(): ?string
+    {
+        return $this->passwordHash;
+    }
+
+    #[Override]
+    public function getRememberToken(): ?string
+    {
+        return null;
+    }
+
+    #[Override]
+    public function setRememberToken(mixed $value): void
+    {
+        // No remember-me session for a non-interactive principal.
+    }
+
+    #[Override]
+    public function getRememberTokenName(): string
+    {
+        return '';
+    }
+}
diff --git a/packages/access/src/Identity/Laravel/PrincipalUserProvider.php b/packages/access/src/Identity/Laravel/PrincipalUserProvider.php
new file mode 100644
index 00000000..bd4210d5
--- /dev/null
+++ b/packages/access/src/Identity/Laravel/PrincipalUserProvider.php
@@ -0,0 +1,175 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Access\Identity\Laravel;
+
+use CoreX\Access\Access\Laravel\PrincipalIdentity;
+use CoreX\Access\Enums\PrincipalType;
+use CoreX\Access\Laravel\AuthOptions;
+use CoreX\Attributes\Spi;
+use CoreX\Attributes\SpiKind;
+use CoreX\Context\Contracts\IdentityPasswordRehasher;
+use Illuminate\Contracts\Auth\Authenticatable;
+use Illuminate\Contracts\Auth\UserProvider;
+use Illuminate\Database\Query\Builder;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Hash;
+use Override;
+use SensitiveParameter;
+
+/**
+ * The boxed-and-cloud login lane's own {@see UserProvider} (D125, OQ-18
+ * variant A): reads a users-shaped table through query-builder, entirely by
+ * {@see AuthOptions} identity fields — connection/table/column names — so
+ * `axiomasoft/corex-access` never imports a model from `axiomasoft/corex-tenancy` (AC-28). Every
+ * lookup goes through {@see query()}, which always applies the "live user"
+ * filter (active = true AND deleted_at IS NULL): without it in
+ * retrieveById() too, a session survives the very deactivation meant to end
+ * it.
+ *
+ * `retrieveByToken()`/`updateRememberToken()` are permanent no-ops: the
+ * frozen `users` DDL (P2.7, D125) carries no `remember_token` column and one
+ * is not being added — "remember me" is simply unsupported by this
+ * provider.
+ */
+#[Spi(kind: SpiKind::Call, since: '1.0')]
+final class PrincipalUserProvider implements UserProvider
+{
+    public function __construct(
+        private readonly AuthOptions $options,
+    ) {}
+
+    #[Override]
+    public function retrieveById($identifier): ?Authenticatable
+    {
+        $row = $this->query()->where($this->idColumn(), $identifier)->first();
+
+        return $this->toPrincipal($row);
+    }
+
+    /**
+     * No `remember_token` column exists on the configured table (frozen
+     * DB_SCHEMA) — remember-me sessions are not supported.
+     */
+    #[Override]
+    public function retrieveByToken($identifier, #[SensitiveParameter] mixed $token): ?Authenticatable
+    {
+        return null;
+    }
+
+    /** No-op — see {@see retrieveByToken()}. */
+    #[Override]
+    public function updateRememberToken(Authenticatable $user, #[SensitiveParameter] mixed $token): void
+    {
+        // Intentionally empty: no remember_token column to persist into.
+    }
+
+    /** @param  array<string, mixed>  $credentials */
+    #[Override]
+    public function retrieveByCredentials(#[SensitiveParameter] array $credentials): ?Authenticatable
+    {
+        $email = $credentials['email'] ?? null;
+
+        if (! is_string($email) || $email === '') {
+            return null;
+        }
+
+        // The `password` key is never used to build the WHERE (Laravel canon,
+        // validated separately by validateCredentials()); the unique index on
+        // this schema is `lower(email)`, so the match is case-insensitive.
+        $row = $this->query()
+            ->whereRaw('lower('.$this->emailColumn().') = ?', [mb_strtolower($email)])
+            ->first();
+
+        return $this->toPrincipal($row);
+    }
+
+    /** @param  array<string, mixed>  $credentials */
+    #[Override]
+    public function validateCredentials(Authenticatable $user, #[SensitiveParameter] array $credentials): bool
+    {
+        $password = $credentials['password'] ?? null;
+        $hash = $user instanceof PrincipalIdentity ? $user->getAuthPassword() : null;
+
+        if (! is_string($password) || $password === '' || ! is_string($hash) || $hash === '') {
+            return false;
+        }
+
+        return Hash::check($password, $hash);
+    }
+
+    /** @param  array<string, mixed>  $credentials */
+    #[Override]
+    public function rehashPasswordIfRequired(Authenticatable $user, #[SensitiveParameter] array $credentials, bool $force = false): void
+    {
+        $password = $credentials['password'] ?? null;
+        $hash = $user instanceof PrincipalIdentity ? $user->getAuthPassword() : null;
+
+        if (! is_string($password) || $password === '' || ! is_string($hash) || $hash === '') {
+            return;
+        }
+
+        if (! Hash::needsRehash($hash) && ! $force) {
+            return;
+        }
+
+        app(IdentityPasswordRehasher::class)->rehash(
+            identityId: (string) $user->getAuthIdentifier(),
+            expectedHash: $hash,
+            replacementHash: Hash::make($password),
+            table: $this->options->identityTable,
+            columns: $this->options->identityColumns,
+            connection: $this->options->identityConnection,
+        );
+    }
+
+    /** "Live user" filter shared by every lookup — see class docblock. */
+    private function query(): Builder
+    {
+        return DB::connection($this->options->identityConnection)
+            ->table($this->options->identityTable)
+            ->where($this->activeColumn(), true)
+            ->whereNull($this->deletedAtColumn());
+    }
+
+    private function toPrincipal(?object $row): ?PrincipalIdentity
+    {
+        if ($row === null) {
+            return null;
+        }
+
+        $hash = $row->{$this->passwordColumn()} ?? null;
+
+        return new PrincipalIdentity(
+            type: PrincipalType::User,
+            id: (string) $row->{$this->idColumn()},
+            passwordHash: is_string($hash) ? $hash : null,
+        );
+    }
+
+    private function idColumn(): string
+    {
+        return $this->options->identityColumns['id'];
+    }
+
+    private function emailColumn(): string
+    {
+        return $this->options->identityColumns['email'];
+    }
+
+    private function passwordColumn(): string
+    {
+        return $this->options->identityColumns['password'];
+    }
+
+    private function activeColumn(): string
+    {
+        return $this->options->identityColumns['active'];
+    }
+
+    private function deletedAtColumn(): string
+    {
+        return $this->options->identityColumns['deleted_at'];
+    }
+}
diff --git a/packages/access/src/Laravel/AuthOptions.php b/packages/access/src/Laravel/AuthOptions.php
new file mode 100644
index 00000000..cc3992da
--- /dev/null
+++ b/packages/access/src/Laravel/AuthOptions.php
@@ -0,0 +1,138 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CoreX\Access\Laravel;
+
+use CoreX\Attributes\Spi;
+use CoreX\Attributes\SpiKind;
+use CoreX\Config\Laravel\ConfigurationValidator;
+
+#[Spi(kind: SpiKind::Call, since: '1.0')]
+final readonly class AuthOptions
+{
+    /**
+     * @param  array<string, string>  $identityColumns
+     * @param  array<string, mixed>  $azguardPins
+     */
+    public function __construct(
+        public string $panel,
+        public ?string $cacheStore,
+        public bool $bindPermissionLayer,
+        public ?string $workspaceScopeClass,
+        public bool $identityEnabled,
+        public ?string $identityConnection,
+        public string $identityTable,
+        public array $identityColumns,
+        public array $azguardPins,
+    ) {}
+
+    /** @param  array<string, mixed>  $config */
+    public static function fromArray(array $config): self
+    {
+        $violations = new ConfigurationValidator;
+
+        $panel = self::nonEmpty($violations, 'panel', $config['panel'] ?? 'app');
+
+        $cache = is_array($config['cache'] ?? null) ? $config['cache'] : [];
+        $cacheStore = self::nullableString($cache['store'] ?? null);
+
+        $bindPermissionLayer = self::bool($violations, 'bind_permission_layer', $config['bind_permission_layer'] ?? true);
+
+        $workspaceScopeClass = self::nullableString($config['workspace_scope_class'] ?? null);
+
+        if ($workspaceScopeClass === '') {
+            $workspaceScopeClass = null;
+        }
+
+        $identity = is_array($config['identity'] ?? null) ? $config['identity'] : [];
+        $identityEnabled = self::bool($violations, 'identity.enabled', $identity['enabled'] ?? true);
+        $identityConnection = self::nullableString($identity['connection'] ?? null);
+        $identityTable = self::nonEmpty($violations, 'identity.table', $identity['table'] ?? 'users');
+
+        $defaults = [
+            'id' => 'id',
+            'email' => 'email',
+            'password' => 'password_hash',
+            'active' => 'is_active',
+            'deleted_at' => 'deleted_at',
+        ];
+        $rawColumns = is_array($identity['columns'] ?? null) ? $identity['columns'] : null;
+        $identityColumns = [];
+
+        if ($rawColumns === null) {
+            $identityColumns = $defaults;
+        } else {
+            foreach ($defaults as $key => $default) {
+                if (! array_key_exists($key, $rawColumns)) {
+                    $violations->add('identity.columns.'.$key, 'must be a non-empty string');
+                    $identityColumns[$key] = $default;
+
+                    continue;
+                }
+
+                $value = $rawColumns[$key];
+
+                if (is_string($value) && $value !== '') {
+                    $identityColumns[$key] = $value;
+
+                    continue;
+                }
+
+                $violations->add('identity.columns.'.$key, 'must be a non-empty string');
+                $identityColumns[$key] = $default;
+            }
+        }
+
+        $azguardPins = is_array($config['azguard_pins'] ?? null) ? $config['azguard_pins'] : [];
+
+        $violations->failIfAny();
+
+        return new self(
+            panel: $panel,
+            cacheStore: $cacheStore,
+            bindPermissionLayer: $bindPermissionLayer,
+            workspaceScopeClass: $workspaceScopeClass,
+            identityEnabled: $identityEnabled,
+            identityConnection: $identityConnection,
+            identityTable: $identityTable,
+            identityColumns: $identityColumns,
+            azguardPins: $azguardPins,
+        );
+    }
+
+    private static function bool(ConfigurationValidator $violations, string $path, mixed $value): bool
+    {
+        if (is_bool($value)) {
+            return $value;
+        }
+
+        $violations->add($path, 'must be a boolean');
+
+        return false;
+    }
+
+    private static function nonEmpty(ConfigurationValidator $violations, string $path, mixed $value): string
+    {
+        if (is_string($value) && $value !== '') {
+            return $value;
+        }
+
+        $violations->add($path, 'must be a non-empty string');
+
+        return 'invalid';
+    }
+
+    private static function nullableString(mixed $value): ?string
+    {
+        if ($value === null) {
+            return null;
+        }
+
+        if (is_string($value)) {
+            return $value;
+        }
+
+        return null;
+    }
+}
diff --git a/packages/access/src/Laravel/ScopeResolver.php b/packages/access/src/Laravel/ScopeResolver.php
