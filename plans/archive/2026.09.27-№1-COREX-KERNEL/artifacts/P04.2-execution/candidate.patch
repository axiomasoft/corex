-                new NormalizedExtension(
-                    point: 'entity_field',
-                    id: $extender->entityHandle.'.'.$extender->fieldHandle,
-                    owner: $manifest->composerName,
-                    ownerVersion: $ownerVersion,
-                    payload: CompiledRegistry::extenderToArray($extender),
