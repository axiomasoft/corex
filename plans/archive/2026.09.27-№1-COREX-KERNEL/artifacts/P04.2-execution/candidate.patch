-        self::skipWhitespace($json, $index);
-
-        if ($index !== strlen($json)) {
-            throw new InvalidArgumentException('Trailing JSON content rejected.');
-        }
-    }
-
-    private static function parseValue(string $json, int &$index): void
-    {
-        self::skipWhitespace($json, $index);
-        $char = $json[$index] ?? '';
