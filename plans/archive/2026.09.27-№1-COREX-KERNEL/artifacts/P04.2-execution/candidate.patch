-        if ($json === '{}') {
-            return [];
-        }
-
-        $decoded = self::decode($json);
-
-        if ($decoded === null || ! is_array($decoded) || array_is_list($decoded)) {
-            return null;
-        }
-
-        return $decoded;
-    }
-
-    public static function encode(mixed $value): string
