{
  "authors": [
    {
      "email": "dv.vostrikov@gmail.com",
      "name": "Dmitry Vostrikov"
    }
  ],
  "autoload": {
    "psr-4": {
      "CoreX\\Tasks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoreX\\Tasks\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "description": "CoreX Tasks module — workspace projects, stages and tasks for DB-per-account applications.",
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    },
    "corex": {
      "module": "CoreX\\Tasks\\TasksModule",
      "package-type": "capability",
      "schema-version": 1,
      "stability": "stable"
    },
    "laravel": {
      "providers": [
        "CoreX\\Tasks\\TasksServiceProvider"
      ]
    }
  },
  "keywords": [
    "laravel",
    "tasks",
    "kanban",
    "projects",
    "multi-tenancy"
  ],
  "license": "MIT",
  "minimum-stability": "stable",
  "name": "axiomasoft/corex-tasks",
  "prefer-stable": true,
  "repositories": [
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/tasks/../core"
    },
    {
      "options": {
        "symlink": false,
        "versions": {
          "axiomasoft/corex-infection-pest-adapter": "0.1.0"
        }
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/scripts/quality/infection-pest-adapter"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/*"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/products/*"
    },
    {
      "name": "azguard",
      "package": {
        "autoload": {
          "psr-4": {
            "AzGuard\\": "packages/core/src/"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "AzGuard\\AzGuardServiceProvider"
            ]
          }
        },
        "name": "axioma-studio/azguard-core",
        "require": {
          "illuminate/console": "^11.0|^12.0|^13.0",
          "illuminate/contracts": "^11.0|^12.0|^13.0",
          "illuminate/database": "^11.0|^12.0|^13.0",
          "illuminate/filesystem": "^11.0|^12.0|^13.0",
          "illuminate/http": "^11.0|^12.0|^13.0",
          "illuminate/queue": "^11.0|^12.0|^13.0",
          "illuminate/routing": "^11.0|^12.0|^13.0",
          "illuminate/support": "^11.0|^12.0|^13.0",
          "php": "^8.3"
        },
        "source": {
          "reference": "253cbf4cce0226545cd96ca8c6bcbefe329b1403",
          "type": "git",
          "url": "https://github.com/axiomasoft/azguard-private.git"
        },
        "version": "0.3.0"
      },
      "type": "package"
    }
  ],
  "require": {
    "axiomasoft/corex": "^1.0@dev",
    "ext-mbstring": "*",
    "laravel/framework": "^13.0",
    "php": "^8.4",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.32",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^11.3",
    "orchestra/testbench-core": "^11.5",
    "pestphp/pest": "^5.2"
  },
  "scripts": {
    "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/tasks/phpstan.neon --memory-limit=2G --no-progress",
    "lint": "pint",
    "lint:check": "pint --test",
    "test": "pest --exclude-group=pg",
    "test:coverage": "pest --coverage --min=92",
    "test:pg": "pest --group=pg"
  },
  "type": "corex-module"
}
