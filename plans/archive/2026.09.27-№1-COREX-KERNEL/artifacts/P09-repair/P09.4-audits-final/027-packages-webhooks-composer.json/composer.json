{
  "autoload": {
    "psr-4": {
      "CoreX\\Webhooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CoreX\\Webhooks\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "description": "Webhook subscriptions, signing, delivery and replay for CoreX operations.",
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    },
    "corex": {
      "package-type": "capability",
      "schema-version": 1,
      "stability": "stable"
    },
    "laravel": {
      "providers": [
        "CoreX\\Webhooks\\WebhooksServiceProvider"
      ]
    }
  },
  "license": "MIT",
  "minimum-stability": "stable",
  "name": "axiomasoft/corex-webhooks",
  "prefer-stable": true,
  "repositories": [
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/webhooks/../core"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/webhooks/../operations"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/webhooks/../transfer"
    },
    {
      "options": {
        "symlink": false,
        "versions": {
          "axiomasoft/corex-infection-pest-adapter": "0.1.0"
        }
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/scripts/quality/infection-pest-adapter"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/packages/*"
    },
    {
      "options": {
        "symlink": false
      },
      "type": "path",
      "url": "/tmp/corex-p09-audit-source/products/*"
    },
    {
      "name": "azguard",
      "package": {
        "autoload": {
          "psr-4": {
            "AzGuard\\": "packages/core/src/"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "AzGuard\\AzGuardServiceProvider"
            ]
          }
        },
        "name": "axioma-studio/azguard-core",
        "require": {
          "illuminate/console": "^11.0|^12.0|^13.0",
          "illuminate/contracts": "^11.0|^12.0|^13.0",
          "illuminate/database": "^11.0|^12.0|^13.0",
          "illuminate/filesystem": "^11.0|^12.0|^13.0",
          "illuminate/http": "^11.0|^12.0|^13.0",
          "illuminate/queue": "^11.0|^12.0|^13.0",
          "illuminate/routing": "^11.0|^12.0|^13.0",
          "illuminate/support": "^11.0|^12.0|^13.0",
          "php": "^8.3"
        },
        "source": {
          "reference": "253cbf4cce0226545cd96ca8c6bcbefe329b1403",
          "type": "git",
          "url": "https://github.com/axiomasoft/azguard-private.git"
        },
        "version": "0.3.0"
      },
      "type": "package"
    }
  ],
  "require": {
    "axiomasoft/corex": "^1.0@dev",
    "axiomasoft/corex-operations": "^1.0@dev",
    "ext-filter": "*",
    "illuminate/auth": "^13.0",
    "illuminate/console": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/validation": "^13.0",
    "php": "^8.4",
    "psr/clock": "^1.0"
  },
  "require-dev": {
    "axiomasoft/corex-transfer": "^1.0@dev",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-pdo": "*",
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.32",
    "opis/json-schema": "^2.4.1",
    "orchestra/testbench": "^11.3",
    "orchestra/testbench-core": "^11.5",
    "pestphp/pest": "^5.2",
    "phpunit/phpunit": "^12.0|^13.0"
  },
  "scripts": {
    "analyse": "cd ../.. && vendor/bin/phpstan analyse -c packages/webhooks/phpstan.neon --memory-limit=2G --no-progress",
    "lint:check": "pint --test",
    "test": "pest",
    "test:coverage": "pest --exclude-group=pg --coverage --min=80"
  },
  "suggest": {
    "axiomasoft/corex-transfer": "Optional bounded import/export adapter for durable bulk operations",
    "ext-curl": "Optional webhook transport; missing curl returns capability_unavailable.",
    "opis/json-schema": "2.4.1 — bounded offline tool-schema/1 validation adapter"
  },
  "type": "library"
}
