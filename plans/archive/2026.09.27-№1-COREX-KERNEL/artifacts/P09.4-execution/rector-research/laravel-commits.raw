low/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"dd9fa6965d931b3e8b87e17e8c5b825e4dce3423","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/dd9fa6965d931b3e8b87e17e8c5b825e4dce3423","html_url":"https://github.com/driftingly/rector-laravel/commit/dd9fa6965d931b3e8b87e17e8c5b825e4dce3423"}]},{"sha":"dd9fa6965d931b3e8b87e17e8c5b825e4dce3423","node_id":"C_kwDOFNE1eNoAKGRkOWZhNjk2NWQ5MzFiM2U4Yjg3ZTE3ZThjNWI4MjVlNGRjZTM0MjM","commit":{"author":{"name":"Chinmay Purav","email":"70144052+chinmaypurav@users.noreply.github.com","date":"2026-09-07T15:56:52Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-09-07T15:56:52Z"},"message":"Resolve container binding arguments by name in ContainerBindConcreteWithClosureOnlyRector (#566)\n\n* Resolve container binding arguments by name, not position\n\nContainerBindConcreteWithClosureOnlyRector read the abstract and concrete\narguments positionally, so named arguments produced invalid code:\n\n    $app->singleton(abstract: Foo::class, concrete: fn () => new Foo())\n\nbecame `$app->singleton(concrete: fn () => new Foo())`, which fatals with\nan ArgumentCountError because $abstract is required. Arguments are now\nmatched to parameters by name where present and by position otherwise, so\nreversed named arguments resolve correctly too, and the closure loses its\nname when it moves into the abstract position.\n\nThe $shared argument was silently dropped as well. Laravel routes a\nclosure abstract through bindBasedOnClosureReturnTypes(), which overwrites\n$concrete, so `bind(Foo::class, $fn, true)` became `bind($fn, true)` and\nstopped being shared. It is now emitted as `bind($fn, shared: true)`.\n\nDrop bindIf() and singletonIf() from the rule entirely. Both pass the\nabstract to bound(), which uses it as an array offset, so a closure\nabstract throws \"Cannot access offset of type Closure in isset or empty\".\nEvery transform the rule made on those two methods produced code that\nfatals at boot.\n\nAlso remove the `$classString instanceof Const_` guard: Arg::$value is\nalways an Expr and Const_ extends NodeAbstract, so it could never be true.\n\nFixes #397\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Use CallLike::getArg() instead of a hand-rolled argument matcher\n\nphp-parser 5.6 already resolves an argument by name with a positional\nfallback, which is exactly what matchArgumentsToParameters() was doing.\n\nTwo guards are kept around it. getArg() skips unpacked arguments rather\nthan reporting them, so `bind(Foo::class, $fn, ...$rest)` would otherwise\nhave dropped `...$rest`; unpacked calls are now refused up front. And\n$shared is only looked up for bind(), because singleton() has no such\nparameter -- extra positional arguments to a userland method are legal and\ninert, so rewriting `singleton(Foo::class, $fn, true)` into\n`singleton($fn, shared: true)` would have turned working code into an\n\"Unknown named parameter $shared\" fatal.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Refuse calls whose arguments cannot all be accounted for\n\ngetArg() matches arguments correctly, but this rule rebuilds $node->args\nfrom the ones it resolved, so anything getArg() skipped disappears:\n\n    -$app->bind(SomeInterface::class, function () {\n    +$app->bind(function (): SomeInterface {\n         return new SomeClass();\n    -}, ...$rest);\n    +});\n\nReplace the unpack loop with the invariant it was protecting -- every\nargument has to be accounted for -- which is shorter and also covers a\nnamed argument that is not a parameter at all.\n\nsingleton(Foo::class, $fn, true) is now skipped rather than rewritten to\nsingleton($fn). The third argument is inert, since PHP ignores extra\npositional arguments to a userland method, so the old rewrite was valid;\nbailing is just the conservative reading of an argument we cannot place.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Update src/Rector/MethodCall/ContainerBindConcreteWithClosureOnlyRector.php\n\nCo-authored-by: Caleb White <cdwhite3@pm.me>\n\n---------\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>\nCo-authored-by: Caleb White <cdwhite3@pm.me>","tree":{"sha":"ca7932a1ebe33d90294922287da184b75cf9c608","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/ca7932a1ebe33d90294922287da184b75cf9c608"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/dd9fa6965d931b3e8b87e17e8c5b825e4dce3423","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqnt7ECRC1aQ7uu5UhlAAAGp8QAAijNNNgEiVXLacfrmVykEaN\no5PI1DPThDCHpwv0DpYtOGi2pxpl6/NlYLCSL98chkE7NO1FTYz5kVBpggHtzEra\n0eqolfP4XlwxOGb/fdl0nh4Vvete107SLmy4n2nxzRsuo2Uo20sm4t9QF55sILBh\nVXUqHRNIphDO1BX//QaAhpIoWGIVbJRxH1UndtvrmQE1aroEICMM1ZFZGnuFUDQB\ngCnCsotUpC+RzdwEUJSRB4Aw/TMTI2Q66gkTcX9BtyS+Ne9HWj9v1NOTbdXG/R3y\nKhrsDszO3VMH+YVsI4IEIMEO6uG6j3rrZknNBbVhjCUpuphH4sIsbzt8Kdjk1YdR\n/a4enWGpK5MJ9q/CtmmJI92bpvdn5bG+7I9yutwa116Jp4P1H5SrHc+zeMBYD+ld\nkWzH+D7VBEdJLT0RR5xnOh896PKpy9uxRqOWQtp3ct9i7n7ZJ/evsjYsm7wvYbwh\nQuYVdbN4R/KQ/J3lKdF3Kh5MYnL43l/GOjciKi1llIfmBiA9pnQgB6s7UGH07RiS\nfWiV9W0tmlfecuvoDPSOhc+O5JcE1bmU3BPAWxoSEunsPxnJ3tIwxcFn1KDPSP6L\nNtBuETcWJjDmHIHhqvc8LynROYLvo4U7txSfg5CbA75kUjYCqBZbh13ucHDpg3C2\nWGoLD5PjuLaWDd30EAbm\n=t8TD\n-----END PGP SIGNATURE-----\n","payload":"tree ca7932a1ebe33d90294922287da184b75cf9c608\nparent 8e20b2be8af43e8c855efec31d014f99ecc09c96\nauthor Chinmay Purav <70144052+chinmaypurav@users.noreply.github.com> 1788796612 +0530\ncommitter GitHub <noreply@github.com> 1788796612 -0500\n\nResolve container binding arguments by name in ContainerBindConcreteWithClosureOnlyRector (#566)\n\n* Resolve container binding arguments by name, not position\n\nContainerBindConcreteWithClosureOnlyRector read the abstract and concrete\narguments positionally, so named arguments produced invalid code:\n\n    $app->singleton(abstract: Foo::class, concrete: fn () => new Foo())\n\nbecame `$app->singleton(concrete: fn () => new Foo())`, which fatals with\nan ArgumentCountError because $abstract is required. Arguments are now\nmatched to parameters by name where present and by position otherwise, so\nreversed named arguments resolve correctly too, and the closure loses its\nname when it moves into the abstract position.\n\nThe $shared argument was silently dropped as well. Laravel routes a\nclosure abstract through bindBasedOnClosureReturnTypes(), which overwrites\n$concrete, so `bind(Foo::class, $fn, true)` became `bind($fn, true)` and\nstopped being shared. It is now emitted as `bind($fn, shared: true)`.\n\nDrop bindIf() and singletonIf() from the rule entirely. Both pass the\nabstract to bound(), which uses it as an array offset, so a closure\nabstract throws \"Cannot access offset of type Closure in isset or empty\".\nEvery transform the rule made on those two methods produced code that\nfatals at boot.\n\nAlso remove the `$classString instanceof Const_` guard: Arg::$value is\nalways an Expr and Const_ extends NodeAbstract, so it could never be true.\n\nFixes #397\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Use CallLike::getArg() instead of a hand-rolled argument matcher\n\nphp-parser 5.6 already resolves an argument by name with a positional\nfallback, which is exactly what matchArgumentsToParameters() was doing.\n\nTwo guards are kept around it. getArg() skips unpacked arguments rather\nthan reporting them, so `bind(Foo::class, $fn, ...$rest)` would otherwise\nhave dropped `...$rest`; unpacked calls are now refused up front. And\n$shared is only looked up for bind(), because singleton() has no such\nparameter -- extra positional arguments to a userland method are legal and\ninert, so rewriting `singleton(Foo::class, $fn, true)` into\n`singleton($fn, shared: true)` would have turned working code into an\n\"Unknown named parameter $shared\" fatal.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Refuse calls whose arguments cannot all be accounted for\n\ngetArg() matches arguments correctly, but this rule rebuilds $node->args\nfrom the ones it resolved, so anything getArg() skipped disappears:\n\n    -$app->bind(SomeInterface::class, function () {\n    +$app->bind(function (): SomeInterface {\n         return new SomeClass();\n    -}, ...$rest);\n    +});\n\nReplace the unpack loop with the invariant it was protecting -- every\nargument has to be accounted for -- which is shorter and also covers a\nnamed argument that is not a parameter at all.\n\nsingleton(Foo::class, $fn, true) is now skipped rather than rewritten to\nsingleton($fn). The third argument is inert, since PHP ignores extra\npositional arguments to a userland method, so the old rewrite was valid;\nbailing is just the conservative reading of an argument we cannot place.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Update src/Rector/MethodCall/ContainerBindConcreteWithClosureOnlyRector.php\n\nCo-authored-by: Caleb White <cdwhite3@pm.me>\n\n---------\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>\nCo-authored-by: Caleb White <cdwhite3@pm.me>","verified_at":"2026-09-07T15:56:52Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/dd9fa6965d931b3e8b87e17e8c5b825e4dce3423","html_url":"https://github.com/driftingly/rector-laravel/commit/dd9fa6965d931b3e8b87e17e8c5b825e4dce3423","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/dd9fa6965d931b3e8b87e17e8c5b825e4dce3423/comments","author":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"8e20b2be8af43e8c855efec31d014f99ecc09c96","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/8e20b2be8af43e8c855efec31d014f99ecc09c96","html_url":"https://github.com/driftingly/rector-laravel/commit/8e20b2be8af43e8c855efec31d014f99ecc09c96"}]},{"sha":"8e20b2be8af43e8c855efec31d014f99ecc09c96","node_id":"C_kwDOFNE1eNoAKDhlMjBiMmJlOGFmNDNlOGM4NTVlZmVjMzFkMDE0Zjk5ZWNjMDljOTY","commit":{"author":{"name":"Chinmay Purav","email":"70144052+chinmaypurav@users.noreply.github.com","date":"2026-09-07T12:31:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-09-07T12:31:38Z"},"message":"Skip static contexts in CarbonSetTestNowToTravelToRector (#565)\n\nThe rule decided it was safe to emit `$this->travelTo()` based only on the\nenclosing class being a Laravel TestCase, so it also rewrote calls inside\nstatic methods (such as PHPUnit data providers) and static closures, where\n`$this` is not bound. The result was a fatal \"Using $this when not in object\ncontext\".\n\nGuard on `$scope->hasVariableType('this')` before the existing class and Pest\nclosure checks, which covers both cases.\n\nFixes #408\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"fe99ca37659aeef945568c472f48d36a4f5c7d29","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/fe99ca37659aeef945568c472f48d36a4f5c7d29"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/8e20b2be8af43e8c855efec31d014f99ecc09c96","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqnq6qCRC1aQ7uu5UhlAAAJnYQAGE/iRsM3ezUYx2FtYdNr40T\ne+Sg4vwewSn7COYgXoetO2pF6PLbiB/sS8qMZPL84lvhyruJIvdocn8Tii1niBrZ\n/xLBOAkJgNymL/Qyj8vFQbzTi2aBjL9rtvZKmT3KTJLuh0uoF4kJuKuR9blO/f6s\nvNOCgQTwN0/JiWMfZ7hrwCaiWOffTLzMoBJ/hMc4g9MVcqmM8rLdxVcwfHQFFF2h\nKU7FwNsVInxFZNllH5Zhe3axC8JkoU0NUx+H5Oe7jYmqpUJ6buE4pnWg7+ldoHeX\nTg86SyQc05PJstWIapEIuz6pfUUR5eBh+9rB2tVnnLgJsM7Yd5kvDtLPtiHx16VV\npx+EJ6Cfc3bj8Ec2gKXSKeoGvgnV7CwChWwyiYStQxSpqzrYh+a421rMxfE8xT0j\nh2GZGTyfeQXRQwP4/vDmXLu0a8eK7pQkRhwEdGpMPbupkj99pSASDARQsPVfDtTn\nCAlrpZ6+AoDiY1KnVlMYJv1aVi4Omzwi4FrPc1BfkNYxs7/O4fRSzofEj3npC/LX\nvriiB/GXKVctPw2d9hVtgeWhg+P0rvzVSbLd3pGEZvyKe5uR0Bue4gTYrDQv2csd\nTvUU6R4IGHDzZeIYyp4D1i5stN6pFuPm5xDr4fr7jFSOmljGm+HpGet+H0NdR7Qq\nWfksK++YrvxzIh9rhgoB\n=k1Km\n-----END PGP SIGNATURE-----\n","payload":"tree fe99ca37659aeef945568c472f48d36a4f5c7d29\nparent b9e8f229aa9b40d98bfbb13c424444d9f286ef44\nauthor Chinmay Purav <70144052+chinmaypurav@users.noreply.github.com> 1788784298 +0530\ncommitter GitHub <noreply@github.com> 1788784298 -0500\n\nSkip static contexts in CarbonSetTestNowToTravelToRector (#565)\n\nThe rule decided it was safe to emit `$this->travelTo()` based only on the\nenclosing class being a Laravel TestCase, so it also rewrote calls inside\nstatic methods (such as PHPUnit data providers) and static closures, where\n`$this` is not bound. The result was a fatal \"Using $this when not in object\ncontext\".\n\nGuard on `$scope->hasVariableType('this')` before the existing class and Pest\nclosure checks, which covers both cases.\n\nFixes #408\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","verified_at":"2026-09-07T12:31:39Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/8e20b2be8af43e8c855efec31d014f99ecc09c96","html_url":"https://github.com/driftingly/rector-laravel/commit/8e20b2be8af43e8c855efec31d014f99ecc09c96","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/8e20b2be8af43e8c855efec31d014f99ecc09c96/comments","author":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b9e8f229aa9b40d98bfbb13c424444d9f286ef44","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/b9e8f229aa9b40d98bfbb13c424444d9f286ef44","html_url":"https://github.com/driftingly/rector-laravel/commit/b9e8f229aa9b40d98bfbb13c424444d9f286ef44"}]},{"sha":"b9e8f229aa9b40d98bfbb13c424444d9f286ef44","node_id":"C_kwDOFNE1eNoAKGI5ZThmMjI5YWE5YjQwZDk4YmZiYjEzYzQyNDQ0NGQ5ZjI4NmVmNDQ","commit":{"author":{"name":"Chinmay Purav","email":"70144052+chinmaypurav@users.noreply.github.com","date":"2026-09-07T00:25:37Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-09-07T00:25:37Z"},"message":"Skip variable-only contexts in ArrayDimFetch rules (#564)\n\nThe ArrayDimFetch rules only guarded against direct `=` assignment, so every\nother context where PHP requires a variable was still rewritten into a static\ncall, producing code that fatals:\n\n    unset($_ENV[$key]);       -> unset(Env::get($key));\n    $_ENV['KEY'] .= 'x';      -> Env::get('KEY') .= 'x';\n    sort($_SERVER['LIST']);   -> sort(Request::server('LIST'));\n    $_SESSION['a']['b'] = $v; -> Session::get('a')['b'] = $v;\n\n`foreach ($list as $array['key'])` additionally aborted the whole Rector run\nfrom ArrayToArrGetRector with \"Scope not available on Variable node\".\n\nArrayDimFetchContextNodeVisitor now marks two contexts:\n\n- IS_IN_WRITE_CONTEXT for the variable chain of assignment targets (compound,\n  reference, destructuring and nested dimensions included), increment and\n  decrement, foreach targets, isset()/unset() operands, and by-reference\n  arguments of named function calls, resolved through the reflection provider.\n  Dimensions themselves stay reads and are left unmarked.\n- IS_IN_INTERPOLATED_STRING for \"{$_ENV['KEY']}\", where a call is a syntax\n  error.\n\nAll five ArrayDimFetch rules consult them. The existing IS_BEING_ASSIGNED and\nIS_IN_SUPERGLOBAL_ASSIGN checks are untouched, so no existing conversion moves;\nthe isset()/unset() rewrites into has()/forget() still run, as those are handled\non the Isset_/Unset_ node itself.\n\nFixes #419\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"1a358308031c695b0834fede2b3e2fef54808531","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/1a358308031c695b0834fede2b3e2fef54808531"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/b9e8f229aa9b40d98bfbb13c424444d9f286ef44","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqngSBCRC1aQ7uu5UhlAAAmnoQAK7+HcP7FZmPX7AjVqu7qGgg\nC4g1FO9d7XBjYUT0VuQAARzXwPN736EnwcFZS0cZkQ/VKqoKdvZLztuFmnesvSxI\n8jn+dwtLlhVkfQbuGTPhH2rn+vVGMUMrabbO0xmqnlTYWgQoMa6sbO2JwZrzWhAe\nkbRgUHddP9x6GMq3KZTAvOv4otqaCKoKjv4403HeDtyx/wBiHnHfut+poiBH6Xp7\ntcVcjvfVDJXbpjx36JGxQFHpUa6esWpPZhmgHejArFu2AwHJCeCoNoAY34mOWJD6\nxcEo19+Z+5t4pvCJlQuz07EPFrYrKH09APO4HHR/AQ9UaRFHaL/vDxrfrxL39Lvg\nibyW5LHGctmt0z/4JZOKe0S0ezUJVMjKmsJjTJpu/RSDritEoTmJN0ZrFQ50Ei34\n/ZnWbVGxCERIg4AUjjkJLoo/pwfiiOY4n0OU+FY3Al8kXya2uba4/K5HCSixPJMb\nQ3wEpgQVL6zJ7fxvW0mNmOQL+/ZOTZKVXRjfsg4DBKGHFbdoF0CvEYaBtlheFrUw\nyHLskWsFOnhQAmUoCjK0eS9zvV8eoqDAgxlskjueL97XajGWj4lLM0OxBRDmR2fn\nGKTsukU7Q5QhrCg3vN2MCg3Bq2JoZ3IFmzlTX7wKKo3pOPITET7u+Uk+V9O8CMtx\nOyHk5D5/paDoAFT22LIK\n=ubvE\n-----END PGP SIGNATURE-----\n","payload":"tree 1a358308031c695b0834fede2b3e2fef54808531\nparent ce050f3e5014257cb268bbbf90bda8256a3b21d1\nauthor Chinmay Purav <70144052+chinmaypurav@users.noreply.github.com> 1788740737 +0530\ncommitter GitHub <noreply@github.com> 1788740737 -0500\n\nSkip variable-only contexts in ArrayDimFetch rules (#564)\n\nThe ArrayDimFetch rules only guarded against direct `=` assignment, so every\nother context where PHP requires a variable was still rewritten into a static\ncall, producing code that fatals:\n\n    unset($_ENV[$key]);       -> unset(Env::get($key));\n    $_ENV['KEY'] .= 'x';      -> Env::get('KEY') .= 'x';\n    sort($_SERVER['LIST']);   -> sort(Request::server('LIST'));\n    $_SESSION['a']['b'] = $v; -> Session::get('a')['b'] = $v;\n\n`foreach ($list as $array['key'])` additionally aborted the whole Rector run\nfrom ArrayToArrGetRector with \"Scope not available on Variable node\".\n\nArrayDimFetchContextNodeVisitor now marks two contexts:\n\n- IS_IN_WRITE_CONTEXT for the variable chain of assignment targets (compound,\n  reference, destructuring and nested dimensions included), increment and\n  decrement, foreach targets, isset()/unset() operands, and by-reference\n  arguments of named function calls, resolved through the reflection provider.\n  Dimensions themselves stay reads and are left unmarked.\n- IS_IN_INTERPOLATED_STRING for \"{$_ENV['KEY']}\", where a call is a syntax\n  error.\n\nAll five ArrayDimFetch rules consult them. The existing IS_BEING_ASSIGNED and\nIS_IN_SUPERGLOBAL_ASSIGN checks are untouched, so no existing conversion moves;\nthe isset()/unset() rewrites into has()/forget() still run, as those are handled\non the Isset_/Unset_ node itself.\n\nFixes #419\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","verified_at":"2026-09-07T00:25:38Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/b9e8f229aa9b40d98bfbb13c424444d9f286ef44","html_url":"https://github.com/driftingly/rector-laravel/commit/b9e8f229aa9b40d98bfbb13c424444d9f286ef44","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/b9e8f229aa9b40d98bfbb13c424444d9f286ef44/comments","author":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ce050f3e5014257cb268bbbf90bda8256a3b21d1","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/ce050f3e5014257cb268bbbf90bda8256a3b21d1","html_url":"https://github.com/driftingly/rector-laravel/commit/ce050f3e5014257cb268bbbf90bda8256a3b21d1"}]},{"sha":"ce050f3e5014257cb268bbbf90bda8256a3b21d1","node_id":"C_kwDOFNE1eNoAKGNlMDUwZjNlNTAxNDI1N2NiMjY4YmJiZjkwYmRhODI1NmEzYjIxZDE","commit":{"author":{"name":"Chinmay Purav","email":"70144052+chinmaypurav@users.noreply.github.com","date":"2026-09-03T18:12:50Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-09-03T18:12:50Z"},"message":"Use `new static()` for self/parent dispatch in DispatchToHelperFunctionsRector (#561)\n\n`self::dispatch()` inside an `abstract class` was rewritten to\n`dispatch(new self())`, which fatals with \"Cannot instantiate abstract\nclass\".\n\nThe rewrite was also subtly wrong for concrete classes. `self::` and\n`parent::` are forwarding calls, so the `new static(...)` inside\n`Dispatchable::dispatch()` resolves to the runtime called class, not the\nlexical one. Emitting `new self()` binds it to the declaring class\ninstead, changing which job/event gets dispatched from a subclass.\n\nEmitting `new static()` for every special class name fixes both: the\nabstract case no longer fatals, and forwarding semantics are preserved.\n\nFixes #536\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"5c851768553e08a25bcabb6ff010e35d6982d96d","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/5c851768553e08a25bcabb6ff010e35d6982d96d"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/ce050f3e5014257cb268bbbf90bda8256a3b21d1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqmbiiCRC1aQ7uu5UhlAAA8FcQAARn+s+He7HtJokcsIGRdhn9\nOL9bsS2wnzOw3nEyzTAAf0EmcBySsTFCO68ESpFHY3MbQQ8Nw4OQY1C6o81sJnOl\niF7nRvrdoJkZQ9K0f1SP+NjkUF6TrEuP7/sz8ErTxKgwhLU8+EmHDCSftflLkO+i\nbbz3LIh9T5CsRvxDlRSiVM7QLg/E+mG6UuZzvCph2/qlcxnvWjRqF8en52kOxR24\nMBuiHonMC9QGHAj4LwHvMjffad7J/d/f3V5dHtDw0yH+r1RHclvAomchw1ycnOPJ\nyFQGahXwcX+PLeYKwhS55xqGLn2H5BRp2cFi0OPRpOx4/cpC5R79ZpFaFt1R9ymI\n7iN52Dr73xzBKncnznhrG4+kVe5+slG6bNyrBlSPjpNi3lxzHe34EbXpei8SZKTD\nf5ktzZg2azGCYJzH8ebOAUg1WHUrkdzofH/3eZvRX0HOxnIcDKIenBarkvd4qRO8\njptMqIky/shaOluROXeYWbzsYAcYm8gUvc9js0/gvwTGbZZaZBgiTB9cJaja8leQ\ndLgVIf+J1B8L5adcMYvsvUS4LpPtWxCKiDWopQ/QOzhLpIrxgdHMrf/rFlKIdUKF\naWgJMAIBYPlK5+lsdBIHUEajSKqCf1wedlOgh5wDx4jvjcJeUEmDluTWscRE5cns\nkRip+xfM6IsdiaRkR7Q4\n=uBvM\n-----END PGP SIGNATURE-----\n","payload":"tree 5c851768553e08a25bcabb6ff010e35d6982d96d\nparent 53b7d70ad70275b6a47743b63dfdd92c999d38d7\nauthor Chinmay Purav <70144052+chinmaypurav@users.noreply.github.com> 1788459170 +0530\ncommitter GitHub <noreply@github.com> 1788459170 -0500\n\nUse `new static()` for self/parent dispatch in DispatchToHelperFunctionsRector (#561)\n\n`self::dispatch()` inside an `abstract class` was rewritten to\n`dispatch(new self())`, which fatals with \"Cannot instantiate abstract\nclass\".\n\nThe rewrite was also subtly wrong for concrete classes. `self::` and\n`parent::` are forwarding calls, so the `new static(...)` inside\n`Dispatchable::dispatch()` resolves to the runtime called class, not the\nlexical one. Emitting `new self()` binds it to the declaring class\ninstead, changing which job/event gets dispatched from a subclass.\n\nEmitting `new static()` for every special class name fixes both: the\nabstract case no longer fatals, and forwarding semantics are preserved.\n\nFixes #536\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","verified_at":"2026-09-03T18:12:51Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/ce050f3e5014257cb268bbbf90bda8256a3b21d1","html_url":"https://github.com/driftingly/rector-laravel/commit/ce050f3e5014257cb268bbbf90bda8256a3b21d1","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/ce050f3e5014257cb268bbbf90bda8256a3b21d1/comments","author":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"53b7d70ad70275b6a47743b63dfdd92c999d38d7","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/53b7d70ad70275b6a47743b63dfdd92c999d38d7","html_url":"https://github.com/driftingly/rector-laravel/commit/53b7d70ad70275b6a47743b63dfdd92c999d38d7"}]},{"sha":"53b7d70ad70275b6a47743b63dfdd92c999d38d7","node_id":"C_kwDOFNE1eNoAKDUzYjdkNzBhZDcwMjc1YjZhNDc3NDNiNjNkZmRkOTJjOTk5ZDM4ZDc","commit":{"author":{"name":"Chinmay Purav","email":"70144052+chinmaypurav@users.noreply.github.com","date":"2026-09-03T17:00:34Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-09-03T17:00:34Z"},"message":"Add UnlinkFuncCallToFileFacadeDeleteRector (#559)\n\n* Add UnlinkFuncCallToFileFacadeDeleteRector\n\nReplaces raw unlink() calls with the File facade's delete() method, so\nLaravel applications go through the framework filesystem API instead of\nthe bare PHP function.\n\nThe rule refactors in any expression position, since unlink() and\nFile::delete() both return bool. It skips the two argument form, because\nthe stream context has no facade equivalent, and skips first class\ncallables and unpacked arguments. A filename: named argument is\nconverted to a positional one.\n\nRegistered in the laravel-code-quality set.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Update src/Rector/FuncCall/UnlinkFuncCallToFileFacadeDeleteRector.php\n\nCo-authored-by: Caleb White <cdwhite3@pm.me>\n\n* removed @suppressor\n\n* Support first class callables and drop the error suppressor\n\nFile::delete() calls @unlink() internally and catches the failure, so\nthe suppressor on the original call is redundant and is no longer\ncarried over. Handling ErrorSuppress as a node type lets the whole\nexpression be replaced.\n\nunlink(...) now converts to File::delete(...) as well. getArg() returns\nnull for first class callables and skips unpacked arguments, so those\nare handled separately from the single argument case.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n---------\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>\nCo-authored-by: Caleb White <cdwhite3@pm.me>","tree":{"sha":"eb338206966c37c67b15d28a2107c8cd6ace1e35","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/eb338206966c37c67b15d28a2107c8cd6ace1e35"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/53b7d70ad70275b6a47743b63dfdd92c999d38d7","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqmaeyCRC1aQ7uu5UhlAAAJ1UQAJTjfJ/Us5FXLFN/51iqRZ8k\nkc9/AzvfjlkcLTGA7UYU87V7q9f0M9oPFoBmP+lVhEngc19ZeTUW8O48WRnN1SOK\n9pKXWUHOIkSaJgyL9l6Frtw9GzyDNg/SeVx1G7IKHAVurxKVSVZDUd5M19x/RJ9J\n811cqZs3OL6/Q3EhZWuHQAUXbMAPZ75SrR8rOeRbTpj9Fk1Gk8COAe5gNMjhHBhP\nEY5t+Ix6Muai60M+7d1OUZnisLYRNCgcnHbfefJsV8U/Y43hvPgGr0VPrpf7667S\ng85oKPrwbfStPljCEwLIrjnn8BfvhnesoljXxPCnUy6K0ngm+emRWE8iD5m3IINI\n5NLc7yNnG6fHJvnMxdT4JUc8K6I5EmdOeCpFDdOAWCZa/oZ9TW8TJM/uig87D9dL\n9ix7qLIRq5+8BbXbhjcaqNam+jGCgvAWkKTapf7XCsx5+O0zEoFvjNW1+4uuzzA2\n9zJ93dEpepXwpLtp7OUPQp0xFBTHWyp9jQ/wCSTeBtFv9sSEnhOdfRmm9OmTJm4z\nGBDxdua5m6D4camhbW7IufzqcC/RNRuSKFQ5bYygqHmGi4rhn0R8hYQaoUIYWmEn\nOTn4DTf+HMqLu8NBd0ZUofiSgPh6xCLTzPMVhaF0fuTZzch322+OMdiEll9mEBzI\n53+lvcU3yme3G36RvQA2\n=CFRy\n-----END PGP SIGNATURE-----\n","payload":"tree eb338206966c37c67b15d28a2107c8cd6ace1e35\nparent 623c3aebcc22ea9cd7a218063b77f9d34c316941\nauthor Chinmay Purav <70144052+chinmaypurav@users.noreply.github.com> 1788454834 +0530\ncommitter GitHub <noreply@github.com> 1788454834 -0500\n\nAdd UnlinkFuncCallToFileFacadeDeleteRector (#559)\n\n* Add UnlinkFuncCallToFileFacadeDeleteRector\n\nReplaces raw unlink() calls with the File facade's delete() method, so\nLaravel applications go through the framework filesystem API instead of\nthe bare PHP function.\n\nThe rule refactors in any expression position, since unlink() and\nFile::delete() both return bool. It skips the two argument form, because\nthe stream context has no facade equivalent, and skips first class\ncallables and unpacked arguments. A filename: named argument is\nconverted to a positional one.\n\nRegistered in the laravel-code-quality set.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n* Update src/Rector/FuncCall/UnlinkFuncCallToFileFacadeDeleteRector.php\n\nCo-authored-by: Caleb White <cdwhite3@pm.me>\n\n* removed @suppressor\n\n* Support first class callables and drop the error suppressor\n\nFile::delete() calls @unlink() internally and catches the failure, so\nthe suppressor on the original call is redundant and is no longer\ncarried over. Handling ErrorSuppress as a node type lets the whole\nexpression be replaced.\n\nunlink(...) now converts to File::delete(...) as well. getArg() returns\nnull for first class callables and skips unpacked arguments, so those\nare handled separately from the single argument case.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>\n\n---------\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>\nCo-authored-by: Caleb White <cdwhite3@pm.me>","verified_at":"2026-09-03T17:00:34Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/53b7d70ad70275b6a47743b63dfdd92c999d38d7","html_url":"https://github.com/driftingly/rector-laravel/commit/53b7d70ad70275b6a47743b63dfdd92c999d38d7","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/53b7d70ad70275b6a47743b63dfdd92c999d38d7/comments","author":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"623c3aebcc22ea9cd7a218063b77f9d34c316941","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/623c3aebcc22ea9cd7a218063b77f9d34c316941","html_url":"https://github.com/driftingly/rector-laravel/commit/623c3aebcc22ea9cd7a218063b77f9d34c316941"}]},{"sha":"623c3aebcc22ea9cd7a218063b77f9d34c316941","node_id":"C_kwDOFNE1eNoAKDYyM2MzYWViY2MyMmVhOWNkN2EyMTgwNjNiNzdmOWQzNGMzMTY5NDE","commit":{"author":{"name":"Chinmay Purav","email":"70144052+chinmaypurav@users.noreply.github.com","date":"2026-09-03T13:14:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-09-03T13:14:19Z"},"message":"Scope legacy string event upgrades to the event dispatcher (#557)\n\nThe 5.2/5.4 sets configure Rector core's StringToClassConstantRector, which\nmatches any string literal in a file. 'auth.login' is both a legacy event name\nand the Breeze/UI default Blade view name, so `view('auth.login')` was rewritten\nto `view(\\Illuminate\\Auth\\Events\\Login::class)`, breaking the login page.\n\nAdd EventStringToClassConstantRector, which reuses the same StringToClassConstant\nvalue objects but only rewrites the first argument of an actual event dispatch:\nthe Event facade, an Illuminate\\Contracts\\Events\\Dispatcher instance, and the\nevent() helper (including the array form of Event::listen()). Use it in the\nlaravel52, laravel54 and composer-based sets.\n\nFixes #535\n\n\nClaude-Session: https://claude.ai/code/session_01Cap81JmJFZsM4SGvSHwE8s\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>\nCo-authored-by: Caleb White <cdwhite3@pm.me>","tree":{"sha":"1618e6a297b3ff58fd2e6e43a4af4bc3558e483e","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/1618e6a297b3ff58fd2e6e43a4af4bc3558e483e"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/623c3aebcc22ea9cd7a218063b77f9d34c316941","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqmXKrCRC1aQ7uu5UhlAAAssAQAFYYSnPccY2SKN0/uJMSTV59\nMTZmW4wDx7VhsbA7JMSAF5OJSQM54UpcwZrebPThSbOONu7bxzn+jDH7G0AuBq1k\nWBv+WVUW6PQQEsesnd5Qw7A2Mq0BfGftrz0896GyKAeGkdefuPI2ST9olSFC7k69\ndYwCwDSIMvOdA1s6/VjtjBAyTUQozehKxSQIOZh2I8mHqFztFxwuoigvMffe+NAo\ncUkhCV+OQ1Z3UyMazYWeAJvFR03n1wdAX1z1EZ0yKx8/IensY6+MBskV42Csxany\nmjBADb5CApgJhbElBbkqhCB2Xb/1bY8JiIFeCWtbd6T4FCX1oZ6fwzJ2EbGgGOOB\nGz+/HGAQHbt/HEOpqMoAligiQ54mXwl80lWQ6OVH6gscj2wRyVJL8jnbw1SlfaKl\ngwjwM2Wn36QqKjh9B/enUFzfZT1yTrUocMTtH/ro3rvgpAU4xXyUEoF+abR8YC4t\nvkQZkS2OVbeCMQhNegcC1Qg9E5ShmmOcq9uIG1X1XtkopbN6pUFxnNfe2yQbJitQ\naBdm/8i9zdWoTICELiZYSR3W2M+aUyY5QxchhT/N36rvGJ6AkeKgnq1uRYCff5oL\ntI01LnfgOe4rC9sMDLrw1FrKD1+CqWAjEEf1Q8S4hB/S6Phf/l/KfQ84/UOraGeh\n7RDTXCyB1/esaMzXqdH9\n=BNIY\n-----END PGP SIGNATURE-----\n","payload":"tree 1618e6a297b3ff58fd2e6e43a4af4bc3558e483e\nparent 5a2c6b21b020168c8e53ed767ea52c35faf448b0\nauthor Chinmay Purav <70144052+chinmaypurav@users.noreply.github.com> 1788441259 +0530\ncommitter GitHub <noreply@github.com> 1788441259 -0500\n\nScope legacy string event upgrades to the event dispatcher (#557)\n\nThe 5.2/5.4 sets configure Rector core's StringToClassConstantRector, which\nmatches any string literal in a file. 'auth.login' is both a legacy event name\nand the Breeze/UI default Blade view name, so `view('auth.login')` was rewritten\nto `view(\\Illuminate\\Auth\\Events\\Login::class)`, breaking the login page.\n\nAdd EventStringToClassConstantRector, which reuses the same StringToClassConstant\nvalue objects but only rewrites the first argument of an actual event dispatch:\nthe Event facade, an Illuminate\\Contracts\\Events\\Dispatcher instance, and the\nevent() helper (including the array form of Event::listen()). Use it in the\nlaravel52, laravel54 and composer-based sets.\n\nFixes #535\n\n\nClaude-Session: https://claude.ai/code/session_01Cap81JmJFZsM4SGvSHwE8s\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>\nCo-authored-by: Caleb White <cdwhite3@pm.me>","verified_at":"2026-09-03T13:14:20Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/623c3aebcc22ea9cd7a218063b77f9d34c316941","html_url":"https://github.com/driftingly/rector-laravel/commit/623c3aebcc22ea9cd7a218063b77f9d34c316941","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/623c3aebcc22ea9cd7a218063b77f9d34c316941/comments","author":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5a2c6b21b020168c8e53ed767ea52c35faf448b0","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/5a2c6b21b020168c8e53ed767ea52c35faf448b0","html_url":"https://github.com/driftingly/rector-laravel/commit/5a2c6b21b020168c8e53ed767ea52c35faf448b0"}]},{"sha":"5a2c6b21b020168c8e53ed767ea52c35faf448b0","node_id":"C_kwDOFNE1eNoAKDVhMmM2YjIxYjAyMDE2OGM4ZTUzZWQ3NjdlYTUyYzM1ZmFmNDQ4YjA","commit":{"author":{"name":"Chinmay Purav","email":"70144052+chinmaypurav@users.noreply.github.com","date":"2026-09-03T12:49:46Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-09-03T12:49:46Z"},"message":"Add composer keywords so Composer suggests --dev on require (#558)\n\nComposer's `require` command warns when a package is \"recommended to be\nplaced in require-dev\" and offers to re-run with `--dev`. It decides this\nby intersecting the package's `keywords` with `['dev', 'testing',\n'static analysis']` (see `RequireCommand`), so a package with no\n`keywords` never triggers the prompt.\n\nAdd a `keywords` list including \"dev\" so `composer require\ndriftingly/rector-laravel` nudges users toward `require-dev`, matching\nthe install instructions already in the README. The remaining keywords\nimprove Packagist search.\n\n\nClaude-Session: https://claude.ai/code/session_011GfaqoqasQRrGQkff3Epp1\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"8dea04ef82116e5c3e1067ec96bfd2f90f4de50f","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/8dea04ef82116e5c3e1067ec96bfd2f90f4de50f"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/5a2c6b21b020168c8e53ed767ea52c35faf448b0","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqmWzqCRC1aQ7uu5UhlAAAof4QAE2Hq0qCJY1sunN7C1G4SYtF\nNXvau213nadV4nBBD32/q0Sod4py1e/Snc1jY7ykdqMiz+NIuyqdy3rapRw/vBgF\nrOTwUcsjOxhXI8xEdCwS2Fj6Sil2cByEKGzhD9oilHkJNRuB7C7LEUd6SO7BBymD\nE1Ihw9kugVHIBb2Tbu9X7bCkS73IRW2RLeg29SWB7mCis1g55OpExOFcBMR5JArD\n4/I/bouuX+umei9LK+KBB9+RT46q9c5KnUJ6hYIh+s87gd1Vb9EscMywCHhm7Zun\niXhLMEaFJiyiAfhCCres7ODOcxmulKx9s4dvBu8BMetpfL8hnqRikEaQelnEEKjy\njopRKK/vnjsk+kzdSkJbKGfN2Jc+lwxzvJ/N1oItOniNKoTvSdWtWyvvekZVdEnx\nKwxA8j3Pkieb/CVx95S3fXg1i4z/mWzLykUe+iMoZSdfJA/15E53mV24wT93SMbk\nBTTrgc4MImt2sMJ3LEqVeFS3ZZawHP6LSu6e5gQkmXYn9C1kIuvmt/WzRXqB7Fem\nE5G/NJyKP7WawNi3zVvsPJbKmsjWXVecm4ekETrxGIvsqgO+6lOOA81ew3F071n9\nNy0psFsZYuom/fO2/h7CSmCG17lUsB/8fN6iePTaZ49+Bc4fxIAJg0TJRWAXpkT6\nwTwNvvoGXWq2JWCRFW+g\n=PTIS\n-----END PGP SIGNATURE-----\n","payload":"tree 8dea04ef82116e5c3e1067ec96bfd2f90f4de50f\nparent c0f9a2ff7365cec45d4dc64223608e7cec74604a\nauthor Chinmay Purav <70144052+chinmaypurav@users.noreply.github.com> 1788439786 +0530\ncommitter GitHub <noreply@github.com> 1788439786 -0500\n\nAdd composer keywords so Composer suggests --dev on require (#558)\n\nComposer's `require` command warns when a package is \"recommended to be\nplaced in require-dev\" and offers to re-run with `--dev`. It decides this\nby intersecting the package's `keywords` with `['dev', 'testing',\n'static analysis']` (see `RequireCommand`), so a package with no\n`keywords` never triggers the prompt.\n\nAdd a `keywords` list including \"dev\" so `composer require\ndriftingly/rector-laravel` nudges users toward `require-dev`, matching\nthe install instructions already in the README. The remaining keywords\nimprove Packagist search.\n\n\nClaude-Session: https://claude.ai/code/session_011GfaqoqasQRrGQkff3Epp1\n\nCo-authored-by: Chinmay Purav <git@chinmaypurav.com>\nCo-authored-by: Claude Opus 5 <noreply@anthropic.com>","verified_at":"2026-09-03T12:49:47Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/5a2c6b21b020168c8e53ed767ea52c35faf448b0","html_url":"https://github.com/driftingly/rector-laravel/commit/5a2c6b21b020168c8e53ed767ea52c35faf448b0","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/5a2c6b21b020168c8e53ed767ea52c35faf448b0/comments","author":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c0f9a2ff7365cec45d4dc64223608e7cec74604a","url":"https://api.github.com/repos/driftingly/rector-laravel/commits/c0f9a2ff7365cec45d4dc64223608e7cec74604a","html_url":"https://github.com/driftingly/rector-laravel/commit/c0f9a2ff7365cec45d4dc64223608e7cec74604a"}]},{"sha":"c0f9a2ff7365cec45d4dc64223608e7cec74604a","node_id":"C_kwDOFNE1eNoAKGMwZjlhMmZmNzM2NWNlYzQ1ZDRkYzY0MjIzNjA4ZTdjZWM3NDYwNGE","commit":{"author":{"name":"Tomas Votruba","email":"tomas.vot@gmail.com","date":"2026-08-29T21:42:57Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-29T21:42:57Z"},"message":"Cap 5.x upgrade rules at <6.0 so they stop running on Laravel 6+ (#555)\n\nThe 5.x composer-bound rules used open-ended '>=5.x' constraints, so they kept\napplying on modern Laravel. That is what turned the 5.6 validate() -> validateResolved()\nrename loose on Laravel 13, rewriting the ad-hoc Request::validate(array $rules) call\ninto broken code (#554).\n\nAdd a '<6.0' upper bound to every 5.x rule so each only runs within the 5.x line.","tree":{"sha":"053c8442bb0109f71ba6a4167c9fefeddd7112c8","url":"https://api.github.com/repos/driftingly/rector-laravel/git/trees/053c8442bb0109f71ba6a4167c9fefeddd7112c8"},"url":"https://api.github.com/repos/driftingly/rector-laravel/git/commits/c0f9a2ff7365cec45d4dc64223608e7cec74604a","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqk1JhCRC1aQ7uu5UhlAAA99UQAHmONzxPJKJ0Wi2IsPE1J5nd\nQjxjiFtdYKx9mBdnCCmCg1Ov7ZcoLrTdxiut719jLLqo04hvDVCWKALxXYTjEUV4\nUsX2uJyKFg2StgxZFYx+2uryI2T7JJZvAYELwh3i5W8X4ykChtmvSdhHAX7JHQmh\n/pifzbOJy3klwB3BdMr9qdnGf7pkdmOxPdgJ0SxEqdT5YbzMQH/PZIIiOMEnjOoq\nVUwXkE9mtxD48hNDICK+EE7BwqQALSrefeAy+NwiiyvZmQzbGt2BxW5gKx98hzkI\n6omFK4rE9NX8YVGaHjZSdKA2kHbgU+NSsJCM3JGggsdUcfb/PUqFchN08RQ/17UR\n/eH3/wUEzHSUwRtddab27SsxdotpFQThrH6wugCqTL3227BPAY9Kt8pAu5QyPGWR\nWOLZfR+6UEYF4a0Az8XZGQpgWljofmkNxG1iZ2PRHyx4fwL77c38vyWmEXK4h3to\nK6VZKYiHe2vNq8OID3eJC3pQM9V2Y7+9TZ02yF6HokXo9IkfB9AiZWEs0S5oudRR\nZDs882bbZPygCGPXBK4HHWSUsTjIogvdnrg1mwcIU+U0jdOA3Zytyyj5XArEeHSx\nQjdK0Ow9n3+zOKx62CIUVenKhKj4bRnlYt2eCUNxLNxf3orU0HhXoiLzXO0CusB3\n+iXinYES52h1/8KdctsI\n=pNMM\n-----END PGP SIGNATURE-----\n","payload":"tree 053c8442bb0109f71ba6a4167c9fefeddd7112c8\nparent 8deb9786f50cb263be3e2219136e53d6d143a7d6\nauthor Tomas Votruba <tomas.vot@gmail.com> 1788039777 +0200\ncommitter GitHub <noreply@github.com> 1788039777 -0500\n\nCap 5.x upgrade rules at <6.0 so they stop running on Laravel 6+ (#555)\n\nThe 5.x composer-bound rules used open-ended '>=5.x' constraints, so they kept\napplying on modern Laravel. That is what turned the 5.6 validate() -> validateResolved()\nrename loose on Laravel 13, rewriting the ad-hoc Request::validate(array $rules) call\ninto broken code (#554).\n\nAdd a '<6.0' upper bound to every 5.x rule so each only runs within the 5.x line.","verified_at":"2026-08-29T21:42:57Z"}},"url":"https://api.github.com/repos/driftingly/rector-laravel/commits/c0f9a2ff7365cec45d4dc64223608e7cec74604a","html_url":"https://github.com/driftingly/rector-laravel/commit/c0f9a2ff7365cec45d4dc64223608e7cec74604a","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/commits/c0f9a2ff7365cec45d4dc64223608e7cec74604a/comments","author":{"login":"TomasVotruba","id":924196,"node_id":"MDQ6VXNlcjkyNDE5Ng==","avatar_url":"https://avatars.githubusercontent.com/u/924196?v=4","gravatar_id":"","url":"https://api.github.com/users/TomasVotruba","html_url":"https://github.com/TomasVotruba","followers_url":"https://api.github.com/users/TomasVotruba/followers","following_url":"https://api.github.com/users/TomasVotruba/following{/other_user}","gists_url":"https://api.github.com/users/TomasVotruba/gists{/gist_id}","starred_url":"https://api.github.com/users/TomasVotruba/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TomasVotruba/subscriptions","organizations_url":"https://api.github.com/users/TomasVotruba/orgs","repos_url":"https://api.github.com/users/TomasVotruba/repos","events_url":"https://api.github.com/users/TomasVotruba/events{/privacy}","received_events_url":"https://api.github.com/users/TomasVotruba/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-fl