mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ast","instant-upgrades","laravel","php","rector","rules"],"visibility":"public","forks":115,"open_issues":34,"watchers":1286,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/577"},"html":{"href":"https://github.com/driftingly/rector-laravel/pull/577"},"issue":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/577"},"comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/577/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/577/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/577/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/3306d1bf581796f156e8ce15622b7ca7fdfcdb35"}},"author_association":"CONTRIBUTOR","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/576","id":4734105347,"node_id":"PR_kwDOFNE1eM8AAAABGiy3Aw","html_url":"https://github.com/driftingly/rector-laravel/pull/576","diff_url":"https://github.com/driftingly/rector-laravel/pull/576.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/576.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/576","number":576,"state":"open","locked":false,"title":"Add ReplaceTestAttributeWithPrefixedFunctionRector","user":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"rector-phpunit has `ReplaceTestAnnotationWithPrefixedFunctionRector` (`@test` → `test*`) and the reverse `ReplaceTestFunctionPrefixWithAttributeRector` (`test*` → `#[Test]`), but nothing that goes from the `#[Test]` attribute back to a prefixed method name. This adds that rule.\n\n```diff\n class SomeTest extends TestCase\n {\n-    #[Test]\n-    public function it_adds_numbers(): void\n+    public function test_it_adds_numbers(): void\n     {\n         $this->assertSame(2, 1 + 1);\n     }\n\n-    #[Test]\n-    public function onePlusOneShouldBeTwo(): void\n+    public function testOnePlusOneShouldBeTwo(): void\n     {\n         $this->assertSame(2, 1 + 1);\n     }\n }\n```\n\n## Behavior\n\n- Only applies to classes extending `PHPUnit\\Framework\\TestCase` (which covers Laravel's `TestCase`).\n- Matches `#[Test]` both imported and fully qualified.\n- Keeps the method's naming style: snake_case methods get `test_` (Laravel's convention), camelCase methods get `test` + `ucfirst`.\n- Other attributes are preserved, whether in the same group (`#[Test, Group('x')]` → `#[Group('x')]`) or on separate lines.\n- If the method already starts with `test`, the redundant attribute is just removed.\n- Skips the rename if a method with the target name already exists.\n\nThe rule isn't added to any set. Happy to add it to `laravel-testing` if wanted.\n\n## Tests\n\nSix fixtures covering the cases above, plus skips for non-test classes and methods without the attribute. Docs regenerated.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n","created_at":"2026-10-04T11:49:13Z","updated_at":"2026-10-04T11:49:13Z","closed_at":null,"merged_at":null,"merge_commit_sha":"e6b675416ff538d1c5f1c7cbc5e56c231ec03185","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/576/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/576/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/576/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/d2e9310da6cb7e4e728aca3a950fa3df9518d4b4","head":{"label":"chinmaypurav:replace-test-attribute-with-prefixed-function","ref":"replace-test-attribute-with-prefixed-function","sha":"d2e9310da6cb7e4e728aca3a950fa3df9518d4b4","user":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/