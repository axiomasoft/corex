rs_count":1286,"watchers_count":1286,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":115,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":34,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ast","instant-upgrades","laravel","php","rector","rules"],"visibility":"public","forks":115,"open_issues":34,"watchers":1286,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/578"},"html":{"href":"https://github.com/driftingly/rector-laravel/pull/578"},"issue":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/578"},"comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/578/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/578/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/578/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/d638e0d3071a2ee5976c2045ceb9b2247d13b6ba"}},"author_association":"NONE","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/577","id":4734365791,"node_id":"PR_kwDOFNE1eM8AAAABGjCwXw","html_url":"https://github.com/driftingly/rector-laravel/pull/577","diff_url":"https://github.com/driftingly/rector-laravel/pull/577.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/577.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/577","number":577,"state":"open","locked":false,"title":"Add RemoveDefaultAuthorizeTrueFromFormRequestRector","user":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Removes `authorize()` from `FormRequest` subclasses when it only returns `true`.\n\nSince Laravel 5.7, `FormRequest::passesAuthorization()` returns `true` when no `authorize()` method exists, so a method that only does `return true;` is redundant. Before 5.7 the fallback was `false`, so the rule is constrained to `laravel/framework >=5.7`.\n\n```diff\n class StorePostRequest extends FormRequest\n {\n-    public function authorize(): bool\n-    {\n-        return true;\n-    }\n-\n     public function rules(): array\n     {\n         return [];\n     }\n }\n```\n\n### Skipped\n- `authorize()` doing anything other than a single `return true;` (returns `false`, has extra statements, has parameters)\n- Non-`FormRequest` classes\n- When a parent class, trait or interface declares `authorize()`, since removing the override would expose that method instead\n\nThe rule is added to the `laravel-code-quality` set and the docs are regenerated.\n\nOne known limitation: the rule can't see a subclass that calls `parent::authorize()` on the modified request.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)","created_at":"2026-10-04T12:30:00Z","updated_at":"2026-10-04T12:30:00Z","closed_at":null,"merged_at":null,"merge_commit_sha":"49279a3db8e707f7e0e527d2055627d3c3b9687b","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/577/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/577/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/577/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/3306d1bf581796f156e8ce15622b7ca7fdfcdb35","head":{"label":"chinmaypurav:remove-default-authorize-true-from-form-request","ref":"remove-default-authorize-true-from-form-request","sha":"3306d1bf581796f156e8ce15622b7ca7fdfcdb35","user":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":1133500728,"node_id":"R_kgDOQ4_ZOA","name":"rector-laravel","full_name":"chinmaypurav/rector-laravel","private":false,"owner":{"login":"chinmaypurav","id":70144052,"node_id":"MDQ6VXNlcjcwMTQ0MDUy","avatar_url":"https://avatars.githubusercontent.com/u/70144052?v=4","gravatar_id":"","url":"https://api.github.com/users/chinmaypurav","html_url":"https://github.com/chinmaypurav","followers_url":"https://api.github.com/users/chinmaypurav/followers","following_url":"https://api.github.com/users/chinmaypurav/following{/other_user}","gists_url":"https://api.github.com/users/chinmaypurav/gists{/gist_id}","starred_url":"https://api.github.com/users/chinmaypurav/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chinmaypurav/subscriptions","organizations_url":"https://api.github.com/users/chinmaypurav/orgs","repos_url":"https://api.github.com/users/chinmaypurav/repos","events_url":"https://api.github.com/users/chinmaypurav/events{/privacy}","received_events_url":"https://api.github.com/users/chinmaypurav/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/chinmaypurav/rector-laravel","description":"Rector upgrades rules for Laravel","fork":true,"url":"https://api.github.com/repos/chinmaypurav/rector-laravel","forks_url":"https://api.github.com/repos/chinmaypurav/rector-laravel/forks","keys_url":"https://api.github.com/repos/chinmaypurav/rector-laravel/keys{/key_id}","collaborators_url":"https://api.github.com/repos/chinmaypurav/rector-laravel/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/chinmaypurav/rector-laravel/teams","hooks_url":"https://api.github.com/repos/chinmaypurav/rector-laravel/hooks","issue_events_url":"https://api.github.com/repos/chinmaypurav/rector-laravel/issues/events{/number}","