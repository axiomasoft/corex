ue,"has_projects":false,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":115,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":34,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ast","instant-upgrades","laravel","php","rector","rules"],"visibility":"public","forks":115,"open_issues":34,"watchers":1286,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/549"},"html":{"href":"https://github.com/driftingly/rector-laravel/pull/549"},"issue":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/549"},"comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/549/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/549/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/549/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/8c58fbdc9ede681539244c7c9220b05789312886"}},"author_association":"CONTRIBUTOR","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/541","id":4228240766,"node_id":"PR_kwDOFNE1eM78BdV-","html_url":"https://github.com/driftingly/rector-laravel/pull/541","diff_url":"https://github.com/driftingly/rector-laravel/pull/541.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/541.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/541","number":541,"state":"open","locked":false,"title":"feat(rules): Add RelationTableStringToPivotClassRector rule","user":{"login":"MizouziE","id":90829439,"node_id":"MDQ6VXNlcjkwODI5NDM5","avatar_url":"https://avatars.githubusercontent.com/u/90829439?v=4","gravatar_id":"","url":"https://api.github.com/users/MizouziE","html_url":"https://github.com/MizouziE","followers_url":"https://api.github.com/users/MizouziE/followers","following_url":"https://api.github.com/users/MizouziE/following{/other_user}","gists_url":"https://api.github.com/users/MizouziE/gists{/gist_id}","starred_url":"https://api.github.com/users/MizouziE/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MizouziE/subscriptions","organizations_url":"https://api.github.com/users/MizouziE/orgs","repos_url":"https://api.github.com/users/MizouziE/repos","events_url":"https://api.github.com/users/MizouziE/events{/privacy}","received_events_url":"https://api.github.com/users/MizouziE/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Rule\r\n\r\n- Rewrites the `$table` argument of `belongsToMany()`, `morphToMany()` and `morphedByMany()` from a raw table-name string to the pivot model's class constant: `belongsToMany(Tag::class, 'post_tag')` -> `belongsToMany(Tag::class, PostTag::class)`.\r\n- Handles the `$table` param wherever it sits; arg 1 for `belongsToMany`, arg 2 for the morph variants — including named arguments (`table: 'post_tag'`).\r\n\r\n## Reasons\r\n\r\n- Laravel already treats it as first-class: `BelongsToMany::resolveTableName()` accepts a model class, resolves it to `$model->getTable()`, and additionally calls `using($table)` when that model uses the `AsPivot` trait — so the class form carries strictly more information than the string.\r\n- The table name stops being duplicated across the codebase. Rename the table in the pivot model's `#[Table]` attribute (or `$table`) and every relation follows.\r\n- Static analysis and IDEs can see the reference: jump-to-definition, find-usages and automated class renames all work on `PostTag::class` and none of them work on `'post_tag'`.\r\n- A typo in a class constant is a fatal error at parse/analysis time but a typo in the string is a runtime SQL error. Better to catch earlier than later.\r\n\r\n","created_at":"2026-08-07T11:59:18Z","updated_at":"2026-09-12T01:12:12Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[{"login":"calebdw","id":4176520,"node_id":"MDQ6VXNlcjQxNzY1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/4176520?v=4","gravatar_id":"","url":"https://api.github.com/users/calebdw","html_url":"https://github.com/calebdw","followers_url":"https://api.github.com/users/calebdw/followers","following_url":"https://api.github.com/users/calebdw/following{/other_user}","gists_url":"https://api.github.com/users/calebdw/gists{/gist_id}","starred_url":"https://api.github.com/users/calebdw/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/calebdw/subscriptions","organizations_url":"https://api.github.com/users/calebdw/orgs","repos_url":"https://api.github.com/users/calebdw/repos","events_url":"https://api.github.com/users/calebdw/events{/privacy}","received_events_url":"https://api.github.com/users/calebdw/received_events","type":"User","user_view_type":"public","site_admin":false}],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/541/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/541/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/541/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/c96f60d7cde6147b75a359836e4ea70e6953c766","head":{"label":"MizouziE:relation-table-string-to-pivot-class","ref":"relation-table-string-to-pivot-class","sha