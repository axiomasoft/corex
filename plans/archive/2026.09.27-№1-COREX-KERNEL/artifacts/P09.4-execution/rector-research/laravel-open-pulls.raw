[{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/578","id":4760088501,"node_id":"PR_kwDOFNE1eM8AAAABG7kvtQ","html_url":"https://github.com/driftingly/rector-laravel/pull/578","diff_url":"https://github.com/driftingly/rector-laravel/pull/578.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/578.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/578","number":578,"state":"open","locked":false,"title":"Skip parent and interface scope methods in ScopeNamedClassMethodToScopeAttributedClassMethodRector","user":{"login":"yannickuhlmann","id":72381412,"node_id":"MDQ6VXNlcjcyMzgxNDEy","avatar_url":"https://avatars.githubusercontent.com/u/72381412?v=4","gravatar_id":"","url":"https://api.github.com/users/yannickuhlmann","html_url":"https://github.com/yannickuhlmann","followers_url":"https://api.github.com/users/yannickuhlmann/followers","following_url":"https://api.github.com/users/yannickuhlmann/following{/other_user}","gists_url":"https://api.github.com/users/yannickuhlmann/gists{/gist_id}","starred_url":"https://api.github.com/users/yannickuhlmann/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yannickuhlmann/subscriptions","organizations_url":"https://api.github.com/users/yannickuhlmann/orgs","repos_url":"https://api.github.com/users/yannickuhlmann/repos","events_url":"https://api.github.com/users/yannickuhlmann/events{/privacy}","received_events_url":"https://api.github.com/users/yannickuhlmann/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Skips scope methods in `ScopeNamedClassMethodToScopeAttributedClassMethodRector` when they are declared in a parent class or in an interface the model implements. Renaming `scopeArchived()` to a protected `archived()` breaks that contract and causes a fatal error.\n\nThe check uses Rector's `ParentClassMethodTypeOverrideGuard::hasParentClassMethod()`. It covers parent classes and interfaces, and skips the method when a parent class can't be loaded.\n\nAdded fixtures for the interface and parent class cases.\n\nRefs #521\n\n**Note:** `MakeModelAttributesAndScopesProtectedRector` has the same problem. It only checks the parent class, not interfaces, so it turns `public function scopeArchived()` into `protected` on a model implementing `Publishable`. That's the exact fatal quoted in #521, which is why this PR doesn't close the issue. Happy to fix it in a follow-up PR.\n","created_at":"2026-10-06T14:20:21Z","updated_at":"2026-10-06T14:20:21Z","closed_at":null,"merged_at":null,"merge_commit_sha":"26e9167a1969effd077caba4f7eec1ef4f575e35","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/578/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/578/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/578/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/d638e0d3071a2ee5976c2045ceb9b2247d13b6ba","head":{"label":"yannickuhlmann:skip-scope-methods-with-contracts","ref":"skip-scope-methods-with-contracts","sha":"d638e0d3071a2ee5976c2045ceb9b2247d13b6ba","user":{"login":"yannickuhlmann","id":72381412,"node_id":"MDQ6VXNlcjcyMzgxNDEy","avatar_url":"https://avatars.githubusercontent.com/u/72381412?v=4","gravatar_id":"","url":"https://api.github.com/users/yannickuhlmann","html_url":"https://github.com/yannickuhlmann","followers_url":"https://api.github.com/users/yannickuhlmann/followers","following_url":"https://api.github.com/users/yannickuhlmann/following{/other_user}","gists_url":"https://api.github.com/users/yannickuhlmann/gists{/gist_id}","starred_url":"https://api.github.com/users/yannickuhlmann/starred{/owner}{/repo}","subscription