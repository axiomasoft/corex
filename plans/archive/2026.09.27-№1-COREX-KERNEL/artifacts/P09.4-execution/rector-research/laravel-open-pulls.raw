2/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/552/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/552/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/03f468eaf2fe550221a0d1b3d82038d25d0ec715"}},"author_association":"NONE","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/549","id":4370496324,"node_id":"PR_kwDOFNE1eM8AAAABBIB7RA","html_url":"https://github.com/driftingly/rector-laravel/pull/549","diff_url":"https://github.com/driftingly/rector-laravel/pull/549.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/549.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/549","number":549,"state":"open","locked":false,"title":"Add AssertDatabaseCountToAssertDatabaseEmptyRector","user":{"login":"MizouziE","id":90829439,"node_id":"MDQ6VXNlcjkwODI5NDM5","avatar_url":"https://avatars.githubusercontent.com/u/90829439?v=4","gravatar_id":"","url":"https://api.github.com/users/MizouziE","html_url":"https://github.com/MizouziE","followers_url":"https://api.github.com/users/MizouziE/followers","following_url":"https://api.github.com/users/MizouziE/following{/other_user}","gists_url":"https://api.github.com/users/MizouziE/gists{/gist_id}","starred_url":"https://api.github.com/users/MizouziE/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MizouziE/subscriptions","organizations_url":"https://api.github.com/users/MizouziE/orgs","repos_url":"https://api.github.com/users/MizouziE/repos","events_url":"https://api.github.com/users/MizouziE/events{/privacy}","received_events_url":"https://api.github.com/users/MizouziE/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Rule\r\n\r\nThis adds a rule to convert zero count `assertDatabaseCount()` calls to `assertDatabaseEmpty()`.\r\n\r\nExample:\r\n```diff\r\n class ExampleTest extends \\Illuminate\\Foundation\\Testing\\TestCase\r\n {\r\n     public function testFoo()\r\n     {\r\n-        $this->assertDatabaseCount('users', 0);\r\n-        $this->assertDatabaseCount(User::class, 0);\r\n-        $this->assertDatabaseCount('users', 0, 'other');\r\n+        $this->assertDatabaseEmpty('users');\r\n+        $this->assertDatabaseEmpty(User::class);\r\n+        $this->assertDatabaseEmpty('users', 'other');\r\n     }\r\n }\r\n```\r\n\r\n## Reason\r\n\r\n- Since Laravel 9.39 we've had the more readable empty database table assertions available to us\r\n- We have noticed lately that coding agents repeatedly use zero counts in database assertions","created_at":"2026-08-26T20:23:47Z","updated_at":"2026-09-12T01:29:36Z","closed_at":null,"merged_at":null,"merge_commit_sha":"6eaa822d9d4111b41d13a8ec75eab7fc91749f7b","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/549/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/549/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/549/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/8c58fbdc9ede681539244c7c9220b05789312886","head":{"label":"MizouziE:zero-count-to-empty","ref":"zero-count-to-empty","sha":"8c58fbdc9ede681539244c7c9220b05789312886","user":{"login":"MizouziE","id":90829439,"node_id":"MDQ6VXNlcjkwODI5NDM5","avatar_url":"https://avatars.githubusercontent.com/u/90829439?v=4","gravatar_id":"","url":"https://api.github.com/users/MizouziE","html_url":"https://github.com/MizouziE","followers_ur