name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ast","instant-upgrades","laravel","php","rector","rules"],"visibility":"public","forks":115,"open_issues":34,"watchers":1286,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/576"},"html":{"href":"https://github.com/driftingly/rector-laravel/pull/576"},"issue":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/576"},"comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/576/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/576/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/576/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/d2e9310da6cb7e4e728aca3a950fa3df9518d4b4"}},"author_association":"CONTRIBUTOR","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/570","id":4571658990,"node_id":"PR_kwDOFNE1eM8AAAABEH367g","html_url":"https://github.com/driftingly/rector-laravel/pull/570","diff_url":"https://github.com/driftingly/rector-laravel/pull/570.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/570.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/570","number":570,"state":"open","locked":false,"title":"Preserve timezone argument when replacing `now()->startOfDay()`","user":{"login":"jivanf","id":25129083,"node_id":"MDQ6VXNlcjI1MTI5MDgz","avatar_url":"https://avatars.githubusercontent.com/u/25129083?v=4","gravatar_id":"","url":"https://api.github.com/users/jivanf","html_url":"https://github.com/jivanf","followers_url":"https://api.github.com/users/jivanf/followers","following_url":"https://api.github.com/users/jivanf/following{/other_user}","gists_url":"https://api.github.com/users/jivanf/gists{/gist_id}","starred_url":"https://api.github.com/users/jivanf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jivanf/subscriptions","organizations_url":"https://api.github.com/users/jivanf/orgs","repos_url":"https://api.github.com/users/jivanf/repos","events_url":"https://api.github.com/users/jivanf/events{/privacy}","received_events_url":"https://api.github.com/users/jivanf/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"`NowFuncWithStartOfDayMethodCallToTodayFuncRector` currently doesn't preserve arguments passed to `now()` when converting `now()->startOfDay()` to `today()`. `now()` has a timezone parameter, so this:\r\n\r\n```php\r\nnow('UTC')->startOfDay()\r\n```\r\n\r\nbecomes:\r\n\r\n```php\r\ntoday()\r\n```\r\n\r\nWith this PR, the timezone would be passed to `today()`:\r\n\r\n```php\r\ntoday('UTC')\r\n```\r\n\r\nThis is safe because `now()` and `today()` have always had the same signature.","created_at":"2026-09-18T18:08:56Z","updated_at":"2026-09-18T18:11:25Z","closed_at":null,"merged_at":null,"merge_commit_sha":"bd2f6b7414669dd75ed653e04600834c56e736ab","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/570/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/570/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/570/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/f7cb71dd01478039d9dd936f1a21134393aec47e","head":{"label":"jivanf:preserve-now-timezone","ref":"preserve-now-timezone","sha":"f7cb71dd01478039d9dd936f1a21134393aec47e","user":{"login":"jivanf","id":25129083,"node_id":"MDQ6VXNlcjI1MTI5MDgz","avatar_url":"https://avatars.githubusercontent.com/u/25129083?v=4","gravatar_id":"","url":"https://api.github.com/users/jivanf","html_url":"https://github.com/jivanf","followers_url":"https://api.github.com/users/jivanf/followers","following_url":"https://api.github.com/users/jivanf/following{/other_user}","gists_url":"https://api.github.com/users/jivanf/gists{/gist_id}","starred_url":"https://api.github.com/users/jivanf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jivanf/subscriptions","organizations_url":"https://api.github.com/users/jivanf/orgs","repos_url":"https://api.github.com/users/jivanf/repos","events_url":"https://api.github.com/users/jivanf/events{/privacy}","received_events_url":"https://api.github.com/users/jivanf/received_events","type":"User","user_view_type":"public","site_admin":false},"repo":{"id":871810990,"node_id":"R_kgDOM_bHrg","name":"rector-laravel","full_name":"jivanf/rector-laravel","private":false,"owner":{"login":"jivanf","id":25129083,"node_id":"MDQ6VXNlcjI1MTI5MDgz","avatar_url":"https://avatars.githubusercontent.com/u/25129083?v=4","gravatar_id":"","url":"https://api.github.com/users/jivanf","html_url":"https://github.com/jivanf","followers_url":"https://api.github.com/users/jivanf/followers","following_url":"https://api.github.com/users/jivanf/following{/other_user}","gists_url":"https://api.github.com/users/jivanf/gists{/gist_id}","starred_url":"https://api.github.com/users/jivanf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jivanf/subscriptions","organizations_url":"https://api.github.com/users/jivanf/orgs","repos_url":"https://api.github.com/users/jivanf/repos","events_url":"https://api.github.com/users/jivanf/events{/privacy}","received_events_url":"https://api.github