s://github.com/driftingly/rector-laravel","homepage":"http://getrector.org","size":2094,"stargazers_count":1286,"watchers_count":1286,"language":"PHP","has_issues":true,"has_projects":false,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":115,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":34,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ast","instant-upgrades","laravel","php","rector","rules"],"visibility":"public","forks":115,"open_issues":34,"watchers":1286,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/568"},"html":{"href":"https://github.com/driftingly/rector-laravel/pull/568"},"issue":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/568"},"comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/568/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/568/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/568/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/2f16f26b4d0ad1ed0f4d600294529b08e51957a7"}},"author_association":"NONE","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/567","id":4498462905,"node_id":"PR_kwDOFNE1eM8AAAABDCEYuQ","html_url":"https://github.com/driftingly/rector-laravel/pull/567","diff_url":"https://github.com/driftingly/rector-laravel/pull/567.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/567.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/567","number":567,"state":"open","locked":false,"title":"Fix/query builder union type reflection","user":{"login":"misaf","id":8195685,"node_id":"MDQ6VXNlcjgxOTU2ODU=","avatar_url":"https://avatars.githubusercontent.com/u/8195685?v=4","gravatar_id":"","url":"https://api.github.com/users/misaf","html_url":"https://github.com/misaf","followers_url":"https://api.github.com/users/misaf/followers","following_url":"https://api.github.com/users/misaf/following{/other_user}","gists_url":"https://api.github.com/users/misaf/gists{/gist_id}","starred_url":"https://api.github.com/users/misaf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/misaf/subscriptions","organizations_url":"https://api.github.com/users/misaf/orgs","repos_url":"https://api.github.com/users/misaf/repos","events_url":"https://api.github.com/users/misaf/events{/privacy}","received_events_url":"https://api.github.com/users/misaf/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## Summary\r\n\r\nFixes a crash in `QueryBuilderAnalyzer::isProxyCall()` when PHPStan resolves a model static call to a compound type such as `UnionType`.\r\n\r\nThe issue can be triggered by native model calls such as:\r\n\r\n```php\r\nprotected function casts(): array\r\n{\r\n    return [\r\n        ...parent::casts(),\r\n    ];\r\n}\r\n```\r\n\r\nWith `DateWhereClauseToShorthandRector` enabled, Rector may fail with:\r\n\r\n```text\r\nCall to undefined method PHPStan\\Type\\UnionType::getClassReflection()\r\n```\r\n\r\n## Cause\r\n\r\n`QueryBuilderAnalyzer` assumed that any type for which `isObject()` does not return `no` supports:\r\n\r\n```php\r\n$classType->getClassReflection();\r\n```\r\n\r\nThat is not true for compound PHPStan types such as `UnionType`.\r\n\r\n## Fix\r\n\r\nUse PHPStan's common `Type::getObjectClassReflections()` API instead.\r\n\r\nThe analyzer now proceeds only when exactly one class reflection can be resolved; otherwise it safely returns `false`.\r\n\r\n## Tests\r\n\r\nAdded a regression fixture using `parent::casts()` to ensure native parent model calls no longer cause Rector to crash.\r\n","created_at":"2026-09-10T17:43:05Z","updated_at":"2026-10-05T10:10:19Z","closed_at":null,"merged_at":null,"merge_commit_sha":"68a07f84075886574fe1692e597691932a4cfc64","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/567/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/567/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/567/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/79660bba3b414c37328235214e4401644939921e","head":{"label":"misaf:fix/query-builder-union-type-reflection","ref":"fix/query-builder-union-type-reflection","sha":"79660bba3b414c37328235214e4401644939921e","user":{"login":"misaf","id":8195685,"node_id":"MDQ6VXNlcjgxOTU2ODU=","avatar_url":"https://avatars.githubusercontent.com/u/8195685?v=4","gravatar_id":"","url":"https://api.github.com/users/misaf","html_url":"https://github.com/misaf","followers_url":"https://api.github.com/users/misaf/followers","following_url":"https://api.github.com/users/misaf/following{/other_user}","gists_url":"https://api.github.com/users/misaf/gists{/gist_id}","starred_url":"https://api.github.com/users/misaf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/misaf/subscriptions","organizations_url":"https://api.github.com/users/misaf/orgs","repos_url":"https://api.github.com/users/misaf/repos","events_url":"https://api.github.com/users/misaf/events{/privacy}","received_events_url":"https://api.github.com/users/misaf/received_e