:false,"has_wiki":false,"has_pages":false,"has_discussions":true,"forks_count":115,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":34,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ast","instant-upgrades","laravel","php","rector","rules"],"visibility":"public","forks":115,"open_issues":34,"watchers":1286,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/428"},"html":{"href":"https://github.com/driftingly/rector-laravel/pull/428"},"issue":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/428"},"comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/428/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/428/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/428/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/f47e61b805bc96743f2680e5f54ce113a289a1e2"}},"author_association":"COLLABORATOR","auto_merge":null,"assignee":{"login":"peterfox","id":1716506,"node_id":"MDQ6VXNlcjE3MTY1MDY=","avatar_url":"https://avatars.githubusercontent.com/u/1716506?v=4","gravatar_id":"","url":"https://api.github.com/users/peterfox","html_url":"https://github.com/peterfox","followers_url":"https://api.github.com/users/peterfox/followers","following_url":"https://api.github.com/users/peterfox/following{/other_user}","gists_url":"https://api.github.com/users/peterfox/gists{/gist_id}","starred_url":"https://api.github.com/users/peterfox/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/peterfox/subscriptions","organizations_url":"https://api.github.com/users/peterfox/orgs","repos_url":"https://api.github.com/users/peterfox/repos","events_url":"https://api.github.com/users/peterfox/events{/privacy}","received_events_url":"https://api.github.com/users/peterfox/received_events","type":"User","user_view_type":"public","site_admin":false},"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/409","id":2918542682,"node_id":"PR_kwDOFNE1eM6t9W1a","html_url":"https://github.com/driftingly/rector-laravel/pull/409","diff_url":"https://github.com/driftingly/rector-laravel/pull/409.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/409.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/409","number":409,"state":"open","locked":false,"title":"fix: skip more scope methods that aren't scopes based on types","user":{"login":"mnastalski","id":10223434,"node_id":"MDQ6VXNlcjEwMjIzNDM0","avatar_url":"https://avatars.githubusercontent.com/u/10223434?v=4","gravatar_id":"","url":"https://api.github.com/users/mnastalski","html_url":"https://github.com/mnastalski","followers_url":"https://api.github.com/users/mnastalski/followers","following_url":"https://api.github.com/users/mnastalski/following{/other_user}","gists_url":"https://api.github.com/users/mnastalski/gists{/gist_id}","starred_url":"https://api.github.com/users/mnastalski/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mnastalski/subscriptions","organizations_url":"https://api.github.com/users/mnastalski/orgs","repos_url":"https://api.github.com/users/mnastalski/repos","events_url":"https://api.github.com/users/mnastalski/events{/privacy}","received_events_url":"https://api.github.com/users/mnastalski/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Hey,\r\n\r\nExpanding on #380, I would like to add more checks to `MakeModelAttributesAndScopesProtectedRector` to avoid some methods \r\nthat aren't scopes being picked up as ones. Right now if you have a method like `scopeItem` or `scopedItem` it's going to get picked up and erroneously have its visibility changed.\r\n\r\nI propose adding the following checks:\r\n- first parameter must be of type `Illuminate\\Database\\Eloquent\\Builder`\r\n- return type must be `Illuminate\\Database\\Eloquent\\Builder` or `void`\r\n\r\nThese are in line with the [docs](https://laravel.com/docs/11.x/eloquent#local-scopes). Additionally, if a method has the `#[Scope]` attribute then it will be considered a scope unconditionally.","created_at":"2025-10-15T20:12:59Z","updated_at":"2025-11-01T22:17:23Z","closed_at":null,"merged_at":null,"merge_commit_sha":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/409/commits","review_comments_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/409/comments","review_comment_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}","comments_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/409/comments","statuses_url":"https://api.github.com/repos/driftingly/rector-laravel/statuses/1a5b61918f4f1f9609a1ba692fc1b2362e06424f","head":{"label":"mnastalski:main","ref":"main","sha":"1a5b61918f4f1f9609a1ba692fc1b2362e06424f","user":{"login":"mnastalski","id":10223434,"node_id":"MDQ6VXNlcjEwMjIzNDM0","avatar_url":"https://avatars.githubusercontent.com/u/10223434?v=4","gravatar_id":"","url":"https://api.github.com/users/mnastalski","html_url":"https://github.com/mnastalski","followers_url":"https://api.github.com/users/mnastalski/followers","following_url":"https://api.github.com/users/mnastalski/following{/other_user}","gists_url":"https://api.github.com/users/mnastalski/gists{/gist_id}","starred_url":"https://api.github.com/users/mnastalski/starred{/owner}{/