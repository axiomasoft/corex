","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["ast","instant-upgrades","laravel","php","rector","rules"],"visibility":"public","forks":115,"open_issues":34,"watchers":1286,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/560"},"html":{"href":"https://github.com/driftingly/rector-laravel/pull/560"},"issue":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/560"},"comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/issues/560/comments"},"review_comments":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/560/comments"},"review_comment":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/driftingly/rector-laravel/pulls/560/commits"},"statuses":{"href":"https://api.github.com/repos/driftingly/rector-laravel/statuses/7a6bf17e3506458faf531c883622dc4699581bb3"}},"author_association":"CONTRIBUTOR","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/552","id":4377912850,"node_id":"PR_kwDOFNE1eM8AAAABBPGmEg","html_url":"https://github.com/driftingly/rector-laravel/pull/552","diff_url":"https://github.com/driftingly/rector-laravel/pull/552.diff","patch_url":"https://github.com/driftingly/rector-laravel/pull/552.patch","issue_url":"https://api.github.com/repos/driftingly/rector-laravel/issues/552","number":552,"state":"open","locked":false,"title":"Fix Request static method transformation","user":{"login":"simonyang08","id":247288871,"node_id":"U_kgDODr1UJw","avatar_url":"https://avatars.githubusercontent.com/u/247288871?v=4","gravatar_id":"","url":"https://api.github.com/users/simonyang08","html_url":"https://github.com/simonyang08","followers_url":"https://api.github.com/users/simonyang08/followers","following_url":"https://api.github.com/users/simonyang08/following{/other_user}","gists_url":"https://api.github.com/users/simonyang08/gists{/gist_id}","starred_url":"https://api.github.com/users/simonyang08/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/simonyang08/subscriptions","organizations_url":"https://api.github.com/users/simonyang08/orgs","repos_url":"https://api.github.com/users/simonyang08/repos","events_url":"https://api.github.com/users/simonyang08/events{/privacy}","received_events_url":"https://api.github.com/users/simonyang08/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Fixes #496\n\n## Summary\n\n- restrict `RequestStaticValidateToInjectRector` to static `validate()` calls\n- leave other valid static APIs on `FormRequest` and Request-like classes unchanged\n- add a regression fixture for `FormRequest::failOnUnknownFields()`\n\n## Root cause\n\nThe rule matched every static call on Request-like types. That transformed valid APIs such as `FormRequest::failOnUnknownFields()` into an invalid instance call on `Illuminate\\Http\\Request`, even though the rule's documented purpose is only to rewrite static validation.\n\n## Validation\n\n- focused rector rule suite - 8 passed, 9 assertions\n- targeted PHPStan analysis - passed\n- targeted Duster lint on both changed files - passed\n- `git diff --check` - passed\n\n## AI disclosure\n\nThis change was prepared with OpenAI Codex assistance and reviewed and validated locally by the contributor.\n","created_at":"2026-08-27T16:56:37Z","updated_at":"2026-09-30T16:10:36Z","closed_at":null,"merged_at":null,"merge_commit_sha":"ae4e42e931410650de7fd6c9d464a25f1a2492bf","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/driftingly/rector-laravel/pulls/552/commits","review_