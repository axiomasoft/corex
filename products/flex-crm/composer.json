{
    "name": "flex/crm",
    "description": "CoreX CRM module — pipelines, stages and deals on axiomasoft/corex (ULID, tenancy, money).",
    "type": "packman-module",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crm",
        "pipeline",
        "deals",
        "multi-tenancy"
    ],
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "axiomasoft/corex": "^2.0@dev",
        "axiomasoft/corex-intl": "^2.0@dev",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-modules": "^0.1.2",
        "axiomasoft/packman-schema": "^0.1",
        "brick/money": "^0.9 || ^0.10",
        "ext-filter": "*",
        "ext-mbstring": "*",
        "giggsey/libphonenumber-for-php-lite": "^9.0",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "axiomasoft/corex-operations": "^2.0@dev",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.5",
        "pestphp/pest": "^5.2"
    },
    "suggest": {
        "axiomasoft/corex-operations": "Serves the CRM API operations declared by CrmModule; handlers depend only on the kernel CoreX\\Invocation contract."
    },
    "autoload": {
        "psr-4": {
            "Flex\\Crm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flex\\Crm\\Tests\\": "tests/"
        }
    },
    "extra": {
        "corex": {
            "schema-version": 1,
            "package-type": "product",
            "stability": "experimental"
        },
        "laravel": {
            "providers": [
                "Flex\\Crm\\CrmServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "packman": {
            "module": "Flex\\Crm\\CrmModule",
            "schema-version": 1,
            "package-type": "product",
            "stability": "experimental",
            "profile": "product",
            "error-prefix": "crm",
            "owns": [
                "Activity",
                "ApiShared",
                "Company",
                "Contact",
                "Context",
                "Deal",
                "Internal",
                "Lead",
                "Support"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core",
            "options": {
                "versions": {
                    "axiomasoft/corex": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../../packages/intl",
            "options": {
                "versions": {
                    "axiomasoft/corex-intl": "2.0.x-dev"
                },
                "reference": "config"
            }
        },
        {
            "type": "path",
            "url": "../../packages/operations",
            "options": {
                "versions": {
                    "axiomasoft/corex-operations": "2.0.x-dev"
                },
                "reference": "config"
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest --exclude-group=pg",
        "test:pg": "pest --group=pg",
        "test:coverage": "pest --coverage --min=95",
        "analyse": "cd ../.. && vendor/bin/phpstan analyse -c products/flex-crm/phpstan.neon --memory-limit=2G --no-progress",
        "lint": "pint",
        "lint:check": "pint --test"
    }
}
