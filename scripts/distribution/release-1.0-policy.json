{
  "schema_version": "corex-release-policy/1",
  "include": [
    "composer.json",
    "src/",
    "config/",
    "database/migrations/",
    "resources/",
    "README.md",
    "PACKAGE.md",
    "CHANGELOG.md",
    "UPGRADE.md",
    "LICENSE",
    "extension.neon",
    "routes/",
    "database/seeders/"
  ],
  "forbidden_segments": [
    "vendor",
    "node_modules",
    "tests",
    ".env",
    "auth.json",
    ".git",
    ".plan-cache"
  ],
  "required_if_present": [
    "config/",
    "database/migrations/",
    "resources/",
    "README.md",
    "PACKAGE.md",
    "CHANGELOG.md",
    "UPGRADE.md",
    "extension.neon",
    "routes/",
    "database/seeders/"
  ],
  "channels": {
    "packages/access": {
      "distribution": "private",
      "mirror": "axiomasoft/corex-access"
    },
    "packages/custom-fields": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-attributes"
    },
    "packages/core": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-core"
    },
    "packages/intl": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-intl"
    },
    "packages/media": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-media"
    },
    "packages/notifications": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-notifications"
    },
    "packages/operations": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-operations"
    },
    "packages/panels": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-panels"
    },
    "packages/recurrence": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-recurrence"
    },
    "packages/search": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-search"
    },
    "packages/search-intl": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-search-intl"
    },
    "packages/search-meilisearch": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-search-meilisearch"
    },
    "packages/tasks": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-tasks"
    },
    "packages/recurring-tasks": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-recurring-tasks"
    },
    "packages/tenancy": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-tenancy"
    },
    "packages/import-export": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-import-export"
    },
    "packages/scheduler": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-scheduler"
    },
    "packages/workflow": {
      "distribution": "public",
      "mirror": "axiomasoft/corex-workflow"
    },
    "packages/tools": {
      "distribution": "private",
      "mirror": "axiomasoft/corex-tools"
    },
    "packages/webhooks": {
      "distribution": "private",
      "mirror": "axiomasoft/corex-webhooks"
    }
  },
  "excluded": [
    {
      "path": "products/flex-crm",
      "reason": "flex-product-consumer"
    }
  ]
}
