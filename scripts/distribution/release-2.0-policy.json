{
  "schema_version": "corex-release-policy/2",
  "version": "2.0.0",
  "source_constraint": "^2.0@dev",
  "released_constraint": "^2.0",
  "include": [
    "composer.json",
    "src/",
    "config/",
    "database/migrations/",
    "resources/",
    "README.md",
    "PACKAGE.md",
    "CHANGELOG.md",
    "UPGRADE.md",
    "LICENSE",
    "extension.neon",
    "routes/",
    "database/seeders/"
  ],
  "forbidden_segments": [
    "vendor",
    "node_modules",
    "tests",
    ".env",
    "auth.json",
    ".git",
    ".plan-cache"
  ],
  "required_if_present": [
    "config/",
    "database/migrations/",
    "resources/",
    "README.md",
    "PACKAGE.md",
    "CHANGELOG.md",
    "UPGRADE.md",
    "extension.neon",
    "routes/",
    "database/seeders/"
  ],
  "channels": {
