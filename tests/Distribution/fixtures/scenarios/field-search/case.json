        "meilisearch": "1.16.0",
        "search_custom_fields": "enabled",
        "extension_fixture": {
          "id": "equipment-registry",
          "version": "1.0.0",
          "kind": "equipment"
        },
        "packages": [
          "axiomasoft/corex",
          "axiomasoft/corex-custom-fields",
