{
  "id": "field-search",
  "laravel": 13,
  "host_support": true,
  "retain_install_evidence": true,
  "timeout_seconds": 220,
  "distinct_connections": true,
  "variants": {
    "absent": {
      "profile": {
        "id": "equipment-field-search-absent",
        "database": "postgres-isolated",
        "database_roles": [
          "control",
          "a"
        ],
        "default_database": "a",
        "http": true,
        "meilisearch": "1.16.0",
        "search_custom_fields": "absent",
        "extension_fixture": {
          "id": "equipment-registry",
          "version": "1.0.0",
          "kind": "equipment"
        },
        "packages": [
          "axiomasoft/corex",
          "axiomasoft/corex-custom-fields",
          "axiomasoft/corex-search",
          "axiomasoft/corex-search-meilisearch",
          "axiomasoft/corex-intl",
          "axiomasoft/corex-search-intl"
        ],
        "forbid": [
          {
            "package": "axiomasoft/corex-search-custom-fields",
            "name": "Search Custom Fields"
          }
        ]
      },
      "processes": {
        "independent": [
          "php",
          "{fixture}/probe.php",
          "independent"
        ]
      },
      "actions": [
        {
          "action": "start",
          "name": "independent"
        },
        {
          "action": "complete",
          "name": "independent"
        }
      ]
    },
    "disabled": {
      "profile": {
        "id": "equipment-field-search-disabled",
