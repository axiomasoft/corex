{
  "id": "field-write",
  "laravel": 13,
  "host_support": true,
  "timeout_seconds": 190,
  "distinct_connections": true,
  "profile": {
    "id": "boxed-field-write",
    "database": "postgres-isolated",
    "database_roles": ["control", "a"],
    "default_database": "a",
    "http": true,
    "packages": ["axiomasoft/corex", "axiomasoft/corex-custom-fields"],
    "extension_fixture": {"id": "custom-attribute-source", "version": "1.0.0"},
    "forbid": [{"package": "axiomasoft/corex-tenancy", "name": "Tenancy"}, {"package": "axiomasoft/corex-search", "name": "Search"}]
  },
  "processes": {
    "producer": ["php", "{fixture}/probe.php", "produce"],
    "writer-a": ["php", "{fixture}/probe.php", "writer-a"],
    "writer-b": ["php", "{fixture}/probe.php", "writer-b"],
    "token-observer": ["php", "{fixture}/probe.php", "token-observer"],
    "verify-write": ["php", "{fixture}/probe.php", "verify-write"],
    "evolution": ["php", "{fixture}/probe.php", "evolution"],
    "backfill": ["php", "{fixture}/probe.php", "backfill"],
    "dual-write": ["php", "{fixture}/probe.php", "dual-write"],
    "repair": ["php", "{fixture}/probe.php", "repair"],
    "old-reader": ["php", "{fixture}/probe.php", "old-reader"],
    "switcher": ["php", "{fixture}/probe.php", "switcher"],
    "switch-observer": ["php", "{fixture}/probe.php", "switch-observer"],
    "verify-switch": ["php", "{fixture}/probe.php", "verify-switch"]
  },
  "actions": [
    {"action": "start", "name": "producer"},
    {"action": "await", "name": "fields-ready", "process": "producer"},
    {"action": "release", "name": "fields-ready"},
    {"action": "complete", "name": "producer"},
    {"action": "start", "name": "writer-a"},
    {"action": "await", "name": "token-uncommitted", "process": "writer-a"},
    {"action": "start", "name": "writer-b"},
    {"action": "await", "name": "token-b-ready", "process": "writer-b"},
    {"action": "release", "name": "token-b-ready"},
    {"action": "start", "name": "token-observer"},
    {"action": "complete", "name": "token-observer"},
    {"action": "release", "name": "token-uncommitted"},
    {"action": "complete", "name": "writer-a"},
    {"action": "await", "name": "token-replayed", "process": "writer-b"},
    {"action": "release", "name": "token-replayed"},
    {"action": "complete", "name": "writer-b"},
    {"action": "start", "name": "verify-write"},
    {"action": "complete", "name": "verify-write"},
    {"action": "start", "name": "evolution"},
    {"action": "await", "name": "field-expanded", "process": "evolution"},
    {"action": "release", "name": "field-expanded"},
    {"action": "complete", "name": "evolution"},
    {"action": "start", "name": "backfill", "environment": {"COREX_SCENARIO_PAUSE_BACKFILL": "1"}},
    {"action": "await", "name": "backfill-read", "process": "backfill"},
    {"action": "start", "name": "dual-write"},
    {"action": "await", "name": "dual-write-committed", "process": "dual-write"},
    {"action": "release", "name": "dual-write-committed"},
    {"action": "complete", "name": "dual-write"},
    {"action": "release", "name": "backfill-read"},
    {"action": "complete", "name": "backfill"},
    {"action": "start", "name": "repair"},
    {"action": "await", "name": "field-repaired", "process": "repair"},
    {"action": "release", "name": "field-repaired"},
    {"action": "complete", "name": "repair"},
    {"action": "start", "name": "old-reader"},
    {"action": "await", "name": "old-fields-read", "process": "old-reader"},
    {"action": "start", "name": "switcher"},
    {"action": "await", "name": "schema-switch-ready", "process": "switcher"},
    {"action": "release", "name": "schema-switch-ready"},
    {"action": "start", "name": "switch-observer"},
    {"action": "complete", "name": "switch-observer"},
    {"action": "release", "name": "old-fields-read"},
    {"action": "complete", "name": "old-reader"},
    {"action": "complete", "name": "switcher"},
    {"action": "start", "name": "verify-switch"},
    {"action": "complete", "name": "verify-switch"}
  ]
}
