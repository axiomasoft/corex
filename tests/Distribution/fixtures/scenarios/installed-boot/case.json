{
  "id": "installed-boot",
  "laravel": 13,
  "profile": {
    "id": "bare-single",
    "database": "sqlite-single",
    "http": true,
    "packages": ["axiomasoft/corex"],
    "forbid": [{"package": "axiomasoft/corex-tenancy", "name": "Tenancy"}]
  },
  "processes": {
    "boot": ["php", "{fixture}/probe.php"]
  },
  "actions": [
    {"action": "start", "name": "boot"},
    {"action": "await", "name": "booted"},
    {"action": "release", "name": "booted"},
    {"action": "complete", "name": "boot"}
  ]
}
