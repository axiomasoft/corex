{
  "id": "provider-unknown",
  "laravel": 13,
  "host_support": true,
  "timeout_seconds": 140,
  "distinct_connections": true,
  "auxiliary_processes": ["provider"],
  "profile": {
    "id": "boxed-provider-unknown",
    "database": "postgres-isolated",
    "database_roles": ["control", "a", "b"],
    "default_database": "a",
    "http": true,
    "packages": ["axiomasoft/corex", "axiomasoft/corex-notifications", "axiomasoft/corex-webhooks", "axiomasoft/corex-workflow"],
    "forbid": [{"package": "axiomasoft/corex-tenancy", "name": "Tenancy"}]
  },
  "processes": {
    "provider": ["python3", "{fixture}/../support/provider/simulator.py"],
    "producer": ["php", "{fixture}/probe.php", "produce"],
    "notification-send": ["php", "{fixture}/probe.php", "notification-send"],
    "notification-sending": ["php", "{fixture}/probe.php", "notification-sending"],
    "notification-expired": ["php", "{fixture}/probe.php", "notification-expired"],
    "notification-hidden-lookup": ["php", "{fixture}/probe.php", "notification-hidden-lookup"],
    "notification-confirmed": ["php", "{fixture}/probe.php", "notification-confirmed"],
    "workflow-send": ["php", "{fixture}/probe.php", "workflow-send"],
    "workflow-expired": ["php", "{fixture}/probe.php", "workflow-expired"],
    "workflow-stale": ["php", "{fixture}/probe.php", "workflow-stale"],
    "workflow-confirmed": ["php", "{fixture}/probe.php", "workflow-confirmed"],
    "webhook-send": ["php", "{fixture}/probe.php", "webhook-send"],
    "webhook-unknown": ["php", "{fixture}/probe.php", "webhook-unknown"],
    "webhook-operator": ["php", "{fixture}/probe.php", "webhook-operator"]
  },
  "actions": [
    {"action": "start", "name": "provider"},
    {"action": "await", "name": "provider-ready", "process": "provider"},
    {"action": "start", "name": "producer"},
    {"action": "await", "name": "provider-intents", "process": "producer"},
    {"action": "release", "name": "provider-intents"},
    {"action": "complete", "name": "producer"},
    {"action": "start", "name": "notification-send", "environment": {
      "COREX_SCENARIO_PROVIDER_RESPONSE": "drop", "COREX_SCENARIO_PROVIDER_LOOKUP_DELAY": "30",
      "COREX_SCENARIO_PROVIDER_BARRIER": "provider-notification-committed", "COREX_SCENARIO_PROVIDER_WORKER_BARRIER": "notification-ack-lost"
    }},
    {"action": "await", "name": "provider-notification-committed", "process": "provider"},
    {"action": "await", "name": "notification-ack-lost", "process": "notification-send"},
    {"action": "start", "name": "notification-sending"},
    {"action": "await", "name": "notification-sending", "process": "notification-sending"},
    {"action": "terminate", "name": "notification-send", "barrier": "notification-ack-lost"},
    {"action": "release", "name": "notification-sending"},
    {"action": "complete", "name": "notification-sending"},
    {"action": "start", "name": "notification-expired"},
    {"action": "complete", "name": "notification-expired"},
    {"action": "start", "name": "notification-hidden-lookup"},
    {"action": "complete", "name": "notification-hidden-lookup"},
    {"action": "start", "name": "notification-confirmed"},
    {"action": "complete", "name": "notification-confirmed"},
    {"action": "start", "name": "workflow-send", "environment": {
      "COREX_SCENARIO_PROVIDER_RESPONSE": "hold", "COREX_SCENARIO_PROVIDER_LOOKUP_DELAY": "120",
      "COREX_SCENARIO_PROVIDER_BARRIER": "provider-workflow-committed"
    }},
    {"action": "await", "name": "provider-workflow-committed", "process": "provider"},
    {"action": "start", "name": "workflow-expired"},
    {"action": "await", "name": "workflow-unknown", "process": "workflow-expired"},
    {"action": "release", "name": "provider-workflow-committed"},
    {"action": "complete", "name": "workflow-send"},
    {"action": "start", "name": "workflow-stale"},
    {"action": "complete", "name": "workflow-stale"},
    {"action": "release", "name": "workflow-unknown"},
    {"action": "complete", "name": "workflow-expired"},
    {"action": "start", "name": "workflow-confirmed"},
    {"action": "complete", "name": "workflow-confirmed"},
    {"action": "start", "name": "webhook-send", "environment": {
      "COREX_SCENARIO_PROVIDER_RESPONSE": "drop", "COREX_SCENARIO_PROVIDER_IDEMPOTENT": "0", "COREX_SCENARIO_PROVIDER_LOOKUP": "0",
      "COREX_SCENARIO_PROVIDER_BARRIER": "provider-webhook-committed"
    }},
    {"action": "await", "name": "provider-webhook-committed", "process": "provider"},
    {"action": "complete", "name": "webhook-send"},
    {"action": "start", "name": "webhook-unknown", "environment": {"COREX_SCENARIO_PROVIDER_IDEMPOTENT": "0", "COREX_SCENARIO_PROVIDER_LOOKUP": "0"}},
    {"action": "complete", "name": "webhook-unknown"},
    {"action": "start", "name": "webhook-operator", "environment": {"COREX_SCENARIO_PROVIDER_IDEMPOTENT": "0", "COREX_SCENARIO_PROVIDER_LOOKUP": "0"}},
    {"action": "complete", "name": "webhook-operator"},
    {"action": "release", "name": "provider-ready"},
    {"action": "complete", "name": "provider"}
  ]
}
